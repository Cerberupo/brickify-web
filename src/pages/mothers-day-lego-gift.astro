---
import MarketingPage from "@/components/marketing/MarketingPage.astro";
import type {SupportedLocale} from "@/lib/locale";

const locale: SupportedLocale = 'en';
const seo = {
    title: "Mother's Day LEGO®-style Gift from a Photo | Brickify",
    description: "Turn a photo of your mum into a personalized LEGO®-style Mother's Day gift. Get the closest official parts list in minutes for a keepsake that feels genuinely personal.",
    canonical: "/mothers-day-lego-gift",
    alternates: [
        {href: "/mothers-day-lego-gift", hrefLang: "x-default"},
        {href: "/mothers-day-lego-gift", hrefLang: "en"},
        {href: "/es/regalo-lego-dia-de-la-madre", hrefLang: "es"},
    ],
    structuredData: {
        webpage: true,
        breadcrumb: [
            {name: "Home", url: "/en"},
            {name: "Mother's Day Gift", url: "/mothers-day-lego-gift"},
        ]
    }
};

const hero = {
    eyebrow: "A Mother's Day gift that feels personal",
    title: "Create a LEGO®-style Mother's Day gift from any photo",
    description: "Upload a clear photo and Brickify will match the closest official pieces for a lookalike figure. Ideal for mums, grandmothers, and family keepsakes that last longer than flowers.",
    ctas: [
        {label: "Sign in to process", href: "/login"},
        {label: "See pricing", href: "/#precio", variant: "secondary"},
    ],
};

const highlights = [
    {title: "Based on a real photo", description: "We match hair, face, outfit colors, and signature details so the result feels recognisable."},
    {title: "Designed for gifting", description: "A playful alternative to generic Mother's Day gifts, especially for LEGO-loving families."},
    {title: "Fast enough for late planners", description: "Most part lists are ready in under a minute, which helps when Mother's Day is suddenly close."},
    {title: "Official-part shopping list", description: "Get reference codes so it's easier to source the final build."},
];

const steps = [
    {title: "Upload a favourite photo", description: "Choose a clear front-facing image with good lighting and the hairstyle or outfit details you want to preserve."},
    {title: "We match the closest official parts", description: "Brickify selects hair, head, torso, and legs to match the photo as closely as possible."},
    {title: "Receive the parts list", description: "You get reference codes that are ready to shop on official or compatible marketplaces."},
    {title: "Build and gift it", description: "Assemble the figure and turn it into a Mother's Day surprise, keepsake, or desk display."},
];

const sections = [
    {
        heading: "Why it works for Mother's Day",
        body: "Mother's Day gifts often repeat the same patterns. A lookalike figure feels more thoughtful because it starts from a real memory and turns it into something display-worthy.",
        bullets: [
            {title: "Sentimental", description: "It captures a familiar face, hairstyle, or outfit from a real photo."},
            {title: "Keepsake-friendly", description: "It works well as a shelf piece, memory-box item, or companion to a card."},
            {title: "Family-friendly", description: "Great for mums, grandmothers, or anyone celebrating Mother's Day in the family."},
        ],
    },
    {
        heading: "Best Mother's Day use cases",
        body: "This page targets Mother's Day gift intent, but it also matches related search journeys around personalised gifts for mums and family keepsakes.",
        bullets: [
            {title: "Children and partners", description: "A warmer alternative to standard gift-shop items or last-minute flowers."},
            {title: "Grandmothers", description: "A custom figure that feels personal without needing commissioned artwork."},
            {title: "Family moments", description: "Use a favourite portrait, celebration photo, or everyday snapshot that feels like her."},
        ],
    },
    {
        heading: "Independent service, official parts approach",
        body: "Brickify is an independent service that helps you find the closest official parts for a lookalike build. LEGO® is a trademark of the LEGO Group, which does not sponsor or endorse this service.",
        bullets: [
            {title: "No catalog digging", description: "Skip the manual search across hundreds of heads, torsos, and hairstyles."},
            {title: "Easy to prepare", description: "A clear parts list makes the Mother's Day gift easier to prepare."},
            {title: "Photo-first workflow", description: "Start from the person you love, not from random pieces."},
        ],
    },
    {
        heading: "If your main intent is just from photo",
        body: "Some people land here from seasonal searches, but the stronger evergreen query is still photo to LEGO-style minifigure. That page should keep supporting this one.",
        bullets: [
            {title: "LEGO figure from photo", description: "Link the evergreen parent route when the real intent starts with the transformation flow.", href: "/custom-lego-minifigure-photo", linkLabel: "See the from-photo page"},
            {title: "Personalized gift from photo", description: "Support this page with the broader gift route so visitors can move into the main gifting page.", href: "/personalized-lego-gift", linkLabel: "View personalized gift page"},
            {title: "Seasonal support", description: "Keep Mother's Day tied to the wider from-photo cluster instead of leaving it isolated.", href: "/lego-anniversary-gift", linkLabel: "See a related occasion page"},
        ],
    },
];
---

<MarketingPage
        locale={locale}
        seo={seo}
        hero={hero}
        highlights={highlights}
        steps={steps}
        sections={sections}
        showPriceCalculator={true}
/>
