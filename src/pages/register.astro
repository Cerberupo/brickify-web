---
import MainLayout from "../layouts/main.astro";
import {PROJECT_NAME} from "../config";
import RegisterShell from "../components/pages/register/RegisterShell";
import FooterSection from "@/components/home/FooterSection.astro";
import { normalizeLocale, type SupportedLocale } from "@/lib/locale";

const locale: SupportedLocale = normalizeLocale(Astro.currentLocale as string | undefined);
---
<MainLayout content={{title: `${PROJECT_NAME} - Register`}}>
    <RegisterShell client:only="react" />
    <FooterSection locale={locale} />
</MainLayout>