---
import MarketingPage from "@/components/marketing/MarketingPage.astro";
import type {SupportedLocale} from "@/lib/locale";

const locale: SupportedLocale = 'en';
const seo = {
    title: "LEGO Figure From Photo | Personalized LEGO-Style Figure | Brickify",
    description: "Turn a photo into a personalized LEGO-style figure with an official parts list, buying links, and stock-safe alternatives for each key piece.",
    canonical: "/custom-lego-minifigure-photo",
    alternates: [
        {href: "/custom-lego-minifigure-photo", hrefLang: "x-default"},
        {href: "/custom-lego-minifigure-photo", hrefLang: "en"},
        {href: "/es/minifig-lego-personalizada-foto", hrefLang: "es"},
    ],
    structuredData: {
        webpage: true,
        breadcrumb: [
            {name: "Home", url: "/en"},
            {name: "Custom Minifigure", url: "/custom-lego-minifigure-photo"},
        ]
    }
};

const hero = {
    eyebrow: "From photo to exact parts list",
    title: "Turn any photo into a LEGO®-style figure that actually looks like you",
    description: "Upload your picture, we match the closest official pieces for hair, head, torso and legs, and send a ready-to-shop list with alternates in case stock changes.",
    ctas: [
        {label: "Sign in to process", href: "/login"},
        {label: "See price per image", href: "/#precio", variant: "secondary"},
    ],
};

const highlights = [
    {
        title: "Closest official pieces",
        description: "Hair, head, torso and legs selected to resemble your photo, with SKUs and buy links.",
    },
    {
        title: "Matching done for you",
        description: "Just upload and approve. No catalog hours or doubts about colors or faces.",
    },
    {
        title: "Stock-safe lists",
        description: "Each key piece includes 1–2 alternates so you never get stuck by availability.",
    },
    {
        title: "Best price in volume",
        description: "For friends, weddings or teams, the price per image drops as you add more photos.",
    },
];

const steps = [
    {
        title: "Upload a clear photo",
        description: "Front-facing works best with good lighting."
    },
    {
        title: "We match official pieces",
        description: "Closest hair, head, torso and legs picked for you, plus backups for stock shifts."
    },
    {
        title: "Receive your list",
        description: "Receive SKUs and buy links so you can purchase on the LEGO store."
    },
    {title: "Buy and build", description: "Buy and assemble a lookalike minifig in minutes."},
];

const sections = [
    {
        heading: "Brickify does the heavy lifting for you",
        body: "Catalogs are massive and colors vary. We track availability, choose the closest parts, and give you a ready-to-buy list so you don’t waste hours.",
        bullets: [
            {title: "Ready fast", description: "Usually in less than a minute per person (24/7 service)."},
            {title: "Stock under control", description: "Alternates per piece so availability never stops you."},
            {
                title: "Independent service",
                description: "Not affiliated with LEGO®; we use official bricks responsibly."
            },
        ],
    },
    {
        heading: "Ready for gifts, weddings and teams",
        body: "Lookalike figures make weddings, corporate swag and personal gifts feel unique. Upload several photos and lower the unit price.",
        bullets: [
            {title: "Weddings", description: "Lookalike favors for your wedding party or guests."},
            {title: "Corporate", description: "Memorable swag for employees, clients or event attendees."},
            {title: "Personal gifts", description: "Birthdays, anniversaries, graduations or just because."},
        ],
    },
    {
        heading: "Useful next steps if you're comparing gift ideas",
        body: "If you are planning a birthday surprise, wedding favor, or personalized present, these pages can help you choose the right angle before you upload photos.",
        bullets: [
            {title: "Birthday gifts", description: "See ideas on /lego-birthday-gift for one-person presents and quick wins."},
            {title: "Personalized gifts", description: "Compare broader gift use cases on /personalized-lego-gift."},
            {title: "Couples and anniversaries", description: "Use /custom-lego-gifts-for-couples for romantic or shared-photo ideas."},
        ],
    },
];
---

<MarketingPage
        locale={locale}
        seo={seo}
        hero={hero}
        highlights={highlights}
        steps={steps}
        sections={sections}
        showPriceCalculator={true}
/> 