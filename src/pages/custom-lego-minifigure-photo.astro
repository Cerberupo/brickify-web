---
import MarketingPage from "@/components/marketing/MarketingPage.astro";
import type {SupportedLocale} from "@/lib/locale";

const locale: SupportedLocale = 'en';
const seo = {
    title: "LEGO Minifigure From Photo | One Person Per Photo | Brickify",
    description: "Create a LEGO minifigure from a single-person photo with an official parts list and buying links for each key piece.",
    canonical: "/custom-lego-minifigure-photo",
    alternates: [
        {href: "/custom-lego-minifigure-photo", hrefLang: "x-default"},
        {href: "/custom-lego-minifigure-photo", hrefLang: "en"},
        {href: "/es/minifig-lego-personalizada-foto", hrefLang: "es"},
    ],
    structuredData: {
        webpage: true,
        breadcrumb: [
            {name: "Home", url: "/en"},
            {name: "Custom Minifigure", url: "/custom-lego-minifigure-photo"},
        ]
    }
};

const hero = {
    eyebrow: "From photo to exact parts list",
    title: "Turn any photo into a LEGO®-style minifigure that actually looks like you",
    description: "Upload a photo of one person, we match the closest official pieces for hair, head, torso and legs, and send a ready-to-shop list.",
    ctas: [
        {label: "Sign in to process", href: "/login"},
        {label: "See price per image", href: "/#precio", variant: "secondary"},
    ],
};

const highlights = [
    {
        title: "Closest official pieces",
        description: "Hair, head, torso and legs selected to resemble your photo, with SKUs and buy links.",
    },
    {
        title: "Matching done for you",
        description: "Just upload and approve. No catalog hours or doubts about colors or faces.",
    },
    {
        title: "Clear part lists",
        description: "Each key piece is grouped clearly so you can shop and assemble more easily.",
    },
    {
        title: "Best price in volume",
        description: "For friends, weddings or teams, the price per image drops as you add more photos.",
    },
];

const steps = [
    {
        title: "Upload a clear individual photo",
        description: "Use one front-facing photo of one person only. Good lighting works best."
    },
    {
        title: "We match official pieces",
        description: "Closest hair, head, torso and legs picked for you."
    },
    {
        title: "Receive your list",
        description: "Receive SKUs and buy links so you can purchase on the LEGO store."
    },
    {title: "Buy and build", description: "Buy and assemble a lookalike minifig in minutes."},
];

const sections = [
    {
        heading: "Brickify does the heavy lifting for you",
        body: "Catalogs are massive and colors vary. We track availability, choose the closest parts, and give you a ready-to-buy list so you don’t waste hours.",
        bullets: [
            {title: "One person per photo", description: "This flow works best with one individual photo. If you want several people, upload one separate photo for each person."},
            {title: "Ready fast", description: "Usually in less than a minute per person (24/7 service)."},
            {title: "Simple to follow", description: "A clear per-piece breakdown keeps the build easy to follow."},
            {
                title: "Independent service",
                description: "Not affiliated with LEGO®; we use official bricks responsibly."
            },
        ],
    },
    {
        heading: "Ready for gifts, weddings and teams",
        body: "Lookalike figures make weddings, corporate swag and personal gifts feel unique. Upload several photos and lower the unit price.",
        bullets: [
            {title: "Weddings", description: "Lookalike favors for your wedding party or guests.", href: "/lego-wedding-favors", linkLabel: "See wedding favor page"},
            {title: "Corporate", description: "Memorable swag for employees, clients or event attendees.", href: "/corporate-lego-gifts", linkLabel: "Explore corporate gift ideas"},
            {title: "Personal gifts", description: "Birthdays, anniversaries, graduations or just because.", href: "/personalized-lego-gift", linkLabel: "View personalized gift page"},
        ],
    },
    {
        heading: "Helpful guides before you upload",
        body: "These supporting guides answer the common questions around photo quality, gifting angles, and what to expect from the parts-matching flow.",
        bullets: [
            {title: "Photo-to-minifigure guide", description: "See the full step-by-step workflow before you submit your image.", href: "/blog/how-to-turn-a-photo-into-a-lego-minifigure", linkLabel: "Read the from-photo guide"},
            {title: "Gift ideas", description: "Browse birthday, anniversary, graduation, and other occasion ideas that start from a single photo.", href: "/blog/5-gift-ideas-with-custom-lego-minifigures", linkLabel: "See gift ideas"},
            {title: "Couples and anniversary ideas", description: "Use the same from-photo workflow for partners, wedding memories, and relationship gifts.", href: "/custom-lego-gifts-for-couples", linkLabel: "Explore couples gift ideas"},
        ],
    },
];
---

<MarketingPage
        locale={locale}
        seo={seo}
        hero={hero}
        highlights={highlights}
        steps={steps}
        sections={sections}
        showPriceCalculator={true}
/> 
