---
import MarketingPage from "@/components/marketing/MarketingPage.astro";
import type {SupportedLocale} from "@/lib/locale";

const locale: SupportedLocale = 'en';
const seo = {
    title: "Custom LEGO minifigure from your photo | Brickify",
    description: "Upload a photo, we match the closest official LEGO® parts, and you buy only what you need. Fast, accurate and ready to shop in minutes.",
    canonical: "/custom-lego-minifigure-photo",
    alternates: [
        {href: "/en/custom-lego-minifigure-photo", hrefLang: "en"},
        {href: "/es/minifig-lego-personalizada-foto", hrefLang: "es"},
    ],
};

const hero = {
    eyebrow: "From photo to exact parts list",
    title: "Turn any photo into a LEGO®-style minifig that actually looks like you",
    description: "Drop your picture, we pick the closest official bricks (hair, head, torso, legs) and send you a ready-to-shop list with alternates in case stock changes.",
    ctas: [
        {label: "Sign in to process", href: "/login"},
        {label: "See price per image", href: "#precio", variant: "secondary"},
    ],
};

const highlights = [
    {
        title: "Closest official pieces",
        description: "Hair, head, torso and legs selected to resemble your photo, with SKUs and buy links.",
    },
    {
        title: "Done for you matching",
        description: "We handle the hard part—just upload and approve. No endless catalog scrolling.",
    },
    {
        title: "Stock-safe lists",
        description: "Each key piece includes 1–2 alternates so you never get stuck by availability.",
    },
    {
        title: "Better price in volume",
        description: "Ordering for friends, weddings or teams? Price per image drops as you add photos.",
    },
];

const steps = [
    {
        title: "Upload a clear photo",
        description: "Front-facing works best with good lighting."
    },
    {
        title: "We match official pieces",
        description: "Closest hair, head, torso and legs picked for you, plus backups for stock shifts."
    },
    {
        title: "Approve your list",
        description: "Receive SKUs and buy links so you can purchase only what you need in EUR pricing."
    },
    {
        title: "Buy and build",
        description: "Order on your favorite store and assemble a lookalike minifig in minutes."
    },
];

const sections = [
    {
        heading: "Why Brickify does the heavy lifting for you",
        body: "Catalogs are massive and colors vary. We keep up with availability, choose the closest parts, and give you a ready-to-buy list so you don’t waste hours browsing.",
        bullets: [
            {title: "Ready fast", description: "Most lists are ready in under an hour during business hours."},
            {title: "Availability-aware", description: "Alternates per piece so your order never blocks on stock."},
            {
                title: "Transparent pricing",
                description: "See EUR price per image before you confirm; volume saves more."
            },
            {
                title: "Independent service",
                description: "Not affiliated with LEGO®; we use official bricks responsibly."
            },
        ],
    },
    {
        heading: "Built for gifts, weddings and teams",
        body: "Lookalike minifigs make weddings, corporate swag and personal gifts feel custom. Upload several photos and watch the per-image price drop.",
        bullets: [
            {title: "Weddings", description: "Lookalike favors for your wedding party or guests."},
            {title: "Corporate", description: "Memorable swag for employees, clients or event attendees."},
            {title: "Personal gifts", description: "Birthdays, anniversaries, graduations or just because."},
        ],
    },
];
---

<MarketingPage
        locale={locale}
        seo={seo}
        hero={hero}
        highlights={highlights}
        steps={steps}
        sections={sections}
        showPriceCalculator={true}
/> 