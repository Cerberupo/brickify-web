---
import MarketingPage from "@/components/marketing/MarketingPage.astro";
import type {SupportedLocale} from "@/lib/locale";

const locale: SupportedLocale = 'en';
const seo = {
    title: "LEGO®-style Anniversary Gift from a Photo | Brickify",
    description: "Turn a favorite couple photo into a personalized LEGO®-style anniversary gift. Get the closest official parts list in minutes for a keepsake that feels personal and display-worthy.",
    canonical: "/lego-anniversary-gift",
    alternates: [
        {href: "/lego-anniversary-gift", hrefLang: "x-default"},
        {href: "/lego-anniversary-gift", hrefLang: "en"},
        {href: "/es/regalo-aniversario-lego-personalizado", hrefLang: "es"},
    ],
    structuredData: {
        webpage: true,
        breadcrumb: [
            {name: "Home", url: "/en"},
            {name: "Anniversary Gift", url: "/lego-anniversary-gift"},
        ]
    }
};

const hero = {
    eyebrow: "An anniversary gift that starts from a real memory",
    title: "Create a LEGO®-style anniversary gift from a favorite photo",
    description: "Upload a couple photo and Brickify will match the closest official pieces for a lookalike keepsake. A strong fit for anniversaries, dating milestones and wedding-anniversary surprises that feel more personal than generic gifts.",
    ctas: [
        {label: "Sign in to process", href: "/login"},
        {label: "See pricing", href: "/#precio", variant: "secondary"},
    ],
};

const highlights = [
    {title: "Built from a real couple photo", description: "Use an engagement, wedding, travel or everyday photo that already means something to both of you."},
    {title: "More personal than generic anniversary gifts", description: "A lookalike figure feels thoughtful without needing a custom illustrator or a huge budget."},
    {title: "Official-part shopping list", description: "Get reference codes for the closest official parts plus alternates when stock changes."},
    {title: "Easy to display", description: "Works well as a shelf keepsake, desk piece or memory-box gift after the anniversary dinner."},
];

const steps = [
    {title: "Choose a clear photo", description: "Front-facing photos with recognisable hair and outfit details tend to produce the best lookalike result."},
    {title: "We match the closest official parts", description: "Brickify selects hair, head, torso and legs for each person, with backups when there are several good options."},
    {title: "Receive the parts list", description: "You get ready-to-shop references so you can buy only what you need instead of searching part catalogs by hand."},
    {title: "Build the anniversary keepsake", description: "Assemble the figures and turn one memory into a gift that stays on display after the celebration."},
];

const sections = [
    {
        heading: "Why anniversary gift intent is different",
        body: "Anniversary shoppers are usually looking for something specific enough to feel intimate, but still easy to order and assemble. A lookalike LEGO-style gift lands well because it starts from a real shared photo instead of a generic template.",
        bullets: [
            {title: "Meaningful", description: "It reflects a real trip, wedding day, date night or everyday memory."},
            {title: "Playful", description: "It feels lighter and more original than standard engraved gifts or novelty merch."},
            {title: "Keepsake-friendly", description: "The finished figures can stay on a desk, shelf or memory corner."},
        ],
    },
    {
        heading: "Best anniversary use cases",
        body: "This page is focused on anniversary searches, but it also matches nearby search journeys around couple gifts, wedding anniversaries and photo-based personalized keepsakes.",
        bullets: [
            {title: "Dating anniversaries", description: "Use a favorite recent photo to mark one year, five years or another milestone."},
            {title: "Wedding anniversaries", description: "A strong option when you want something more personal than flowers or a standard framed print."},
            {title: "Long-distance couples", description: "A compact keepsake that still feels tied to a real shared memory."},
            {title: "Nearby gifting moments", description: "If the real occasion is a retirement or farewell, Brickify has a dedicated page for coworker and milestone send-offs.", href: "/lego-retirement-gift", linkLabel: "See retirement gift page"},
        ],
    },
    {
        heading: "Independent service, official-parts workflow",
        body: "Brickify is an independent service that helps you find the closest official parts for a lookalike build. LEGO® is a trademark of the LEGO Group, which does not sponsor or endorse this service.",
        bullets: [
            {title: "No manual catalog digging", description: "Skip the slow search across heads, torsos, legs and hairstyles."},
            {title: "Stock-aware backups", description: "Alternatives reduce the chance of an anniversary gift being delayed by one unavailable part."},
            {title: "Photo-first process", description: "Start from the memory you want to celebrate, then build from there.", href: "/custom-lego-minifigure-photo", linkLabel: "See the from-photo workflow"},
        ],
    },
];
---

<MarketingPage
        locale={locale}
        seo={seo}
        hero={hero}
        highlights={highlights}
        steps={steps}
        sections={sections}
        showPriceCalculator={true}
/>
