---
import Layout from "@/layouts/main.astro";
import {Header} from "@/layouts/components/Header";
import FooterSection from "@/components/home/FooterSection.astro";
import Breadcrumbs from "@/components/common/Breadcrumbs.astro";
import type {SupportedLocale} from "@/lib/locale";

const locale: SupportedLocale = 'en';
const seo = {
    title: "Brickify Blog | Tips for personalized LEGO®-style gifts",
    description: "Guides and ideas to turn photos into LEGO®-style figures for weddings, corporate gifts and personal surprises.",
    canonical: "/blog",
    alternates: [
        {href: "/blog", hrefLang: "x-default"},
        {href: "/blog", hrefLang: "en"},
        {href: "/es/blog", hrefLang: "es"},
    ],
};

const posts = [
    {
        title: "LEGO birthday gift ideas that feel personal",
        desc: "A practical guide to turning a photo into a personalized LEGO-style birthday gift that people actually keep.",
        href: "/blog/lego-birthday-gift-ideas",
        date: "2026-04-22",
        readMin: 5,
    },
    {
        title: "Custom LEGO gifts for couples and anniversaries",
        desc: "How to use lookalike LEGO-style figures as a couple gift, anniversary surprise or meaningful keepsake.",
        href: "/blog/custom-lego-gifts-for-couples",
        date: "2026-04-22",
        readMin: 5,
    },
    {
        title: "How to turn a photo into a LEGO-style figure",
        desc: "Step-by-step to get the closest official parts list from a photo, with backups for stock.",
        href: "/blog/how-to-turn-a-photo-into-a-lego-minifigure",
        date: "2025-11-20",
        readMin: 6,
    },
    {
        title: "Best LEGO gifts for weddings",
        desc: "Ideas to wow guests and the wedding party with lookalike LEGO-style figures and clear pricing.",
        href: "/blog/best-lego-gifts-for-weddings",
        date: "2025-11-22",
        readMin: 5,
    },
    {
        title: "LEGO gifts for coworkers and teams",
        desc: "Corporate-friendly ways to use personalized LEGO-style figures for events, swag and onboarding.",
        href: "/blog/lego-gifts-for-coworkers",
        date: "2025-11-24",
        readMin: 5,
    },
    {
        title: "Personalized LEGO gift ideas",
        desc: "Occasions and tips to make a unique lookalike gift from any photo with EUR pricing.",
        href: "/blog/personalized-lego-gifts-ideas",
        date: "2025-11-26",
        readMin: 4,
    },
    {
        title: "5 Gift Ideas with Custom LEGO Minifigures",
        desc: "Discover unique and creative gift ideas using personalized LEGO-style figures from photos.",
        href: "/blog/5-gift-ideas-with-custom-lego-minifigures",
        date: "2026-01-20",
        readMin: 5,
    },
    {
        title: "The Ultimate Guide to Combining LEGO Pieces",
        desc: "Learn how to select and combine official LEGO parts to create a figure that matches your photo perfectly.",
        href: "/blog/ultimate-guide-to-combining-lego-pieces-from-photo",
        date: "2026-01-24",
        readMin: 7,
    },
];

// Helpers
const formatDate = (iso: string) => new Intl.DateTimeFormat('en-US', {
    year: 'numeric', month: 'long', day: 'numeric'
}).format(new Date(iso));
---

<Layout content={{title: seo.title}} lang={locale} seo={seo}>
    <Header alternates={seo.alternates} client:only="react"/>
    <main class="relative overflow-x-hidden">
        <section class="pt-16 md:pt-24 bg-gradient-to-b from-[#F7F3EE] to-white">
            <div class="container mx-auto px-4 md:px-6">
                <p class="text-sm uppercase tracking-[0.2em] text-primary mb-3">Blog</p>
                <h1 class="text-3xl md:text-[40px] font-semibold leading-tight mb-3">Guides and ideas to create
                    LEGO®-style lookalikes</h1>
                <p class="text-base md:text-lg text-neutral-700 max-w-3xl">Learn how to turn photos into lookalike
                    figures and find wedding, corporate and gift ideas. Not affiliated with LEGO®.</p>
                <div class="mt-6 flex flex-wrap gap-3 text-sm">
                    <a href="/custom-lego-minifigure-photo" class="inline-flex rounded-full border border-neutral-300 px-3 py-1.5 hover:bg-white">Photo to LEGO-style figure</a>
                    <a href="/personalized-lego-gift" class="inline-flex rounded-full border border-neutral-300 px-3 py-1.5 hover:bg-white">Personalized gift</a>
                    <a href="/lego-wedding-favors" class="inline-flex rounded-full border border-neutral-300 px-3 py-1.5 hover:bg-white">Wedding favors</a>
                    <a href="/corporate-lego-gifts" class="inline-flex rounded-full border border-neutral-300 px-3 py-1.5 hover:bg-white">Corporate gifts</a>
                    <a href="/lego-birthday-gift" class="inline-flex rounded-full border border-neutral-300 px-3 py-1.5 hover:bg-white">Birthday gifts</a>
                    <a href="/custom-lego-gifts-for-couples" class="inline-flex rounded-full border border-neutral-300 px-3 py-1.5 hover:bg-white">Couples & anniversaries</a>
                    <a href="/lego-graduation-gift" class="inline-flex rounded-full border border-neutral-300 px-3 py-1.5 hover:bg-white">Graduation gift</a>
                    <a href="/mothers-day-lego-gift" class="inline-flex rounded-full border border-neutral-300 px-3 py-1.5 hover:bg-white">Mother's Day gift</a>
                </div>
            </div>
        </section>

        <section class="py-12 md:py-16">
            <div class="container mx-auto px-4 md:px-6">
                <div class="divide-y divide-neutral-200">
                    {posts.map((post) => (
                            <article class="py-6 group">
                                <h2 class="text-[22px] md:text-2xl font-semibold mb-1 tracking-tight">
                                    <a href={post.href} class="hover:underline decoration-2 underline-offset-2">
                                        {post.title}
                                    </a>
                                </h2>
                                <p class="text-xs text-neutral-500 mb-3 flex items-center gap-3">
                                    <span class="inline-flex items-center gap-1">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                             stroke-linejoin="round" class="opacity-70">
                                            <path d="M8 2v4"/><path d="M16 2v4"/><rect x="3" y="4" width="18"
                                                                                       height="18" rx="2" ry="2"/><path
                                                d="M3 10h18"/>
                                        </svg>
                                        <time datetime={post.date}>{formatDate(post.date)}</time>
                                    </span>
                                    <span aria-hidden="true" class="opacity-40">•</span>
                                    <span class="inline-flex items-center gap-1">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                             stroke-linejoin="round" class="opacity-70">
                                            <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
                                        </svg>
                                        {post.readMin} min read
                                    </span>
                                </p>
                                <p class="text-[15px] text-neutral-700 mb-3 leading-relaxed">{post.desc}</p>
                                <a href={post.href}
                                   class="text-primary font-semibold text-sm inline-flex items-center gap-1">
                                    Read article
                                    <span aria-hidden="true"
                                          class="transition-transform group-hover:translate-x-0.5">→</span>
                                </a>
                            </article>
                    ))}
                </div>
            </div>
        </section>

        <section class="py-16 md:py-20 bg-[#181818] text-white">
            <div class="container mx-auto px-4 md:px-6 flex flex-col lg:flex-row items-center justify-between gap-6">
                <div>
                    <p class="text-sm uppercase tracking-[0.2em] text-primary/80 mb-2">Start now</p>
                    <h2 class="text-2xl md:text-3xl font-semibold leading-tight">Upload your photos and get the exact
                        parts list</h2>
                    <p class="text-sm md:text-base text-white/80 mt-2 max-w-2xl">Go to the home flow to upload an image
                        and receive the closest official parts with backups. Not affiliated with LEGO®.</p>
                </div>
                <div class="flex flex-wrap gap-3">
                    <a href="/en/login"
                       class="inline-flex items-center justify-center rounded-full bg-white text-black px-5 py-3 text-sm font-semibold shadow-sm hover:shadow-md transition">Sign
                        in to process</a>
                    <a href="/#precio"
                       class="inline-flex items-center justify-center rounded-full bg-white text-black px-5 py-3 text-sm font-semibold shadow-sm hover:shadow-md transition">See
                        pricing</a>
                </div>
            </div>
        </section>

        <FooterSection locale={locale} addMargin={false}/>
    </main>
</Layout>
