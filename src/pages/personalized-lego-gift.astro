---
import MarketingPage from "@/components/marketing/MarketingPage.astro";
import type {SupportedLocale} from "@/lib/locale";

const locale: SupportedLocale = 'en';
const seo = {
    title: "Personalized LEGO®-style Gift From a Photo | Brickify",
    description: "Turn a photo into a personalized LEGO®-style gift with an official parts list, buying links, and stock-safe alternatives for a custom lookalike minifigure.",
    canonical: "/personalized-lego-gift",
    alternates: [
        {href: "/personalized-lego-gift", hrefLang: "x-default"},
        {href: "/personalized-lego-gift", hrefLang: "en"},
        {href: "/es/regalo-lego-personalizado", hrefLang: "es"},
        {href: "/personalized-lego-gift", hrefLang: "en-US"},
        {href: "/es/regalo-lego-personalizado", hrefLang: "es-ES"},
    ],
    structuredData: {
        webpage: true,
        breadcrumb: [
            {name: "Home", url: "/en"},
            {name: "Personalized Gift", url: "/personalized-lego-gift"},
        ]
    }
};

const hero = {
    eyebrow: "Gift a lookalike minifig",
    title: "Personalized LEGO®-style gift from any photo",
    description: "Upload one person's photo and we'll send you the exact list of official pieces to build a lookalike minifig. Fast, fun, and memorable.",
    ctas: [
        {label: "Sign in to process", href: "/login"},
        {label: "See price per image", href: "/#precio", variant: "secondary"},
    ],
};

const highlights = [
    {
        title: "Real lookalike",
        description: "We pick hair, head, torso, and legs to resemble the photo."
    },
    {title: "For any occasion", description: "Birthdays, anniversaries, graduations, or just because."},
    {title: "Transparent pricing", description: "Price per image and discount when adding more photos."},
    {title: "Ready to shop", description: "Includes SKUs and alternatives to avoid delays."},
];

const steps = [
    {title: "Upload a clear photo of one person", description: "Front-facing works best, with good lighting. For multiple people, use one photo per person."},
    {title: "We match official parts", description: "Closest official pieces and 1–2 alternatives per part."},
    {title: "Receive your list", description: "SKUs and links ready to buy at the LEGO store."},
    {title: "Gift and surprise", description: "Assemble and deliver a minifig that truly looks like them."},
];

const sections = [
    {
        heading: "A memorable gift in an instant",
        body: "Most lists are ready in less than a minute per person.",
        bullets: [
            {title: "Fast delivery", description: "Parts list in minutes."},
            {title: "Alternates included", description: "Backups per piece if stock changes."},
            {
                title: "No LEGO® affiliation",
                description: "Independent service using official parts; LEGO® is a trademark of the LEGO Group."
            },
        ],
    },
    {
        heading: "Why Brickify for LEGO-style gifts",
        body: "Forget hunting through catalogs. We do the matching and check availability; you just buy and build.",
        bullets: [
            {title: "Saves hours", description: "Receive a ready-to-shop list."},
            {title: "Looks precise", description: "Color and expression picked to resemble the photo."},
            {title: "Flexible", description: "For couples, friends, kids, coworkers, and collectors."},
        ],
    },
    {
        heading: "Start with the strongest from-photo page",
        body: "If your main intent is turning a photo into a LEGO-style figure, the dedicated from-photo page is the clearest match and helps compare use cases before you upload.",
        bullets: [
            {title: "LEGO figure from photo", description: "Go to /custom-lego-minifigure-photo for the most direct photo-to-minifigure flow."},
            {title: "Birthday gifts", description: "Use /lego-birthday-gift if the photo is for a one-person birthday present."},
            {title: "Couples and anniversaries", description: "Use /custom-lego-gifts-for-couples for shared-photo gifts and romantic occasions."},
        ],
    },
];
---

<MarketingPage
        locale={locale}
        seo={seo}
        hero={hero}
        highlights={highlights}
        steps={steps}
        sections={sections}
        showPriceCalculator={true}
/> 