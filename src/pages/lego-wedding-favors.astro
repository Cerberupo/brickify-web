---
import MarketingPage from "@/components/marketing/MarketingPage.astro";
import type {SupportedLocale} from "@/lib/locale";

const locale: SupportedLocale = 'en';
const seo = {
    title: "LEGO wedding favors: personalized minifigs from photos | Brickify",
    description: "Upload guest photos, we deliver the closest official LEGO® part lists with backups, and you assemble unforgettable lookalike favors. Clear pricing that drops with volume.",
    canonical: "/lego-wedding-favors",
    alternates: [
        {href: "/en/lego-wedding-favors", hrefLang: "en"},
        {href: "/es/recuerdos-boda-lego-personalizados", hrefLang: "es"},
    ],
};

const hero = {
    eyebrow: "Wedding favors that actually resemble your guests",
    title: "Personalized LEGO®-style wedding favors from guest photos",
    description: "Drop your guest photos, we match the closest official bricks (hair, head, torso, legs) and send you a ready-to-shop list with alternates for stock changes.",
    ctas: [
        {label: "Sign in to process", href: "/login"},
        {label: "See volume pricing", href: "#precio", variant: "secondary"},
    ],
};

const highlights = [
    {
        title: "Lookalike favors",
        description: "Hair, head, torso and legs chosen to resemble each guest, with SKUs and buy links."
    },
    {title: "Volume savings", description: "Per-image price drops as you add bridal party and guest photos."},
    {title: "Stock-safe lists", description: "Backups per key piece so you never pause ordering."},
    {title: "Assemble anywhere", description: "Order where you prefer, assemble quickly and place on tables or kits."},
];

const steps = [
    {title: "Collect guest photos", description: "Front-facing is ideal; add notes like hairstyles or outfits."},
    {
        title: "We match official parts",
        description: "Closest hair, heads, torsos and legs plus alternates for stock shifts."
    },
    {
        title: "Approve and shop",
        description: "SKUs and links so you buy only what you need, with EUR pricing shown up front."
    },
    {
        title: "Assemble and place",
        description: "Build the favors, use as place cards, welcome gifts or thank-you surprises."
    },
];

const sections = [
    {
        heading: "Favors guests actually keep",
        body: "Lookalike minifigs work as place cards, welcome kit surprises or thank-you gifts that people keep on their desks.",
        bullets: [
            {title: "Place cards", description: "Seat guests with a custom minifig they’ll take home."},
            {title: "Bridal party kits", description: "Lookalike figures for bridesmaids, groomsmen and family."},
            {
                title: "Destination friendly",
                description: "Compact and easy to pack; order parts near the venue if needed."
            },
        ],
    },
    {
        heading: "Fast delivery, no guesswork",
        body: "Most lists are ready in under an hour in business hours. See EUR per-image pricing up front; backups per piece keep you moving even if stock shifts.",
        bullets: [
            {title: "Transparent pricing", description: "Per-image rate and total shown before you commit."},
            {title: "Backups included", description: "Alternates per key piece to avoid delays."},
            {
                title: "Independent service",
                description: "Not affiliated with LEGO®; we use official bricks responsibly."
            },
        ],
    },
];
---

<MarketingPage
        locale={locale}
        seo={seo}
        hero={hero}
        highlights={highlights}
        steps={steps}
        sections={sections}
        showPriceCalculator={true}
/> 