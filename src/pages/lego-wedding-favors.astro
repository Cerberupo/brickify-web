---
import MarketingPage from "@/components/marketing/MarketingPage.astro";
import type {SupportedLocale} from "@/lib/locale";

const locale: SupportedLocale = 'en';
const seo = {
    title: "Personalized LEGO wedding favors from photos | Brickify",
    description: "Create unique LEGO®-style wedding favors from your guests' photos. We provide the AI-selected official parts list and links so you can build unforgettable lookalikes.",
    canonical: "/lego-wedding-favors",
    alternates: [
        {href: "/lego-wedding-favors", hrefLang: "x-default"},
        {href: "/lego-wedding-favors", hrefLang: "en"},
        {href: "/es/recuerdos-boda-lego-personalizados", hrefLang: "es"},
    ],
    structuredData: {
        webpage: true,
        breadcrumb: [
            {name: "Home", url: "/en"},
            {name: "Wedding Favors", url: "/lego-wedding-favors"},
        ]
    }
};

const hero = {
    eyebrow: "Favors that actually resemble your guests",
    title: "LEGO®-style wedding favors made from your guests' photos",
    description: "Upload the photos, we pick the closest official pieces (hair, head, torso, legs) and send you a ready-to-shop list with alternates in case stock changes.",
    ctas: [
        {label: "Sign in to process", href: "/login"},
        {label: "See volume pricing", href: "/#precio", variant: "secondary"},
    ],
};

const highlights = [
    {
        title: "Real lookalike",
        description: "Hair, head, torso and legs chosen to resemble each guest, with SKUs and links."
    },
    {title: "Volume savings", description: "The price per image drops as you add bridal party and guests."},
    {title: "Stock-safe lists", description: "Alternates per key piece so you never pause ordering."},
    {title: "Assemble anywhere", description: "Buy where you prefer and assemble quickly for tables or kits."},
];

const steps = [
    {title: "Upload guest photos", description: "Front-facing works best; add notes for hairstyles or looks."},
    {title: "We match official parts", description: "Closest official pieces with backups for stock shifts."},
    {title: "Buy", description: "SKUs and links so you can purchase on the official LEGO store."},
    {
        title: "Assemble and place",
        description: "Build the favors and use them as place cards, welcome gifts, or thank-you surprises."
    },
];

const sections = [
    {
        heading: "Favors guests actually keep",
        body: "Lookalike minifigs work as place cards, welcome kit surprises, or thank-you gifts that end up on your guests' desks.",
        bullets: [
            {title: "Place cards", description: "Seat them with a personalized minifig they’ll take home."},
            {title: "Bridal party kits", description: "Lookalike figures for bridesmaids, groomsmen, and family."},
            {title: "Easy to transport", description: "Compact; buy parts near the venue if needed."},
        ],
    },
    {
        heading: "Fast, no stock blocks",
        body: "Most lists are ready in less than a minute. Transparent pricing per image; backups per piece prevent delays if stock changes.",
        bullets: [
            {title: "Transparent pricing", description: "Per-image rate and total shown before you commit."},
            {title: "Alternates included", description: "Backups for key pieces to shop without delays."},
            {
                title: "Independent service",
                description: "Not affiliated with LEGO®; we use official bricks responsibly."
            },
        ],
    },
];
---

<MarketingPage
        locale={locale}
        seo={seo}
        hero={hero}
        highlights={highlights}
        steps={steps}
        sections={sections}
        showPriceCalculator={true}
/> 