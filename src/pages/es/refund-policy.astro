---
import Layout from "@/layouts/main.astro";
import {Header} from "@/layouts/components/Header";
import FooterSection from "@/components/home/FooterSection.astro";
import RefundContent from "@/components/legal/RefundContent.astro";
import type {SupportedLocale} from "@/lib/locale";

const locale: SupportedLocale = 'es';
const content = {title: 'Brickify — Política de reembolso'};
const seo = {
    title: content.title,
    alternates: [
        {href: '/refund-policy', hrefLang: 'x-default'},
        {href: '/es/refund-policy', hrefLang: 'es'},
        {href: '/en/refund-policy', hrefLang: 'en'},
    ],
};
---
<Layout content={content} lang={locale} seo={seo}>
    <Header alternates={seo.alternates} client:only="react"/>
    <main class="relative overflow-x-hidden">
        <RefundContent locale={locale}/>
        <FooterSection locale={locale}/>
    </main>
</Layout>
