---
import MarketingPage from "@/components/marketing/MarketingPage.astro";
import type {SupportedLocale} from "@/lib/locale";

const locale: SupportedLocale = 'es';
const seo = {
    title: "Regalo LEGO® Personalizado Desde Foto | Brickify",
    description: "Convierte una foto en un regalo personalizado estilo LEGO® con lista de piezas oficiales, enlaces de compra y alternativas por stock para una minifig lookalike.",
    canonical: "/es/regalo-lego-personalizado",
    alternates: [
        {href: "/personalized-lego-gift", hrefLang: "x-default"},
        {href: "/en/personalized-lego-gift", hrefLang: "en"},
        {href: "/es/regalo-lego-personalizado", hrefLang: "es"},
    ],
    structuredData: {
        webpage: true,
        breadcrumb: [
            {name: "Inicio", url: "/es"},
            {name: "Regalo Personalizado", url: "/es/regalo-lego-personalizado"},
        ]
    }
};

const hero = {
    eyebrow: "Regala un minifig lookalike",
    title: "Regalo estilo LEGO® personalizado a partir de cualquier foto",
    description: "Sube una foto y te enviamos la lista exacta de piezas oficiales para montar un minifig que se parezca. Rápido, divertido y memorable.",
    ctas: [
        {label: "Accede para procesar", href: "/es/login"},
        {label: "Ver precio por imagen", href: "/es/#precio", variant: "secondary"},
    ],
};

const highlights = [
    {
        title: "Se parece de verdad",
        description: "Seleccionamos pelo, cabeza, torso y piernas para parecerse a la foto."
    },
    {title: "Para cualquier ocasión", description: "Cumpleaños, aniversarios, graduaciones o porque sí."},
    {title: "Precio transparente", description: "Precio por imagen y descuento al añadir más fotos."},
    {title: "Listo para comprar", description: "Incluimos SKUs y alternativas para evitar retrasos."},
];

const steps = [
    {title: "Sube una foto clara", description: "Mejor frontal; Con buena iluminación."},
    {title: "Hacemos el matching", description: "Piezas oficiales más cercanas y 1–2 alternativas por pieza."},
    {title: "Recibe tu lista", description: "SKUs y enlaces listos para comprar en la tienda LEGO."},
    {title: "Regala y sorprende", description: "Ensamblas y entregas un minifig que se parece de verdad."},
];

const sections = [
    {
        heading: "Un regalo memorable en un instante",
        body: "La mayoría de listas están preparadas en menos de un minuto por persona.",
        bullets: [
            {title: "Entrega rápida", description: "Lista de piezas en minutos."},
            {title: "Alternativas incluidas", description: "Respaldo por pieza si cambia el stock."},
            {
                title: "Sin afiliación LEGO®",
                description: "Servicio independiente con piezas oficiales; LEGO® es marca del Grupo LEGO."
            },
        ],
    },
    {
        heading: "Por qué Brickify para regalos LEGO-style",
        body: "Olvida buscar en catálogos. Hacemos el matching y te damos disponibilidad, tú solo compras y montas.",
        bullets: [
            {title: "Ahorra horas", description: "Recibe una lista preparada para comprar."},
            {title: "Se ve preciso", description: "Color y expresión elegidos para parecerse a la foto."},
            {title: "Flexible", description: "Para parejas, amigos, peques, coworkers y coleccionistas."},
        ],
    },
    {
        heading: "Empieza por la mejor página de desde foto",
        body: "Si tu intención principal es pasar de una foto a una figura estilo LEGO, la página específica de desde foto encaja mejor y ayuda a comparar casos de uso antes de subir la imagen.",
        bullets: [
            {title: "Figura LEGO desde foto", description: "Ve a /es/minifig-lego-personalizada-foto para el flujo más directo de foto a minifig."},
            {title: "Cumpleaños", description: "Usa /lego-birthday-gift si la foto es para un regalo de una sola persona."},
            {title: "Parejas y aniversarios", description: "Usa /custom-lego-gifts-for-couples si buscas ideas con foto compartida o un regalo romántico."},
        ],
    },
];
---

<MarketingPage
        locale={locale}
        seo={seo}
        hero={hero}
        highlights={highlights}
        steps={steps}
        sections={sections}
        showPriceCalculator={true}
/> 