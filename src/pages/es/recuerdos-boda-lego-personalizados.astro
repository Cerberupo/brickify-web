---
import MarketingPage from "@/components/marketing/MarketingPage.astro";
import type {SupportedLocale} from "@/lib/locale";

const locale: SupportedLocale = 'es';
const seo = {
    title: "Recuerdos de boda LEGO® personalizados con fotos | Brickify",
    description: "Crea recuerdos de boda únicos con figuras estilo LEGO® que se parecen a tus invitados. Te damos la lista de piezas oficiales seleccionada por IA y enlaces de compra.",
    canonical: "/es/recuerdos-boda-lego-personalizados",
    alternates: [
        {href: "/lego-wedding-favors", hrefLang: "x-default"},
        {href: "/en/lego-wedding-favors", hrefLang: "en"},
        {href: "/es/recuerdos-boda-lego-personalizados", hrefLang: "es"},
    ],
    structuredData: {
        webpage: true,
        breadcrumb: [
            {name: "Inicio", url: "/es"},
            {name: "Recuerdos de Boda", url: "/es/recuerdos-boda-lego-personalizados"},
        ]
    }
};

const hero = {
    eyebrow: "Recuerdos que sí se parecen a tus invitados",
    title: "Recuerdos de boda estilo LEGO® hechos desde las fotos de tus invitados",
    description: "Sube las fotos, elegimos las piezas oficiales más parecidas (pelo, cabeza, torso, piernas) y te enviamos una lista preparada para comprar.",
    ctas: [
        {label: "Accede para procesar", href: "/es/login"},
        {label: "Ver precios por volumen", href: "/es/#precio", variant: "secondary"},
    ],
};

const highlights = [
    {
        title: "Lookalike real",
        description: "Pelo, cabeza, torso y piernas elegidos para parecerse a cada invitado, con SKUs y enlaces."
    },
    {title: "Ahorro por volumen", description: "El precio por imagen baja al añadir cortejo e invitados."},
    {title: "Listas claras de piezas", description: "Cada pieza clave queda organizada para facilitar la compra."},
    {title: "Monta donde quieras", description: "Compra donde prefieras y monta rápido para mesas o kits."},
];

const steps = [
    {title: "Sube fotos de invitados", description: "Mejor frontales; añade notas de peinados o looks."},
    {title: "Hacemos el matching", description: "Piezas oficiales más cercanas para cada persona de la foto."},
    {title: "Compra", description: "SKUs y enlaces para que compres en la tienda oficial LEGO."},
    {
        title: "Monta y coloca",
        description: "Arma los recuerdos y úsalos como marcasitios, bienvenida o agradecimiento."
    },
];

const sections = [
    {
        heading: "Recuerdos que la gente guarda",
        body: "Minifigs lookalike funcionan como marcasitios, sorpresas en kits de bienvenida o regalos de agradecimiento que terminan en el escritorio de tus invitados.",
        bullets: [
            {title: "Marcasitios", description: "Siéntalos con un minifig personalizado que se llevan a casa."},
            {title: "Kits del cortejo", description: "Figuras lookalike para damas de honor, padrinos y familia."},
            {title: "Fácil de transportar", description: "Compactos; compra piezas cerca del venue si hace falta."},
        ],
    },
    {
        heading: "Elige la ruta correcta desde foto antes de subir imágenes",
        body: "Los recuerdos de boda suelen partir del mismo flujo de una persona por foto que los regalos y los pedidos para equipos, así que estas páginas ayudan a encajar mejor la intención.",
        bullets: [
            {title: "Minifig LEGO desde foto", description: "Ve a la página específica de desde foto si quieres la explicación más directa del flujo de una persona por imagen antes de agrupar fotos de invitados.", href: "/es/minifig-lego-personalizada-foto", linkLabel: "Ver la página desde foto"},
            {title: "Regalo de aniversario", description: "Si la necesidad principal es un detalle para pareja en vez de recuerdos para invitados, la página de aniversario encaja mejor.", href: "/es/regalo-aniversario-lego-personalizado", linkLabel: "Explorar regalos de aniversario"},
            {title: "Regalo personalizado", description: "Usa la página general si comparas bodas con cumpleaños, graduaciones u otras ocasiones desde foto.", href: "/es/regalo-lego-personalizado", linkLabel: "Ver regalos personalizados"},
        ],
    },
    {
        heading: "Rápido y claro",
        body: "La mayoría de listas están preparadas en menos de un minuto por persona. Precio en EUR por imagen a la vista y una lista clara para comprar y montar.",
        bullets: [
            {title: "Precio transparente", description: "Tarifa por imagen y total antes de comprometerte."},
            {title: "Lista lista para comprar", description: "Una guía clara por pieza para avanzar sin perder tiempo."},
            {title: "Servicio independiente", description: "Sin afiliación con LEGO®; usamos piezas oficiales."},
        ],
    },
];
---

<MarketingPage
        locale={locale}
        seo={seo}
        hero={hero}
        highlights={highlights}
        steps={steps}
        sections={sections}
        showPriceCalculator={true}
/> 
