---
import MarketingPage from "@/components/marketing/MarketingPage.astro";
import type {SupportedLocale} from "@/lib/locale";

const locale: SupportedLocale = 'es';
const seo = {
    title: "Minifig LEGO personalizada desde foto | Una persona por foto | Brickify",
    description: "Convierte la foto de una sola persona en una minifig estilo LEGO personalizada con lista de piezas oficiales y enlaces de compra.",
    canonical: "/es/minifig-lego-personalizada-foto",
    alternates: [
        {href: "/custom-lego-minifigure-photo", hrefLang: "x-default"},
        {href: "/en/custom-lego-minifigure-photo", hrefLang: "en"},
        {href: "/es/minifig-lego-personalizada-foto", hrefLang: "es"},
    ],
    structuredData: {
        webpage: true,
        breadcrumb: [
            {name: "Inicio", url: "/es"},
            {name: "Minifigura desde Foto", url: "/es/minifig-lego-personalizada-foto"},
        ]
    }
};

const hero = {
    eyebrow: "De tu foto a la lista exacta de piezas",
    title: "Convierte cualquier foto en una minifig estilo LEGO® que sí se parezca",
    description: "Sube la foto de una sola persona, elegimos las piezas oficiales más cercanas (pelo, cabeza, torso, piernas) y te enviamos una lista preparada para comprar.",
    ctas: [
        {label: "Accede para procesar", href: "/es/login"},
        {label: "Ver precio por imagen", href: "/es/#precio", variant: "secondary"},
    ],
};

const highlights = [
    {
        title: "Piezas oficiales más cercanas",
        description: "Pelo, cabeza, torso y piernas seleccionados para parecerse a tu foto, con SKUs y enlaces de compra.",
    },
    {
        title: "Matching hecho por nosotros",
        description: "Haz upload y aprueba. Sin horas de catálogo ni dudas con colores o caras.",
    },
    {
        title: "Listas claras de piezas",
        description: "Cada pieza clave queda organizada de forma clara para que comprar y montar sea más fácil.",
    },
    {
        title: "Mejor precio en volumen",
        description: "Para amigos, bodas o equipos, el precio por imagen baja al añadir más fotos.",
    },
];

const steps = [
    {
        title: "Sube una foto individual clara",
        description: "Usa una foto frontal de una sola persona. Con buena luz funciona mejor."
    },
    {
        title: "Hacemos el matching",
        description: "Elegimos pelo, cabeza, torso y piernas lo más cercanos posible."
    },
    {
        title: "Recibe tu lista",
        description: "Recibe SKUs y enlaces para comprar en la tienda LEGO."
    },
    {title: "Compra y monta", description: "Compra y arma una minifig lookalike en minutos."},
];

const sections = [
    {
        heading: "Brickify hace el trabajo duro por ti",
        body: "Los catálogos son enormes y los colores varían. Elegimos las piezas más cercanas y te damos una lista preparada para comprar para que no pierdas horas.",
        bullets: [
            {title: "Una persona por foto", description: "Este flujo funciona mejor con una foto individual. Si quieres varias personas, sube una foto separada para cada una."},
            {title: "Lista rápida", description: "Normalmente en menos de un minuto por persona (servicio 24/7)."},
            {
                title: "Fácil de seguir",
                description: "Un desglose claro por pieza hace que el montaje sea más sencillo."
            },
            {
                title: "Servicio independiente",
                description: "Sin afiliación con LEGO®; usamos piezas oficiales de forma responsable."
            },
        ],
    },
    {
        heading: "Listo para regalos, bodas y equipos",
        body: "Las figuras lookalike hacen que bodas, swag corporativo y regalos personales se sientan únicos. Sube varias fotos y baja el precio unitario.",
        bullets: [
            {title: "Bodas", description: "Recuerdos lookalike para invitados o el cortejo.", href: "/es/recuerdos-boda-lego-personalizados", linkLabel: "Ver ideas para bodas"},
            {title: "Corporativo", description: "Swag memorable para empleados, clientes o asistentes.", href: "/es/regalos-empresa-lego-personalizados", linkLabel: "Ver regalos corporativos"},
            {title: "Regalo único", description: "Cumpleaños, aniversarios, graduaciones o porque sí.", href: "/es/regalo-lego-personalizado", linkLabel: "Ver regalo personalizado"},
        ],
    },
    {
        heading: "Siguientes pasos útiles si comparas ideas desde foto",
        body: "Si estás preparando un regalo de cumpleaños, detalle de boda o regalo personalizado desde foto, estas páginas te ayudan a elegir el mejor enfoque antes de subir imágenes.",
        bullets: [
            {title: "Regalos personalizados desde foto", description: "Compara más casos de uso antes de subir imágenes.", href: "/es/regalo-lego-personalizado", linkLabel: "Ver página de regalo personalizado"},
            {title: "Bodas desde foto", description: "Revisa la landing específica si buscas detalles o regalos para invitados.", href: "/es/recuerdos-boda-lego-personalizados", linkLabel: "Ver ideas para bodas"},
            {title: "Aniversarios desde foto", description: "Si la intención real es un detalle romántico, salta a la landing específica de aniversario.", href: "/es/regalo-aniversario-lego-personalizado", linkLabel: "Ver regalo de aniversario"},
        ],
    },
];
---

<MarketingPage
        locale={locale}
        seo={seo}
        hero={hero}
        highlights={highlights}
        steps={steps}
        sections={sections}
        showPriceCalculator={true}
/> 
