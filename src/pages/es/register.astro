---
import MainLayout from "../../layouts/main.astro";
import {PROJECT_NAME} from "../../config";
import RegisterShell from "../../components/pages/register/RegisterShell";
import FooterSection from "@/components/home/FooterSection.astro";
import type {SupportedLocale} from "@/lib/locale";

const locale: SupportedLocale = 'es';
const initialSearch = Astro.url.search;
---
<MainLayout content={{title: `${PROJECT_NAME} - Registrarse`}}>
    <RegisterShell client:only="react" initialSearch={initialSearch}/>
    <FooterSection locale={locale}/>
</MainLayout>
