---
import Layout from "@/layouts/main.astro";
import {Header} from "@/layouts/components/Header";
import Breadcrumbs from "@/components/common/Breadcrumbs.astro";
import FooterSection from "@/components/home/FooterSection.astro";
import type {SupportedLocale} from "@/lib/locale";

const locale: SupportedLocale = 'es';
const seo = {
    title: "Ideas de regalos LEGO personalizados | Brickify",
    description: "Ocasiones y consejos para crear regalos únicos estilo LEGO® desde cualquier foto, con listas de piezas listas para comprar.",
    canonical: "/es/blog/ideas-regalos-lego-personalizados",
    alternates: [
        {href: "/blog/personalized-lego-gifts-ideas", hrefLang: "x-default"},
        {href: "/en/blog/personalized-lego-gifts-ideas", hrefLang: "en"},
    ],
};

const ctas = [
    {label: "Accede para procesar", href: "/es/login"},
    {label: "Ver precios de regalo", href: "/es/regalo-lego-personalizado#precio"},
];
---

<Layout content={{title: seo.title}} lang={locale} seo={seo}>
    <Header client:only="react"/>
    <main class="relative overflow-x-hidden">
        <article class="py-14 md:py-20 bg-white">
            <div class="container mx-auto px-4 md:px-6  blog-prose">
                <a href="/es/blog"
                   class="not-prose inline-flex items-center gap-1 text-sm text-neutral-600 hover:underline mb-4">
                    <span aria-hidden="true">←</span>
                    Volver
                </a>
                <Breadcrumbs class="mb-4" items={[
                    {label: 'Inicio', href: '/es'},
                    {label: 'Blog', href: '/es/blog'},
                    {label: 'Ideas de regalos LEGO personalizados'}
                ]}/>
                <h1 class="!mt-0">Ideas de regalos LEGO personalizados</h1>
                <p class="text-neutral-700">Convierte cualquier foto en una lista de piezas de minifig estilo LEGO®.
                    Aquí tienes ocasiones y tips para que tu regalo sea preciso y rápido de montar.</p>

                <h2>Ocasiones que funcionan muy bien</h2>
                <ul>
                    <li>Cumpleaños y aniversarios: crea un lookalike de la persona o la pareja.</li>
                    <li>Graduaciones: ajusta toga y colores; añade accesorio de libro o portátil.</li>
                    <li>Agradecimientos: clientes, profes, mentores; anota el estilo de ropa para elegir torso.</li>
                </ul>

                <h2>Cómo lograr el mejor parecido</h2>
                <ul>
                    <li>Sube una foto frontal clara; añade notas de color/largo de pelo si está oscura.</li>
                    <li>Menciona barba, gafas y el estilo de outfit (casual, formal, sport).</li>
                    <li>Pide 1–2 alternativas por pieza clave para evitar problemas de stock.</li>
                </ul>

                <h2>Tips de compra</h2>
                <ul>
                    <li>Precio por imagen en EUR; el precio unitario baja al subir más fotos.</li>
                    <li>Enviamos SKUs y enlaces para comprar en Pick a Brick o tu tienda habitual.</li>
                    <li>Se arma en minutos; acompaña con nota o plaquita para presentarlo.</li>
                </ul>

                <div class="not-prose mt-10 flex flex-wrap gap-3">
                    {ctas.map((cta) => (
                            <a href={cta.href}
                               class="inline-flex items-center justify-center rounded-full bg-primary text-white px-5 py-3 text-sm font-semibold shadow-sm hover:shadow-md transition">
                                {cta.label}
                            </a>
                    ))}
                </div>
            </div>
        </article>

        <FooterSection locale={locale}/>
    </main>
</Layout>