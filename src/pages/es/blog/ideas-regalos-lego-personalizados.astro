---
import Layout from "@/layouts/main.astro";
import {Header} from "@/layouts/components/Header";
import Breadcrumbs from "@/components/common/Breadcrumbs.astro";
import FooterSection from "@/components/home/FooterSection.astro";
import type {SupportedLocale} from "@/lib/locale";

const locale: SupportedLocale = 'es';
const seo = {
    title: "Ideas de regalos LEGO personalizados | Brickify",
    description: "Ocasiones y consejos para crear regalos únicos estilo LEGO® desde cualquier foto, con listas de piezas listas para comprar.",
    canonical: "/es/blog/ideas-regalos-lego-personalizados",
    alternates: [
        {href: "/blog/personalized-lego-gifts-ideas", hrefLang: "x-default"},
        {href: "/blog/personalized-lego-gifts-ideas", hrefLang: "en"},
        {href: "/es/blog/ideas-regalos-lego-personalizados", hrefLang: "es"},
    ],
};

const ctas = [
    {label: "Accede para procesar", href: "/es/login"},
    {label: "Ver precios de regalo", href: "/es/#precio"},
];
---

<Layout content={{title: seo.title}} lang={locale} seo={seo}>
    <Header alternates={seo.alternates} client:only="react"/>
    <main class="relative overflow-x-hidden">
        <article class="py-14 md:py-20 bg-white">
            <div class="container mx-auto px-4 md:px-6  blog-prose">
                <a href="/es/blog"
                   class="not-prose inline-flex items-center gap-1 text-sm text-neutral-600 hover:underline mb-4">
                    <span aria-hidden="true">←</span>
                    Volver
                </a>
                <Breadcrumbs class="mb-4" items={[
                    {label: 'Inicio', href: '/es'},
                    {label: 'Blog', href: '/es/blog'},
                    {label: 'Ideas de regalos LEGO personalizados'}
                ]}/>
                <h1 class="!mt-0">Ideas de regalos LEGO personalizados</h1>
                <p class="text-neutral-700">Convierte cualquier foto en una lista de piezas oficiales de LEGO® para
                    crear
                    minifiguras que se parecen a tus seres queridos. Descubre cómo usar Brickify para hacer regalos que
                    realmente emocionan.</p>

                <h2>Ocasiones perfectas para regalar un LEGO</h2>
                <ul>
                    <li><strong>Cumpleaños y aniversarios:</strong> Crea una versión "mini-yo" de la persona o la
                        pareja. Es un detalle que demuestra cuánto les conoces.
                    </li>
                    <li><strong>Graduaciones y éxitos:</strong> Inmortaliza ese momento especial con una figura que
                        lleve los colores de su universidad o sus herramientas de trabajo.
                    </li>
                    <li><strong>Agradecimientos:</strong> Sorprende a profesores, mentores o amigos con un compañero de
                        escritorio que se parece a ellos.
                    </li>
                </ul>

                <h2>Cómo lograr el mejor parecido</h2>
                <p>Nuestro sistema utiliza inteligencia artificial para analizar los rasgos de la foto que subas. Para
                    obtener el mejor resultado:</p>
                <ul>
                    <li><strong>Iluminación:</strong> Sube una foto frontal con buena luz donde se aprecien bien los
                        rasgos y el color de pelo.
                    </li>
                    <li><strong>Estilo de ropa:</strong> El sistema te sugerirá el torso y las piernas que mejor encajen
                        con el estilo de la imagen.
                    </li>
                    <li><strong>Sin complicaciones:</strong> No necesitas anotar rasgos manualmente; la IA se encarga de
                        identificar pelo, cara y ropa por ti.
                    </li>
                </ul>

                <h2>¿Por qué regalar Brickify?</h2>
                <ul>
                    <li><strong>Personalización automática:</strong> Solo subes la foto y recibes las recomendaciones de
                        piezas oficiales de LEGO®.
                    </li>
                    <li><strong>Lista preparada para comprar:</strong> Te damos las referencias exactas para que puedas
                        pedirlas directamente sin errores.
                    </li>
                    <li><strong>Un recuerdo para siempre:</strong> A diferencia de otros regalos, una minifigura
                        personalizada nunca acaba en la basura.
                    </li>
                </ul>

                <div class="not-prose mt-10 flex flex-wrap gap-3">
                    {ctas.map((cta) => (
                            <a href={cta.href}
                               class="inline-flex items-center justify-center rounded-full bg-primary text-white px-5 py-3 text-sm font-semibold shadow-sm hover:shadow-md transition">
                                {cta.label}
                            </a>
                    ))}
                </div>
            </div>
        </article>

        <FooterSection locale={locale}/>
    </main>
</Layout>