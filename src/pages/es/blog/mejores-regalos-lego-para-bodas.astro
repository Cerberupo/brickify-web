---
import Layout from "@/layouts/main.astro";
import {Header} from "@/layouts/components/Header";
import Breadcrumbs from "@/components/common/Breadcrumbs.astro";
import FooterSection from "@/components/home/FooterSection.astro";
import type {SupportedLocale} from "@/lib/locale";

const locale: SupportedLocale = 'es';
const seo = {
    title: "Mejores regalos LEGO para bodas | Brickify",
    description: "La mejor idea para tu boda: regala una minifigura personalizada a cada invitado. Descubre cómo crear legos que se parecen a tus seres queridos.",
    canonical: "/es/blog/mejores-regalos-lego-para-bodas",
    alternates: [
        {href: "/blog/best-lego-gifts-for-weddings", hrefLang: "x-default"},
        {href: "/blog/best-lego-gifts-for-weddings", hrefLang: "en"},
        {href: "/es/blog/mejores-regalos-lego-para-bodas", hrefLang: "es"},
    ],
};

const ctas = [
    {label: "Accede para procesar", href: "/es/login"},
    {label: "Ver precios boda", href: "/es/#precio"},
];
---

<Layout content={{title: seo.title}} lang={locale} seo={seo}>
    <Header alternates={seo.alternates} client:only="react"/>
    <main class="relative overflow-x-hidden">
        <article class="py-14 md:py-20 bg-white">
            <div class="container mx-auto px-4 md:px-6  blog-prose">
                <a href="/es/blog"
                   class="not-prose inline-flex items-center gap-1 text-sm text-neutral-600 hover:underline mb-4">
                    <span aria-hidden="true">←</span>
                    Volver
                </a>
                <Breadcrumbs class="mb-4" items={[
                    {label: 'Inicio', href: '/es'},
                    {label: 'Blog', href: '/es/blog'},
                    {label: 'Mejores regalos LEGO para bodas'}
                ]}/>
                <h1 class="!mt-0">Mejores regalos LEGO para bodas</h1>
                <p class="text-neutral-700">Los minifigs personalizados estilo LEGO® son recuerdos que los invitados sí
                    guardan. La idea que realmente marca la diferencia es crear una minifigura de cada invitado de tu
                    boda para que se sientan parte del recuerdo.</p>

                <div class="my-10 max-w-2xl">
                    <img
                        src="/memory-highlight.jpg"
                        srcset="/memory-highlight-small.jpg 600w, /memory-highlight.jpg 1200w"
                        sizes="(max-width: 768px) 800px, 672px"
                        alt="Minifiguras LEGO personalizadas de invitados de boda"
                        class="rounded-2xl shadow-lg w-full h-auto"
                    />
                    <p class="text-sm text-neutral-500 mt-3 italic">Una foto real de mi boda: cada LEGO fue
                        diseñado para parecerse a un invitado específico, ¡fue un éxito absoluto!</p>
                </div>

                <h2>Una minifigura para cada invitado</h2>
                <p>En mi boda, decidimos que el mejor regalo sería que cada invitado tuviera su propia minifigura
                    personalizada. No fue un regalo genérico; cada lego se parecía a la persona que lo recibía.</p>

                <h2>Personalización total</h2>
                <p>La clave es subir una foto de cada invitado. Nuestro sistema analiza los rasgos y te sugiere las
                    piezas (pelo, cara, ropa) que mejor encajan con su estilo real.</p>

                <h2>Úsalos como marcasitios</h2>
                <p>Coloca el minifig lookalike de cada invitado en su puesto en la mesa. Se convierte en el tema de
                    conversación instantáneo.</p>

                <h2>El factor sorpresa</h2>
                <p>Ver la reacción de los invitados al encontrar una "versión LEGO" de sí mismos no tiene precio. Es un
                    detalle que demuestra que has pensado en cada uno de ellos individualmente.</p>

                <h2>Proceso sencillo</h2>
                <p>Nuestro sistema te ayudará a gestionar la lista de piezas para que el montaje sea divertido y
                    organizado.</p>

                <h3>¿Por qué elegir minifiguras personalizadas?</h3>
                <ul>
                    <li><strong>Recuerdo único:</strong> Nadie tira un LEGO que se parece a él.</li>
                    <li><strong>Conversación asegurada:</strong> Los invitados compararán sus figuras durante toda la
                        cena.
                    </li>
                    <li><strong>Toque personal:</strong> Refleja el cariño que tienes por tus amigos y familiares.</li>
                </ul>

                <div class="not-prose mt-10 flex flex-wrap gap-3">
                    {ctas.map((cta) => (
                            <a href={cta.href}
                               class="inline-flex items-center justify-center rounded-full bg-white text-black border border-neutral-200 px-5 py-3 text-sm font-semibold shadow-sm hover:shadow-md transition">
                                {cta.label}
                            </a>
                    ))}
                </div>
            </div>
        </article>

        <FooterSection locale={locale}/>
    </main>
</Layout>
