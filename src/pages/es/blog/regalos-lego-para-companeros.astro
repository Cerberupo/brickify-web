---
import Layout from "@/layouts/main.astro";
import {Header} from "@/layouts/components/Header";
import Breadcrumbs from "@/components/common/Breadcrumbs.astro";
import FooterSection from "@/components/home/FooterSection.astro";
import type {SupportedLocale} from "@/lib/locale";

const locale: SupportedLocale = 'es';
const seo = {
    title: "Regalos LEGO para compañeros y equipos | Brickify",
    description: "Ideas corporativas para usar minifigs estilo LEGO® personalizados en eventos, onboarding y regalos a clientes.",
    canonical: "/es/blog/regalos-lego-para-companeros",
    alternates: [
        {href: "/blog/lego-gifts-for-coworkers", hrefLang: "x-default"},
        {href: "/blog/lego-gifts-for-coworkers", hrefLang: "en"},
        {href: "/es/blog/regalos-lego-para-companeros", hrefLang: "es"},
    ],
};

const ctas = [
    {label: "Accede para procesar", href: "/es/login"},
    {label: "Ver precios empresa", href: "/es/#precio"},
];
---

<Layout content={{title: seo.title}} lang={locale} seo={seo}>
    <Header alternates={seo.alternates} client:only="react"/>
    <main class="relative overflow-x-hidden">
        <article class="py-14 md:py-20 bg-white">
            <div class="container mx-auto px-4 md:px-6  blog-prose">
                <a href="/es/blog"
                   class="not-prose inline-flex items-center gap-1 text-sm text-neutral-600 hover:underline mb-4">
                    <span aria-hidden="true">←</span>
                    Volver
                </a>
                <Breadcrumbs class="mb-4" items={[
                    {label: 'Inicio', href: '/es'},
                    {label: 'Blog', href: '/es/blog'},
                    {label: 'Regalos LEGO para compañeros y equipos'}
                ]}/>
                <h1 class="!mt-0">Regalos LEGO para compañeros y equipos</h1>
                <p class="text-neutral-700">Los minifigs personalizados estilo LEGO® son el detalle perfecto para
                    celebrar éxitos en equipo o dar la bienvenida a nuevos compañeros. Solo necesitas una foto y nuestro
                    sistema te recomendará las piezas oficiales que mejor encajan con cada persona.</p>

                <h2>Kits de onboarding personalizados</h2>
                <p>Haz que el primer día sea inolvidable incluyendo una minifigura que se parezca al nuevo empleado en
                    su
                    kit de bienvenida. Solo tienes que subir su foto y recibirás la lista de piezas recomendadas.</p>

                <h2>Hitos y celebraciones de equipo</h2>
                <p>¿Habéis cerrado un gran proyecto? Celebradlo con una versión LEGO de todo el equipo. Al subir las
                    fotos
                    en lote, el proceso es rápido y el sistema te sugiere las piezas para que cada figura sea
                    reconocible.</p>

                <h2>Dinámicas de Team Building</h2>
                <p>Usa las minifiguras como una actividad divertida: entrega a cada uno sus piezas recomendadas para que
                    monten su propio "mini-yo". Es un rompehielo excelente para eventos y reuniones.</p>

                <h2>Detalles memorables para clientes</h2>
                <p>Sorprende a tus clientes con un regalo que no acabará en un cajón. Un compañero de escritorio que se
                    parece a ellos es una forma única de fortalecer la relación y destacar.</p>

                <h2>Empieza por la página correcta antes de subir fotos del equipo</h2>
                <ul>
                    <li><a href="/es/regalos-empresa-lego-personalizados">Página de regalos de empresa</a> si buscas el ángulo más claro para empleados, clientes y eventos.</li>
                    <li><a href="/es/minifig-lego-personalizada-foto">Página desde foto</a> si prefieres validar primero el flujo simple de una persona por imagen.</li>
                    <li><a href="/es/regalo-lego-personalizado">Página de regalo personalizado</a> si este mismo proyecto también puede servir para hitos o agradecimientos fuera del trabajo.</li>
                </ul>

                <h3>¿Cómo funciona Brickify para empresas?</h3>

                <ul>
                    <li><strong>Sube las fotos:</strong> Nuestro sistema analiza los rasgos faciales y el estilo.</li>
                    <li><strong>Recibe recomendaciones:</strong> Te sugerimos las piezas oficiales (pelo, cara, ropa)
                        más
                        parecidas.
                    </li>
                    <li><strong>Compra con confianza:</strong> Obtén la lista exacta de referencias para que tu pedido
                        sea
                        perfecto desde el primer momento.
                    </li>
                </ul>

                <div class="not-prose mt-10 flex flex-wrap gap-3">
                    {ctas.map((cta) => (
                            <a href={cta.href}
                               class="inline-flex items-center justify-center rounded-full bg-white text-black border border-neutral-200 px-5 py-3 text-sm font-semibold shadow-sm hover:shadow-md transition">
                                {cta.label}
                            </a>
                    ))}
                    <a href="/es/regalos-empresa-lego-personalizados"
                       class="inline-flex items-center justify-center rounded-full bg-white text-black border border-neutral-200 px-5 py-3 text-sm font-semibold shadow-sm hover:shadow-md transition">Ver página de empresa</a>
                </div>
            </div>
        </article>

        <FooterSection locale={locale}/>
    </main>
</Layout>