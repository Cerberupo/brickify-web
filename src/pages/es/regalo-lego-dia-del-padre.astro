---
import MarketingPage from "@/components/marketing/MarketingPage.astro";
import type {SupportedLocale} from "@/lib/locale";

const locale: SupportedLocale = 'es';
const seo = {
    title: "Regalo LEGO® para el Día del Padre con Foto | Brickify",
    description: "Convierte la foto de tu padre en un regalo estilo LEGO® personalizado para el Día del Padre. Obtén la lista de piezas oficiales más parecida en minutos para un recuerdo realmente personal.",
    canonical: "/es/regalo-lego-dia-del-padre",
    alternates: [
        {href: "/fathers-day-lego-gift", hrefLang: "x-default"},
        {href: "/en/fathers-day-lego-gift", hrefLang: "en"},
        {href: "/es/regalo-lego-dia-del-padre", hrefLang: "es"},
    ],
    structuredData: {
        webpage: true,
        breadcrumb: [
            {name: "Inicio", url: "/es"},
            {name: "Regalo Día del Padre", url: "/es/regalo-lego-dia-del-padre"},
        ]
    }
};

const hero = {
    eyebrow: "Un regalo del Día del Padre que sí se siente personal",
    title: "Crea un regalo estilo LEGO® para el Día del Padre a partir de una foto",
    description: "Sube una foto clara de tu padre y Brickify buscará las piezas oficiales más parecidas para montar una figura lookalike. Ideal para padres, abuelos y recuerdos familiares que duran más que el regalo típico.",
    ctas: [
        {label: "Accede para procesar", href: "/es/login"},
        {label: "Ver precios", href: "/es/#precio", variant: "secondary"},
    ],
};

const highlights = [
    {title: "Basado en una sola foto real", description: "Hacemos matching de pelo, cara, colores de ropa y detalles clave de una persona cada vez para que el resultado se reconozca."},
    {title: "Pensado para regalar", description: "Una alternativa más original que los regalos genéricos del Día del Padre, sobre todo para padres a los que les gustan los builds y los recuerdos personales."},
    {title: "También vale para quien va tarde", description: "La mayoría de listas se preparan en menos de un minuto, útil si el Día del Padre te pilla encima."},
    {title: "Lista para comprar", description: "Recibes referencias oficiales y opciones alternativas para facilitar el montaje final."},
];

const steps = [
    {title: "Sube una foto favorita", description: "Elige una imagen frontal de una sola persona, bien iluminada y con el peinado o la ropa que quieras conservar en la figura."},
    {title: "Buscamos las piezas oficiales más cercanas", description: "Brickify selecciona pelo, cabeza, torso y piernas, con alternativas cuando hay varias opciones buenas."},
    {title: "Recibe la lista de piezas", description: "Obtienes referencias listas para comprar en marketplaces oficiales o compatibles."},
    {title: "Móntalo y regálalo", description: "Construye la figura y conviértela en una sorpresa, recuerdo o detalle de escritorio para el Día del Padre."},
];

const sections = [
    {
        heading: "Por qué funciona tan bien para el Día del Padre",
        body: "Muchos regalos del Día del Padre se parecen demasiado entre sí. Una figura lookalike se siente más especial porque parte de un recuerdo real y lo convierte en algo digno de guardar.",
        bullets: [
            {title: "Emotivo", description: "Captura una cara conocida, un peinado o un look de una sola foto real."},
            {title: "Para conservar", description: "Queda bien en una estantería, en una mesa de trabajo o junto a una tarjeta."},
            {title: "Muy familiar", description: "Funciona para padres, abuelos o cualquier figura paterna de la familia."},
        ],
    },
    {
        heading: "Mejores usos para esta idea",
        body: "Esta landing está pensada para búsquedas con intención de regalo del Día del Padre, pero también encaja con otras búsquedas de regalo personalizado para padres y recuerdos familiares.",
        bullets: [
            {title: "Hijos y parejas", description: "Una opción más cálida que los regalos de tienda o los gadgets de última hora."},
            {title: "Abuelos", description: "Una figura personalizada que se siente especial sin encargar ilustración a medida."},
            {title: "Recuerdos familiares", description: "Usa un retrato favorito, una foto de celebración o una imagen cotidiana que le represente bien."},
        ],
    },
    {
        heading: "Servicio independiente con enfoque en piezas oficiales",
        body: "Brickify es un servicio independiente que te ayuda a encontrar las piezas oficiales más cercanas para un lookalike. LEGO® es una marca del Grupo LEGO, que no patrocina ni respalda este servicio.",
        bullets: [
            {title: "Sin buscar en catálogos", description: "Evitas recorrer manualmente cientos de cabezas, torsos y peinados."},
            {title: "Con alternativas por stock", description: "Las opciones de respaldo reducen retrasos si una pieza se agota antes del regalo."},
            {title: "Flujo centrado en la foto", description: "Empiezas por una persona, no por piezas al azar."},
        ],
    },
    {
        heading: "Si la intención real empieza en la foto",
        body: "El Día del Padre es una ruta estacional, pero mucha gente empieza buscando una figura estilo LEGO desde foto. Mantener ese camino evergreen enlazado ayuda a pasar intención en vez de encerrarla aquí.",
        bullets: [
            {title: "Figura LEGO desde foto", description: "Usa la ruta principal cuando el usuario arranca por el proceso de transformación y no solo por la ocasión.", href: "/es/minifig-lego-personalizada-foto", linkLabel: "Ver página desde foto"},
            {title: "Regalo personalizado desde foto", description: "La gente con intención de regalo más amplia también debería poder pasar fácilmente a la landing principal de gifting.", href: "/es/regalo-lego-personalizado", linkLabel: "Ver regalo personalizado"},
            {title: "Jubilación y regalo de despedida", description: "Parte de esta intención también roza regalos de mentor, despedida o hitos personales.", href: "/es/regalo-jubilacion-lego-personalizado", linkLabel: "Ver página de jubilación"},
        ],
    },
];
---

<MarketingPage
        locale={locale}
        seo={seo}
        hero={hero}
        highlights={highlights}
        steps={steps}
        sections={sections}
        showPriceCalculator={true}
/>
