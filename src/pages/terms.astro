---
import Layout from "@/layouts/main.astro";
import {Header} from "@/layouts/components/Header";
import FooterSection from "@/components/home/FooterSection.astro";
import TermsContent from "@/components/legal/TermsContent.astro";
import {normalizeLocale, type SupportedLocale} from "@/lib/locale";

const locale: SupportedLocale = normalizeLocale(Astro.currentLocale as string | undefined);
const content = {title: locale === 'es' ? 'Brickify — Términos de servicio' : 'Brickify — Terms of Service'};
const path = Astro.url?.pathname || '/terms-of-service';
const isEs = locale === 'es' || path.startsWith('/es');
const canonical = isEs ? '/es/terms' : (path.startsWith('/en') ? '/en/terms-of-service' : '/terms-of-service');
const seo = {
    title: content.title,
    canonical,
    alternates: [
        {href: '/terms-of-service', hrefLang: 'x-default'},
        {href: '/es/terms', hrefLang: 'es'},
        {href: '/en/terms-of-service', hrefLang: 'en'},
    ],
};
---
<Layout content={content} lang={locale} seo={seo}>
    <Header alternates={seo.alternates} client:only="react"/>
    <main class="relative overflow-x-hidden">
        <TermsContent locale={locale}/>
        <FooterSection locale={locale}/>
    </main>
</Layout>