---
import Layout from "@/layouts/main.astro";
import { Header } from "@/layouts/components/Header";
import FooterSection from "@/components/home/FooterSection.astro";
import TermsContent from "@/components/legal/TermsContent.astro";
import type { SupportedLocale } from "@/lib/locale";

const pathLang = Astro.url?.pathname?.startsWith('/es') ? 'es' : 'en';
const locale: SupportedLocale = (pathLang === 'es' ? 'es' : 'en');
const content = { title: pathLang === 'es' ? 'Brickify — Términos de servicio' : 'Brickify — Terms of Service' };
---
<Layout content={content} lang={locale}>
  <Header client:only="react" />
  <main class="relative overflow-x-hidden">
    <TermsContent locale={locale} />
    <FooterSection locale={locale} />
  </main>
</Layout>