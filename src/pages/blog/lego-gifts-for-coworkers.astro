---
import Layout from "@/layouts/main.astro";
import {Header} from "@/layouts/components/Header";
import Breadcrumbs from "@/components/common/Breadcrumbs.astro";
import FooterSection from "@/components/home/FooterSection.astro";
import type {SupportedLocale} from "@/lib/locale";

const locale: SupportedLocale = 'en';
const seo = {
    title: "LEGO Gifts for Coworkers, Teams and Client Gifts | Brickify",
    description: "Corporate gift ideas using personalized LEGO-style figures for onboarding, employee milestones, events and memorable client gifts.",
    canonical: "/blog/lego-gifts-for-coworkers",
    alternates: [
        {href: "/blog/lego-gifts-for-coworkers", hrefLang: "x-default"},
        {href: "/blog/lego-gifts-for-coworkers", hrefLang: "en"},
        {href: "/es/blog/regalos-lego-para-companeros", hrefLang: "es"},
    ],
};

const ctas = [
    {label: "Sign in to process", href: "/login"},
    {label: "See corporate pricing", href: "/#precio"},
];
---

<Layout content={{title: seo.title}} lang={locale} seo={seo}>
    <Header alternates={seo.alternates} client:only="react"/>
    <main class="relative overflow-x-hidden">
        <article class="py-14 md:py-20 bg-white">
            <div class="container mx-auto px-4 md:px-6  blog-prose">
                <a href="/blog"
                   class="not-prose inline-flex items-center gap-1 text-sm text-neutral-600 hover:underline mb-4">
                    <span aria-hidden="true">←</span>
                    Back
                </a>
                <Breadcrumbs class="mb-4" items={[
                    {label: 'Home', href: '/en'},
                    {label: 'Blog', href: '/blog'},
                    {label: 'LEGO gifts for coworkers and teams'}
                ]}/>
                <h1 class="!mt-0">LEGO gifts for coworkers and teams</h1>
                <p class="text-neutral-700">Personalized LEGO®-style figures are the perfect detail to celebrate team
                    successes or welcome new colleagues. You only need a photo, and our system will recommend the
                    official pieces that best fit each person.</p>

                <h2>Personalized onboarding kits</h2>
                <p>Make the first day unforgettable by including a personalized figure that looks like the new employee in their
                    welcome kit. Just upload their photo and you'll receive the list of recommended pieces.</p>

                <h2>Team milestones and celebrations</h2>
                <p>Have you closed a big project? Celebrate it with a LEGO version of the entire team. By uploading
                    photos in bulk, the process is fast and the system suggests pieces so that each figure is
                    recognizable.</p>

                <h2>Team Building dynamics</h2>
                <p>Use personalized figures as a fun activity: give everyone their recommended pieces to assemble their own
                    "mini-me". It's an excellent icebreaker for events and meetings.</p>

                <h2>Memorable details for clients</h2>
                <p>Surprise your clients with a gift that won't end up in a drawer. A desk companion that looks like
                    them is a unique way to strengthen the relationship and stand out.</p>

                <h2>Where this works best in a company</h2>
                <ul>
                    <li><strong>Onboarding:</strong> Add a fun, personalized item to the welcome box.</li>
                    <li><strong>Conferences and events:</strong> Give attendees something more memorable than generic swag.</li>
                    <li><strong>Client thank-yous:</strong> Use it for key accounts, milestone gifts or post-project surprises.</li>
                </ul>

                <h3>How does Brickify for business work?</h3>
                <ul>
                    <li><strong>Upload photos:</strong> Our system analyzes facial features and style.</li>
                    <li><strong>Receive recommendations:</strong> We suggest the closest official pieces (hair, face,
                        clothing).
                    </li>
                    <li><strong>Buy with confidence:</strong> Get the exact list of references so your order is perfect
                        from the first moment.
                    </li>
                </ul>

                <div class="not-prose mt-10 flex flex-wrap gap-3">
                    {ctas.map((cta) => (
                            <a href={cta.href}
                               class="inline-flex items-center justify-center rounded-full bg-white text-black border border-neutral-200 px-5 py-3 text-sm font-semibold shadow-sm hover:shadow-md transition">
                                {cta.label}
                            </a>
                    ))}
                    <a href="/corporate-lego-gifts"
                       class="inline-flex items-center justify-center rounded-full bg-white text-black border border-neutral-200 px-5 py-3 text-sm font-semibold shadow-sm hover:shadow-md transition">See corporate gifts page</a>
                </div>
            </div>
        </article>

        <FooterSection locale={locale}/>
    </main>
</Layout>
