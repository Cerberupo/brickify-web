---
import Layout from "/src/layouts/main.astro";
import {Header} from "/src/layouts/components/Header";
import FooterSection from "/src/components/home/FooterSection.astro";
import Breadcrumbs from "/src/components/common/Breadcrumbs.astro";
import type {SupportedLocale} from "/src/lib/locale";

const locale: SupportedLocale = 'en';
const seo = {
    title: "LEGO gifts for coworkers and teams | Brickify",
    description: "Corporate-friendly ideas to use personalized LEGO®-style minifigs for events, onboarding and client swag.",
    canonical: "/blog/lego-gifts-for-coworkers",
    alternates: [
        {href: "/en/blog/lego-gifts-for-coworkers", hrefLang: "en"},
        {href: "/es/blog/regalos-lego-para-companeros", hrefLang: "es"},
    ],
};

// Meta
const date = "2025-11-24";
const readMin = 5;
const formatDate = (iso: string) => new Intl.DateTimeFormat('en-US', {
    year: 'numeric', month: 'long', day: 'numeric'
}).format(new Date(iso));

const ctas = [
    {label: "Sign in to process", href: "/en/login"},
    {label: "See corporate pricing", href: "/corporate-lego-gifts#precio"},
];
---

<Layout content={{title: seo.title}} lang={locale} seo={seo}>
    <Header client:only="react"/>
    <main class="relative overflow-x-hidden">
        <article class="py-14 md:py-20 bg-white">
            <div class="container mx-auto px-4 md:px-6  blog-prose">
                <a href="/blog"
                   class="not-prose inline-flex items-center gap-1 text-sm text-neutral-600 hover:underline mb-4">
                    <span aria-hidden="true">←</span>
                    Back
                </a>
                <Breadcrumbs class="mb-4" items={[{label: 'Home', href: '/en'}, {
                    label: 'Blog',
                    href: '/blog'
                }, {label: 'LEGO gifts for coworkers and teams'}]}/>
                <p class="text-sm uppercase tracking-[0.2em] text-primary mb-3">Corporate ideas</p>
                <h1 class="!mt-0">LEGO gifts for coworkers and teams</h1>
                <p class="not-prose text-xs text-neutral-500 mb-6 flex items-center gap-3">
                    <span class="inline-flex items-center gap-1">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-70"><path
                                d="M8 2v4"/><path d="M16 2v4"/><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><path
                                d="M3 10h18"/></svg>
                        <time datetime={date}>{formatDate(date)}</time>
                    </span>
                    <span aria-hidden="true" class="opacity-40">•</span>
                    <span class="inline-flex items-center gap-1">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-70"><circle
                                cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                        {readMin} min read
                    </span>
                </p>
                <p class="text-neutral-700">Personalized LEGO®-style minifigs are memorable, safe for corporate
                    settings, and ship flat. Here’s how to use them for onboarding, events and client swag.</p>

                <h2>1) Onboarding kits</h2>
                <ul>
                    <li>Include a lookalike minifig in welcome boxes. Upload a front photo per new hire.</li>
                    <li>Note brand colors for torso/legs to align with your company palette.</li>
                </ul>

                <h2>2) Event giveaways</h2>
                <p>For conferences or meetups, ask for alternates per piece so you can order quickly. Minifigs pack
                    light and survive travel.</p>

                <h2>3) Client thank-you gifts</h2>
                <p>Upload a client’s photo (with permission) and deliver a personalized desk companion. Add a small
                    baseplate with a thank-you note.</p>

                <h2>4) Team milestones</h2>
                <p>Celebrate project launches or anniversaries with lookalike figures of the team. Batch uploads reduce
                    per-image cost.</p>

                <h3>Checklist for smooth orders</h3>
                <ul>
                    <li>Front photos of each person; note hair color/length and glasses/beards.</li>
                    <li>Request 1–2 alternates per key piece to avoid stock delays.</li>
                    <li>Use EUR pricing per image; bigger batches lower the unit price.</li>
                </ul>

                <div class="not-prose mt-10 flex flex-wrap gap-3">
                    {ctas.map((cta) => (
                            <a href={cta.href}
                               class="inline-flex items-center justify-center rounded-full bg-primary text-white px-5 py-3 text-sm font-semibold shadow-sm hover:shadow-md transition">
                                {cta.label}
                            </a>
                    ))}
                </div>
            </div>
        </article>

        <FooterSection locale={locale}/>
    </main>
</Layout>
