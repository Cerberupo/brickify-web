---
import Layout from "@/layouts/main.astro";
import {Header} from "@/layouts/components/Header";
import Breadcrumbs from "@/components/common/Breadcrumbs.astro";
import FooterSection from "@/components/home/FooterSection.astro";
import type {SupportedLocale} from "@/lib/locale";

const locale: SupportedLocale = 'en';
const seo = {
    title: "Personalized LEGO gift ideas | Brickify",
    description: "Occasions and tips to create unique LEGO®-style gifts from any photo, with ready-to-buy parts lists.",
    canonical: "/blog/personalized-lego-gifts-ideas",
    alternates: [
        {href: "/blog/personalized-lego-gifts-ideas", hrefLang: "x-default"},
        {href: "/blog/personalized-lego-gifts-ideas", hrefLang: "en"},
        {href: "/es/blog/ideas-regalos-lego-personalizados", hrefLang: "es"},
    ],
};

const ctas = [
    {label: "Sign in to process", href: "/login"},
    {label: "See gift pricing", href: "/personalized-lego-gift#precio"},
];
---

<Layout content={{title: seo.title}} lang={locale} seo={seo}>
    <Header alternates={seo.alternates} client:only="react"/>
    <main class="relative overflow-x-hidden">
        <article class="py-14 md:py-20 bg-white">
            <div class="container mx-auto px-4 md:px-6  blog-prose">
                <a href="/blog"
                   class="not-prose inline-flex items-center gap-1 text-sm text-neutral-600 hover:underline mb-4">
                    <span aria-hidden="true">←</span>
                    Back
                </a>
                <Breadcrumbs class="mb-4" items={[
                    {label: 'Home', href: '/en'},
                    {label: 'Blog', href: '/blog'},
                    {label: 'Personalized LEGO gift ideas'}
                ]}/>
                <h1 class="!mt-0">Personalized LEGO gift ideas</h1>
                <p class="text-neutral-700">Turn any photo into a list of official LEGO® pieces to create minifigures
                    that look like your loved ones. Discover how to use Brickify to make gifts that truly move
                    people.</p>

                <h2>Perfect occasions to gift a LEGO</h2>
                <ul>
                    <li><strong>Birthdays and anniversaries:</strong> Create a \"mini-me\" version of the person or the
                        couple. It's a detail that shows how well you know them.
                    </li>
                    <li><strong>Graduations and successes:</strong> Immortalize that special moment with a figure
                        wearing their university colors or work tools.
                    </li>
                    <li><strong>Thank-yous:</strong> Surprise teachers, mentors, or friends with a desk companion that
                        looks just like them.
                    </li>
                </ul>

                <h2>How to get the best likeness</h2>
                <p>Our system uses artificial intelligence to analyze the features of the photo you upload. To get the
                    best result:</p>
                <ul>
                    <li><strong>Lighting:</strong> Upload a front-facing photo with good light where features and hair
                        color can be clearly seen.
                    </li>
                    <li><strong>Clothing style:</strong> The system will suggest the torso and legs that best match the
                        style of the image.
                    </li>
                    <li><strong>Hassle-free:</strong> You don't need to note down features manually; the IA takes care
                        of identifying hair, face, and clothes for you.
                    </li>
                </ul>

                <h2>Why gift Brickify?</h2>
                <ul>
                    <li><strong>Automatic personalization:</strong> You just upload the photo and receive official LEGO®
                        part recommendations.
                    </li>
                    <li><strong>Ready-to-buy list:</strong> We give you the exact references so you can order them
                        directly without errors.
                    </li>
                    <li><strong>A keepsake forever:</strong> Unlike other gifts, a personalized minifigure never ends up
                        in the trash.
                    </li>
                </ul>

                <div class="not-prose mt-10 flex flex-wrap gap-3">
                    {ctas.map((cta) => (
                            <a href={cta.href}
                               class="inline-flex items-center justify-center rounded-full bg-primary text-white px-5 py-3 text-sm font-semibold shadow-sm hover:shadow-md transition">
                                {cta.label}
                            </a>
                    ))}
                </div>
            </div>
        </article>

        <FooterSection locale={locale}/>
    </main>
</Layout>
