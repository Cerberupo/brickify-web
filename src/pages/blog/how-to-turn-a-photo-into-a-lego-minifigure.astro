---
import Layout from "@/layouts/main.astro";
import {Header} from "@/layouts/components/Header";
import Breadcrumbs from "@/components/common/Breadcrumbs.astro";
import FooterSection from "@/components/home/FooterSection.astro";
import type {SupportedLocale} from "@/lib/locale";

const locale: SupportedLocale = 'en';
const seo = {
    title: "How to turn a photo into a LEGO minifigure | Brickify",
    description: "Step-by-step guide to get the closest official LEGO® parts list from your photo and build a lookalike minifig.",
    canonical: "/blog/how-to-turn-a-photo-into-a-lego-minifigure",
    alternates: [
        {href: "/en/blog/how-to-turn-a-photo-into-a-lego-minifigure", hrefLang: "en"},
        {href: "/es/blog/como-convertir-una-foto-en-minifig-lego", hrefLang: "es"},
    ],
};

// Meta
const date = "2025-11-20";
const readMin = 6;
const formatDate = (iso: string) => new Intl.DateTimeFormat('en-US', {
    year: 'numeric', month: 'long', day: 'numeric'
}).format(new Date(iso));

const ctas = [
    {label: "Sign in to process", href: "/en/login"},
    {label: "See price per image", href: "/custom-lego-minifigure-photo#precio"},
];
---

<Layout content={{title: seo.title}} lang={locale} seo={seo}>
    <Header client:only="react"/>
    <main class="relative overflow-x-hidden">
        <article class="py-14 md:py-20 bg-white">
            <div class="container mx-auto px-4 md:px-6  blog-prose">
                <a href="/blog"
                   class="not-prose inline-flex items-center gap-1 text-sm text-neutral-600 hover:underline mb-4">
                    <span aria-hidden="true">←</span>
                    Back
                </a>
                <Breadcrumbs class="mb-4" items={[
                    {label: 'Home', href: '/en'},
                    {label: 'Blog', href: '/blog'},
                    {label: 'How to turn a photo into a LEGO minifigure'}
                ]}/>
                <h1 class="!mt-0">How to turn a photo into a LEGO minifigure</h1>
                <p class="not-prose text-xs text-neutral-500 mb-6 flex items-center gap-3">
                    <span class="inline-flex items-center gap-1">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-70"><path
                                d="M8 2v4"/><path d="M16 2v4"/><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><path
                                d="M3 10h18"/></svg>
                        <time datetime={date}>{formatDate(date)}</time>
                    </span>
                    <span aria-hidden="true" class="opacity-40">•</span>
                    <span class="inline-flex items-center gap-1">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-70"><circle
                                cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                        {readMin} min read
                    </span>
                </p>
                <p class="text-neutral-700 mb-5 leading-relaxed">Here’s the quickest way to get a lookalike minifig:
                    upload your photo, we
                    match the closest official LEGO® parts, and you buy only what you need. Not affiliated with
                    LEGO®.</p>

                <h2>1) Pick a clear photo</h2>
                <ul class="my-5 space-y-2">
                    <li>Front-facing, good lighting, no heavy filters.</li>
                    <li>Include hair visible; if wearing a hat, add a note about hair color/length.</li>
                </ul>

                <h2>2) Upload your photo</h2>
                <p class="my-5 leading-relaxed">Go to the home flow and drop your image. Use a clear front photo; good
                    lighting helps.</p>

                <h2>3) We match official parts</h2>
                <ul class="my-5 space-y-2">
                    <li>Hair, head (expression/skin tone), torso and legs picked to resemble the photo.</li>
                    <li>Each key piece includes 1–2 alternates in case stock shifts.</li>
                </ul>

                <h2>4) Review your parts list</h2>
                <p class="my-5 leading-relaxed">We send SKUs and links so you can buy on LEGO® Pick a Brick or your
                    usual store. Pricing is per image
                    in EUR; unit price drops with more photos.</p>

                <h2>5) Buy and build</h2>
                <p class="my-5 leading-relaxed">Order the parts, assemble in minutes, and share your lookalike
                    minifig.</p>

                <h3>Fast tips for accuracy</h3>
                <ul class="my-5 space-y-2">
                    <li>Mention hair tone and length if the photo isn’t clear.</li>
                    <li>If it’s for a gift, note the occasion (wedding, birthday, corporate) to match outfits.</li>
                    <li>Upload multiple photos to reduce per-image cost.</li>
                </ul>

                <div class="not-prose mt-10 flex flex-wrap gap-3">
                    {ctas.map((cta) => (
                            <a href={cta.href}
                               class="inline-flex items-center justify-center rounded-full bg-primary text-white px-5 py-3 text-sm font-semibold shadow-sm hover:shadow-md transition">
                                {cta.label}
                            </a>
                    ))}
                </div>
            </div>
        </article>

        <FooterSection locale={locale}/>
    </main>
</Layout>