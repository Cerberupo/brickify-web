---
import Layout from "/src/layouts/main.astro";
import {Header} from "/src/layouts/components/Header";
import Breadcrumbs from "/src/components/common/Breadcrumbs.astro";
import FooterSection from "/src/components/home/FooterSection.astro";
import type {SupportedLocale} from "/src/lib/locale";

const locale: SupportedLocale = 'en';
const seo = {
    title: "Best LEGO gifts for weddings | Brickify",
    description: "Ideas to delight guests and the wedding party with personalized LEGO®-style minifigs from their photos.",
    canonical: "/blog/best-lego-gifts-for-weddings",
    alternates: [
        {href: "/en/blog/best-lego-gifts-for-weddings", hrefLang: "en"},
        {href: "/es/blog/mejores-regalos-lego-para-bodas", hrefLang: "es"},
    ],
};

// Meta
const date = "2025-11-22";
const readMin = 5;
const formatDate = (iso: string) => new Intl.DateTimeFormat('en-US', {
    year: 'numeric', month: 'long', day: 'numeric'
}).format(new Date(iso));

const ctas = [
    {label: "Sign in to process", href: "/en/login"},
    {label: "See wedding pricing", href: "/lego-wedding-favors#precio"},
];
---

<Layout content={{title: seo.title}} lang={locale} seo={seo}>
    <Header client:only="react"/>
    <main class="relative overflow-x-hidden">
        <article class="py-14 md:py-20 bg-white">
            <div class="container mx-auto px-4 md:px-6  blog-prose">
                <a href="/blog"
                   class="not-prose inline-flex items-center gap-1 text-sm text-neutral-600 hover:underline mb-4">
                    <span aria-hidden="true">←</span>
                    Back
                </a>
                <Breadcrumbs class="mb-4" items={[{label: 'Home', href: '/en'}, {
                    label: 'Blog',
                    href: '/blog'
                }, {label: 'Best LEGO gifts for weddings'}]}/>
                <p class="text-sm uppercase tracking-[0.2em] text-primary mb-3">Wedding ideas</p>
                <h1 class="!mt-0">Best LEGO gifts for weddings</h1>
                <p class="not-prose text-xs text-neutral-500 mb-6 flex items-center gap-3">
                    <span class="inline-flex items-center gap-1">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-70"><path
                                d="M8 2v4"/><path d="M16 2v4"/><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><path
                                d="M3 10h18"/></svg>
                        <time datetime={date}>{formatDate(date)}</time>
                    </span>
                    <span aria-hidden="true" class="opacity-40">•</span>
                    <span class="inline-flex items-center gap-1">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-70"><circle
                                cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                        {readMin} min read
                    </span>
                </p>
                <p class="text-neutral-700">Personalized LEGO®-style minifigs make unforgettable wedding favors. Here’s
                    how to create lookalike figures that guests actually keep.</p>

                <h2>1) Make the couple and bridal party lookalike</h2>
                <ul>
                    <li>Upload clear photos of the couple and the wedding party.</li>
                    <li>Add notes on attire colors (dress, suit, ties) to match torsos and legs.</li>
                </ul>

                <h2>2) Use minifigs as table place cards</h2>
                <p>Place a lookalike minifig at each setting. Guests keep them as a souvenir and it doubles as a fun
                    seating marker.</p>

                <h2>3) Include backups for stock changes</h2>
                <p>Ask for 1–2 alternates per key piece (hair, head, torso) so you can order without delays.</p>

                <h2>4) Order in batches to save</h2>
                <p>The per-image price drops when you upload multiple guest photos. Batch uploads help you stay on
                    budget.</p>

                <h2>5) Pack and present</h2>
                <p>Use small boxes or organza bags with a note. They travel well for destination weddings.</p>

                <h3>Quick checklist</h3>
                <ul>
                    <li>Front photos of couple + bridal party + key guests.</li>
                    <li>Colors for outfits; note accessories like glasses/beards.</li>
                    <li>Request alternates per piece to avoid stock surprises.</li>
                </ul>

                <div class="not-prose mt-10 flex flex-wrap gap-3">
                    {ctas.map((cta) => (
                            <a href={cta.href}
                               class="inline-flex items-center justify-center rounded-full bg-primary text-white px-5 py-3 text-sm font-semibold shadow-sm hover:shadow-md transition">
                                {cta.label}
                            </a>
                    ))}
                </div>
            </div>
        </article>

        <FooterSection locale={locale}/>
    </main>
</Layout>
