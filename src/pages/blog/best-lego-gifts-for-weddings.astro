---
import Layout from "@/layouts/main.astro";
import {Header} from "@/layouts/components/Header";
import Breadcrumbs from "@/components/common/Breadcrumbs.astro";
import FooterSection from "@/components/home/FooterSection.astro";
import type {SupportedLocale} from "@/lib/locale";

const locale: SupportedLocale = 'en';
const seo = {
    title: "Best LEGO gifts for weddings | Brickify",
    description: "The best idea for your wedding: gift a personalized minifigure to every guest. Discover how to create LEGOs that look like your loved ones.",
    canonical: "/blog/best-lego-gifts-for-weddings",
    alternates: [
        {href: "/blog/best-lego-gifts-for-weddings", hrefLang: "x-default"},
        {href: "/blog/best-lego-gifts-for-weddings", hrefLang: "en"},
        {href: "/es/blog/mejores-regalos-lego-para-bodas", hrefLang: "es"},
    ],
};

const ctas = [
    {label: "Sign in to process", href: "/login"},
    {label: "See wedding pricing", href: "/#precio"},
];
---

<Layout content={{title: seo.title}} lang={locale} seo={seo}>
    <Header alternates={seo.alternates} client:only="react"/>
    <main class="relative overflow-x-hidden">
        <article class="py-14 md:py-20 bg-white">
            <div class="container mx-auto px-4 md:px-6  blog-prose">
                <a href="/blog"
                   class="not-prose inline-flex items-center gap-1 text-sm text-neutral-600 hover:underline mb-4">
                    <span aria-hidden="true">←</span>
                    Back
                </a>
                <Breadcrumbs class="mb-4" items={[
                    {label: 'Home', href: '/en'},
                    {label: 'Blog', href: '/blog'},
                    {label: 'Best LEGO gifts for weddings'}
                ]}/>
                <h1 class="!mt-0">Best LEGO gifts for weddings</h1>
                <p class="text-neutral-700">Personalized LEGO®-style minifigures are souvenirs that guests actually
                    keep. The idea that truly makes a difference is creating a minifigure for every guest at your
                    wedding so they feel part of the memory.</p>

                <div class="my-10 max-w-2xl">
                    <img src="/memory-highlight.jpg" alt="Custom LEGO minifigures of wedding guests"
                         class="rounded-2xl shadow-lg w-full h-auto"/>
                    <p class="text-sm text-neutral-500 mt-3 italic">A real photo from my wedding: each LEGO was
                        designed to look like a specific guest, it was an absolute hit!</p>
                </div>

                <h2>A minifigure for every guest</h2>
                <p>At my wedding, we decided that the best gift would be for each guest to have their own personalized
                    minifigure. It wasn't a generic gift; each LEGO looked like the person receiving it.</p>

                <h2>Total personalization</h2>
                <p>The key is to upload a photo of each guest. Our system analyzes the features and suggests the
                    pieces (hair, face, clothes) that best fit their real style.</p>

                <h2>Use them as place cards</h2>
                <p>Place each guest's lookalike minifig at their spot at the table. It becomes an instant
                    conversation starter.</p>

                <h2>The surprise factor</h2>
                <p>Seeing guests' reactions when they find a \"LEGO version\" of themselves is priceless. It's a
                    detail that shows you've thought about each of them individually.</p>

                <h2>Simple process</h2>
                <p>Our system will help you manage the parts list so that assembly is fun and organized.</p>

                <h3>Why choose personalized minifigures?</h3>
                <ul>
                    <li><strong>Unique keepsake:</strong> No one throws away a LEGO that looks like them.</li>
                    <li><strong>Guaranteed conversation:</strong> Guests will compare their figures throughout the
                        dinner.
                    </li>
                    <li><strong>Personal touch:</strong> Reflects the love you have for your friends and family.</li>
                </ul>

                <div class="not-prose mt-10 flex flex-wrap gap-3">
                    {ctas.map((cta) => (
                            <a href={cta.href}
                               class="inline-flex items-center justify-center rounded-full bg-white text-black border border-neutral-200 px-5 py-3 text-sm font-semibold shadow-sm hover:shadow-md transition">
                                {cta.label}
                            </a>
                    ))}
                </div>
            </div>
        </article>

        <FooterSection locale={locale}/>
    </main>
</Layout>
