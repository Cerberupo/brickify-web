---
import MarketingPage from "@/components/marketing/MarketingPage.astro";
import type {SupportedLocale} from "@/lib/locale";

const locale: SupportedLocale = 'en';
const seo = {
    title: "Personalized LEGO gift from your photo | Brickify",
    description: "Turn any photo into a LEGO®-style minifig parts list. Perfect for birthdays, anniversaries and unique gifts. Pay per image with EUR pricing.",
    canonical: "/en/personalized-lego-gift",
    alternates: [
        {href: "/personalized-lego-gift", hrefLang: "x-default"},
        {href: "/es/regalo-lego-personalizado", hrefLang: "es"},
    ],
};

const hero = {
    eyebrow: "Gift a lookalike minifig",
    title: "Personalized LEGO®-style gift from any photo",
    description: "Upload a photo and we send you the exact official parts list to build a minifig that looks like them. Fast, fun, and memorable.",
    ctas: [
        {label: "Sign in to process", href: "/en/login"},
        {label: "See price per image", href: "#precio", variant: "secondary"},
    ],
};

const highlights = [
    {
        title: "Looks like them",
        description: "We match hair, head, torso and legs to resemble the person in your photo."
    },
    {title: "Great for any occasion", description: "Birthdays, anniversaries, graduations, or just because."},
    {title: "Transparent pricing", description: "See EUR price per image and save more when you add photos."},
    {title: "Ready to shop", description: "We include SKUs and backups so you can order parts without delays."},
];

const steps = [
    {title: "Upload a clear photo", description: "Front photo works best; you can add a style reference too."},
    {
        title: "We match official parts",
        description: "Closest hair, head, torso and legs plus 1–2 alternates per piece."
    },
    {title: "Get your shopping list", description: "SKUs and links ready to buy from your preferred store."},
    {title: "Gift and wow them", description: "Assemble and gift a unique minifig that actually looks like them."},
];

const sections = [
    {
        heading: "A memorable gift in under an hour",
        body: "Most lists are ready in under an hour during business hours, so you can prepare last-minute surprises without stress.",
        bullets: [
            {title: "Fast turnaround", description: "Quick delivery of your parts list."},
            {title: "Alternates included", description: "Backups per piece in case stock changes."},
            {
                title: "Not affiliated with LEGO®",
                description: "Independent service using official bricks; LEGO® trademarks belong to The LEGO Group."
            },
        ],
    },
    {
        heading: "Why Brickify for personalized LEGO-style gifts",
        body: "Skip the catalog hunt. We handle matching and availability so you just buy and build.",
        bullets: [
            {title: "Saves hours", description: "No more browsing endless parts; get a ready list."},
            {title: "Looks accurate", description: "Color and expression picked to resemble the photo."},
            {title: "Flexible uses", description: "Great for couples, friends, kids, coworkers and collectors."},
        ],
    },
];
---

<MarketingPage
        locale={locale}
        seo={seo}
        hero={hero}
        highlights={highlights}
        steps={steps}
        sections={sections}
        showPriceCalculator={true}
/> 