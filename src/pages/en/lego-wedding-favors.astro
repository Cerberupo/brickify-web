---
import MarketingPage from "@/components/marketing/MarketingPage.astro";
import type {SupportedLocale} from "@/lib/locale";

const locale: SupportedLocale = 'en';
const seo = {
    title: "LEGO wedding favors: personalized minifigs from photos | Brickify",
    description: "Create wedding favors that look like your guests. Upload photos and get exact LEGO® part lists for personalized minifigs. Volume-friendly pricing.",
    canonical: "/en/lego-wedding-favors",
    alternates: [
        {href: "/lego-wedding-favors", hrefLang: "x-default"},
        {href: "/es/recuerdos-boda-lego-personalizados", hrefLang: "es"},
    ],
};

const hero = {
    eyebrow: "Wedding favors that look like your guests",
    title: "Personalized LEGO®-style wedding favors from guest photos",
    description: "Upload guest photos and get ready-to-shop part lists to build lookalike minifigs. Delight your wedding party with favors they’ll remember.",
    ctas: [
        {label: "Sign in to process", href: "/en/login"},
        {label: "See volume pricing", href: "#precio", variant: "secondary"},
    ],
};

const highlights = [
    {
        title: "Guest lookalikes",
        description: "Hair, head, torso and legs matched to each guest for a true lookalike favor."
    },
    {title: "Volume savings", description: "Price per image drops as you add bridal party and guest photos."},
    {title: "Swap-proof lists", description: "Each key piece includes backups in case stock shifts before you buy."},
    {title: "DIY friendly", description: "We provide SKUs and links; you order where you prefer and assemble easily."},
];

const steps = [
    {title: "Collect photos", description: "Upload clear front photos of your couple, wedding party or guests."},
    {
        title: "We match parts",
        description: "We pick the closest official pieces—hair, heads, torsos and legs—for each person."
    },
    {
        title: "Receive shopping lists",
        description: "Get SKUs plus 1–2 alternates per piece so you can buy without delays."
    },
    {
        title: "Assemble favors",
        description: "Order on your preferred shop, assemble and place them on your tables or gift bags."
    },
];

const sections = [
    {
        heading: "Perfect for table gifts and bridal party surprises",
        body: "Make each guest feel seen with a minifig that actually resembles them. Works great for table settings, welcome kits and thank-you gifts.",
        bullets: [
            {title: "Table place cards", description: "Use custom minifigs as place markers guests will keep."},
            {
                title: "Bridal party kits",
                description: "Create lookalike figures for bridesmaids, groomsmen and family."
            },
            {title: "Destination weddings", description: "Easy to pack; order parts near your venue if needed."},
        ],
    },
    {
        heading: "Clear pricing, fast turnaround",
        body: "See your per-image price before paying. Usually ready in under an hour (24/7 service), so you can move fast on favors.",
        bullets: [
            {title: "Transparent cost", description: "Know the per-image rate and total before checkout."},
            {title: "Ready in minutes", description: "Upload today, get your lists quickly and start ordering."},
            {
                title: "Not affiliated with LEGO®",
                description: "Independent service using official bricks; LEGO® trademarks belong to The LEGO Group."
            },
        ],
    },
];
---

<MarketingPage
        locale={locale}
        seo={seo}
        hero={hero}
        highlights={highlights}
        steps={steps}
        sections={sections}
        showPriceCalculator={true}
/> 