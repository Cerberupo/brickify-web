---
import MarketingPage from "@/components/marketing/MarketingPage.astro";
import type {SupportedLocale} from "@/lib/locale";

const locale: SupportedLocale = 'en';
const seo = {
    title: "Custom LEGO minifigure from your photo | Brickify",
    description: "Upload a photo and get the exact official LEGO® parts list that best matches your minifigure. Save hours searching and buy only the pieces you need.",
    canonical: "/en/custom-lego-minifigure-photo",
    alternates: [
        {href: "/custom-lego-minifigure-photo", hrefLang: "x-default"},
        {href: "/es/minifig-lego-personalizada-foto", hrefLang: "es"},
    ],
};

const hero = {
    eyebrow: "From photo to parts list",
    title: "Turn your photo into a LEGO®-style minifigure in minutes",
    description: "Upload your picture and receive a curated list of official bricks that look the most like you. We do the matching, you keep the fun.",
    ctas: [
        {label: "Sign in to process", href: "/en/login"},
        {label: "See price per image", href: "#precio", variant: "secondary"},
    ],
};

const highlights = [
    {
        title: "Official part references",
        description: "We search the closest official pieces so you can buy confidently on LEGO® Pick a Brick or your favorite store.",
    },
    {
        title: "Photo-matching service",
        description: "Simply upload your photo; our matching flow suggests hair, head, torso and legs that look like you.",
    },
    {
        title: "Save hours of browsing",
        description: "No more scrolling catalogs. Get a ready-to-shop list plus alternatives when stock changes.",
    },
    {
        title: "Volume-friendly pricing",
        description: "Order for friends, weddings or teams and see how the price per image drops as you add more.",
    },
];

const steps = [
    {
        title: "Upload your photo",
        description: "Add a clear front photo. You can also share a reference LEGO® style you like."
    },
    {
        title: "We match the pieces",
        description: "Our flow picks the closest hair, head, torso and legs based on your look."
    },
    {
        title: "Get the parts list",
        description: "Receive SKUs and links to buy only what you need—plus 1-2 backups per piece."
    },
    {
        title: "Build your minifig",
        description: "Place your order on your preferred shop and assemble. Perfect for gifts and events."
    },
];

const sections = [
    {
        heading: "Why Brickify instead of searching yourself?",
        body: "Catalogs are huge and stock shifts daily. We track updated part availability and give you the closest match fast, so you don’t waste time hunting colors or faces that look off.",
        bullets: [
            {title: "Fast turnaround", description: "Usually ready in under an hour (24/7 service)."},
            {
                title: "Clear alternatives",
                description: "Each key piece includes an alternate in case the main SKU goes out of stock."
            },
            {
                title: "Budget friendly",
                description: "See the per-image price before paying and save more when ordering multiple photos."
            },
            {
                title: "Not affiliated with LEGO®",
                description: "Independent service using official bricks; LEGO® trademarks belong to The LEGO Group."
            },
        ],
    },
    {
        heading: "Great for gifts, weddings and teams",
        body: "Personalize guest favors, corporate swag or birthday gifts with minifigs that actually look like your people. Upload several photos and watch the unit price drop.",
        bullets: [
            {title: "Weddings", description: "Create lookalike favors for your wedding party or guests."},
            {title: "Corporate", description: "Delight teams or event attendees with branded, lookalike minifigs."},
            {title: "Personal gifts", description: "One-off gifts for birthdays, anniversaries or just because."},
        ],
    },
];
---

<MarketingPage
        locale={locale}
        seo={seo}
        hero={hero}
        highlights={highlights}
        steps={steps}
        sections={sections}
        showPriceCalculator={true}
/> 