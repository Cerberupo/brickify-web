---
import MarketingPage from "@/components/marketing/MarketingPage.astro";
import type {SupportedLocale} from "@/lib/locale";

const locale: SupportedLocale = 'en';
const seo = {
    title: "Corporate LEGO gifts: lookalike minifigs from team photos | Brickify",
    description: "Upload employee or attendee photos and get exact LEGO® part lists to build lookalike minifigs. Perfect for corporate gifts, events and onboarding kits.",
    canonical: "/en/corporate-lego-gifts",
    alternates: [
        {href: "/corporate-lego-gifts", hrefLang: "x-default"},
        {href: "/es/regalos-empresa-lego-personalizados", hrefLang: "es"},
    ],
};

const hero = {
    eyebrow: "Corporate gifts that look like your team",
    title: "Personalized LEGO®-style minifigs for employees, clients and events",
    description: "Upload team or attendee photos and we deliver shopping lists with the closest official bricks. Give memorable swag that actually looks like your people.",
    ctas: [
        {label: "Sign in to process", href: "/en/login"},
        {label: "See price per image", href: "#precio", variant: "secondary"},
    ],
};

const highlights = [
    {
        title: "Lookalike minifigs",
        description: "Hair, head, torso and legs matched to each person so gifts feel personal."
    },
    {title: "Great for events", description: "Use for conferences, brand activations, meetups or community rewards."},
    {title: "Volume-friendly", description: "Per-image price decreases as you upload more employees or attendees."},
    {
        title: "Order anywhere",
        description: "We provide SKUs and backups; you buy where you prefer and assemble quickly."
    },
];

const steps = [
    {title: "Upload photos", description: "Add clear front photos for employees, customers or attendees."},
    {
        title: "We match parts",
        description: "We pick the closest official bricks and include alternates for stock changes."
    },
    {title: "Get the part lists", description: "Receive SKUs and links so your team can purchase fast in EUR pricing."},
    {
        title: "Ship memorable swag",
        description: "Assemble and include the minifigs in kits, event bags or client mailers."
    },
];

const sections = [
    {
        heading: "Use cases that teams love",
        body: "Welcome kits, conference swag, team offsites and community rewards stand out when the minifig actually looks like the recipient.",
        bullets: [
            {title: "Onboarding kits", description: "Add a lookalike minifig to new hire boxes."},
            {
                title: "Event giveaways",
                description: "Delight attendees with personalized figures they’ll keep on their desk."
            },
            {title: "Client gifts", description: "Send a memorable, custom gift to top customers."},
        ],
    },
    {
        heading: "Fast turnaround, clear pricing",
        body: "Usually ready in under an hour (24/7 service). See per-image pricing up front; pay in EUR for now.",
        bullets: [
            {title: "Transparent cost", description: "Know your per-image rate before uploading more photos."},
            {title: "Stock-safe lists", description: "Every key piece includes 1–2 backups to avoid delays."},
            {
                title: "Not affiliated with LEGO®",
                description: "Independent service using official bricks; LEGO® trademarks belong to The LEGO Group."
            },
        ],
    },
];
---

<MarketingPage
        locale={locale}
        seo={seo}
        hero={hero}
        highlights={highlights}
        steps={steps}
        sections={sections}
        showPriceCalculator={true}
/> 