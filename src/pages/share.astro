---
import MainLayout from "@/layouts/main.astro";
import {Header} from "@/layouts/components/Header";
import PublicShareView from "@/components/pages/public/PublicShareView";
import FooterSection from "@/components/home/FooterSection.astro";
import TryPieceCta from "@/components/common/TryPieceCta.astro";
import {normalizeLocale} from "@/lib/locale";
import type {SupportedLocale} from "@/lib/locale";

const locale: SupportedLocale = normalizeLocale(Astro.currentLocale as string | undefined);
const isEs = locale === 'es';

// SEO estático según idioma (OG/Twitter)
const seo = isEs ? {
    title: 'Ver las piezas compartidas',
    description: 'Accede para ver las piezas compartidas de este grupo de Brickify. Abre el enlace para ver los artículos y detalles.',
    canonical: '/es/share',
    alternates: [
        {href: '/es/share', hrefLang: 'es'},
        {href: '/en/share', hrefLang: 'en'},
    ],
    ogImage: '/search-result-brand.jpg',
    ogAlt: 'Logo de Brickify',
} : {
    title: 'View the shared pieces',
    description: 'Access to view the shared pieces for this Brickify group. Open the link to see the items and details.',
    canonical: '/en/share',
    alternates: [
        {href: '/es/share', hrefLang: 'es'},
        {href: '/en/share', hrefLang: 'en'},
    ],
    ogImage: '/search-result-brand.jpg',
    ogAlt: 'Brickify logo',
};
---

<MainLayout seo={seo}>
    <Header alternates={seo.alternates} client:only="react"/>
    <PublicShareView client:load locale={locale}/>
    <div class="container mx-auto px-4 md:px-6 mb-10 md:mb-14">
        <TryPieceCta locale={locale}/>
    </div>
    <div class="w-full -mt-10">
        <FooterSection locale={locale}/>
    </div>
</MainLayout>