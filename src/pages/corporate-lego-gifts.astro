---
import MarketingPage from "@/components/marketing/MarketingPage.astro";
import type {SupportedLocale} from "@/lib/locale";

const locale: SupportedLocale = 'en';
const seo = {
    title: "Corporate LEGO gifts: lookalike minifigs from team photos | Brickify",
    description: "Upload team or attendee photos, we match the closest official LEGO® parts with backups, and you deliver memorable swag that actually looks like your people. Pricing that improves with volume.",
    canonical: "/corporate-lego-gifts",
    alternates: [
        {href: "/en/corporate-lego-gifts", hrefLang: "en"},
        {href: "/es/regalos-empresa-lego-personalizados", hrefLang: "es"},
    ],
};

const hero = {
    eyebrow: "Corporate gifts that resemble your team",
    title: "Personalized LEGO®-style minifigs for employees, clients and events",
    description: "Drop team or attendee photos, we pick the closest official bricks (hair, head, torso, legs) and send ready-to-shop lists with alternates for stock shifts.",
    ctas: [
        {label: "Sign in to process", href: "/login"},
        {label: "See price per image", href: "#precio", variant: "secondary"},
    ],
};

const highlights = [
    {
        title: "Lookalike swag",
        description: "Hair, head, torso and legs chosen to resemble each person, with SKUs and buy links."
    },
    {title: "Event-ready", description: "Ideal for conferences, activations, meetups or community rewards."},
    {title: "Volume pricing", description: "Per-image price drops as you add more employees or attendees."},
    {
        title: "Stock-safe lists",
        description: "Alternates per key piece so procurement never stalls."
    },
];

const steps = [
    {title: "Upload team photos", description: "Front-facing is best; add notes on outfits or accessories."},
    {
        title: "We match official parts",
        description: "Closest hair, heads, torsos and legs plus backups for stock shifts."
    },
    {
        title: "Approve and buy",
        description: "SKUs and links so you purchase only what you need with EUR pricing up front."
    },
    {
        title: "Deliver memorable swag",
        description: "Assemble and add to onboarding kits, event bags or client mailers."
    },
];

const sections = [
    {
        heading: "Use cases teams remember",
        body: "Onboarding kits, conference swag, offsites and client gifts stand out when the minifig actually looks like the recipient.",
        bullets: [
            {title: "Onboarding", description: "Add lookalike minifigs to new hire boxes."},
            {title: "Events", description: "Delight attendees with personalized figures for their desk."},
            {title: "Clients", description: "Send a custom, memorable gift to top customers."},
        ],
    },
    {
        heading: "Fast delivery, predictable cost",
        body: "Usually ready in under an hour (24/7 service). EUR per-image pricing is clear, and backups per piece keep procurement moving even if stock shifts.",
        bullets: [
            {title: "Transparent pricing", description: "See per-image rate and total before you commit."},
            {title: "Backups included", description: "Alternates per key piece to avoid delays."},
            {
                title: "Independent service",
                description: "Not affiliated with LEGO®; we use official bricks responsibly."
            },
        ],
    },
];
---

<MarketingPage
        locale={locale}
        seo={seo}
        hero={hero}
        highlights={highlights}
        steps={steps}
        sections={sections}
        showPriceCalculator={true}
/> 