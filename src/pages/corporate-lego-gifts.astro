---
import MarketingPage from "@/components/marketing/MarketingPage.astro";
import type {SupportedLocale} from "@/lib/locale";

const locale: SupportedLocale = 'en';
const seo = {
    title: "Personalized Corporate LEGO® Gifts from Photos | Brickify",
    description: "Create memorable corporate gifts with custom LEGO®-style minifigures of your team. Upload photos and get AI-matched official parts lists for employees and events.",
    canonical: "/corporate-lego-gifts",
    alternates: [
        {href: "/corporate-lego-gifts", hrefLang: "x-default"},
        {href: "/corporate-lego-gifts", hrefLang: "en"},
        {href: "/es/regalos-empresa-lego-personalizados", hrefLang: "es"},
    ],
    structuredData: {
        webpage: true,
        breadcrumb: [
            {name: "Home", url: "/en"},
            {name: "Corporate Gifts", url: "/corporate-lego-gifts"},
        ]
    }
};

const hero = {
    eyebrow: "Corporate gifts that look like your team",
    title: "Personalized LEGO®-style minifigs for employees, clients, and events",
    description: "Upload photos of your team or attendees and we provide shopping lists with the closest official parts. Memorable gifts that actually look like them.",
    ctas: [
        {label: "Sign in to process", href: "/login"},
        {label: "See pricing", href: "/#precio", variant: "secondary"},
    ],
};

const highlights = [
    {title: "Lookalike minifigs", description: "Hair, head, torso, and legs that look like each person."},
    {
        title: "Perfect for events",
        description: "Use them in conferences, brand activations, or community rewards."
    },
    {title: "Volume savings", description: "The price per image drops as you upload more employees or attendees."},
    {
        title: "Buy where you want",
        description: "We give you SKUs and alternates; buy where you prefer and assemble quickly."
    },
];

const steps = [
    {title: "Upload photos", description: "Add front-facing photos of employees, clients, or attendees."},
    {
        title: "We do the matching",
        description: "We pick the closest official pieces and include alternatives for stock shifts."
    },
    {title: "Receive the lists", description: "SKUs and links for fast shopping."},
    {
        title: "Send the swag",
        description: "Assemble and add the minifigs to kits, event bags, or client mailings."
    },
];

const sections = [
    {
        heading: "Use cases that work",
        body: "Welcome kits, conferences, offsites, and rewards stand out more when the minifig looks like the recipient.",
        bullets: [
            {title: "Onboarding", description: "Include a lookalike minifig in welcome boxes."},
            {
                title: "Events",
                description: "Surprise attendees with personalized figures for their desks."
            },
            {title: "Clients", description: "Send a memorable gift to key customers."},
        ],
    },
    {
        heading: "Fast delivery and clear pricing",
        body: "Most lists are ready in less than a minute per person.",
        bullets: [
            {title: "Transparent cost", description: "Know the rate per image before uploading more photos."},
            {
                title: "Stock-safe lists",
                description: "Each key piece includes 1–2 alternatives to avoid delays."
            },
            {
                title: "No LEGO® affiliation",
                description: "Independent service using official parts; LEGO® is a trademark of the LEGO Group."
            },
        ],
    },
];
---

<MarketingPage
        locale={locale}
        seo={seo}
        hero={hero}
        highlights={highlights}
        steps={steps}
        sections={sections}
        showPriceCalculator={true}
/> 