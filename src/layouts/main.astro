---
import '../styles/global.css';
import 'sonner/dist/styles.css';
import {ClientRouter} from "astro:transitions";
import {PROJECT_NAME} from "../config";
import { normalizeLocale } from "@/lib/locale";

let {content, lang} = Astro.props as { content?: { title?: string }, lang?: 'en' | 'es' };
if (!content || !content.title) {
    content = {title: PROJECT_NAME};
}
// Prefer explicit lang prop; otherwise derive from URL path; finally fall back to Astro.currentLocale
const path = Astro.url?.pathname || '/';
const pathLang = path.startsWith('/es') ? 'es' : (path.startsWith('/en') ? 'en' : undefined);
const htmlLang = (lang ?? pathLang ?? normalizeLocale(Astro.currentLocale as string | undefined));
---

<html lang={htmlLang}>
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width"/>
    <link rel="icon" type="image/png" href="/favicon.png"/>
    <meta name="generator" content={Astro.generator}/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wdth,wght@75..125,300..700&display=swap"
          rel="stylesheet">
    <title>{content?.title}</title>
    <ClientRouter/>
</head>
<body class="min-h-screen flex flex-col">


<slot/>

</body>
</html>
