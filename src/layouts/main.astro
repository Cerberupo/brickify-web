---
import '../styles/global.css';
import '../styles/blog.css';
import 'sonner/dist/styles.css';
import {PROJECT_NAME} from "../config";
import {normalizeLocale} from "@/lib/locale";
import CookieBanner from "@/components/cookies/CookieBanner.astro";

type Lang = 'en' | 'es';

interface SeoProps {
    title?: string;
    description?: string;
    canonical?: string; // absolute or relative
    alternates?: Array<{ href: string; hrefLang: string }>;
    ogImage?: string; // path or absolute URL
    ogAlt?: string;
    robots?: string; // e.g., "index,follow"
    noindex?: boolean;
    keywords?: string;
    themeColor?: string;
    manifest?: string;
    localeAlternate?: string;
    structuredData?: {
        organization?: boolean;
        website?: boolean;
        webpage?: boolean;
        breadcrumb?: Array<{ name: string; url: string }>;
    };
}

let {content, lang, seo} = Astro.props as {
    content?: { title?: string };
    lang?: Lang;
    seo?: SeoProps;
};

if (!content || !content.title) {
    content = {title: PROJECT_NAME};
}

// Prefer explicit lang prop; otherwise derive from URL path; finally fall back to Astro.currentLocale
const path = Astro.url?.pathname || '/';
const origin = Astro.url?.origin || '';
// Base absoluto para construir URLs en metatags (evita "localhost" en build estático)
const baseOrigin = (import.meta.env.PUBLIC_SITE_URL as string | undefined) || origin || '';
const pathLang = path.startsWith('/es') ? 'es' : (path.startsWith('/en') ? 'en' : undefined);
const htmlLang = (lang ?? pathLang ?? normalizeLocale(Astro.currentLocale as string | undefined));

// Compute URLs
const pageTitle = seo?.title ?? content?.title ?? PROJECT_NAME;
const currentUrl = `${baseOrigin}${path}`;
const canonicalUrl = seo?.canonical
    ? (seo.canonical.startsWith('http') ? seo.canonical : `${baseOrigin}${seo.canonical}`)
    : currentUrl;
const ogImageUrl = seo?.ogImage
    ? (seo.ogImage.startsWith('http') ? seo.ogImage : `${baseOrigin}${seo.ogImage}`)
    : `${baseOrigin}/social-logo.jpg`;
const robotsContent = seo?.noindex ? 'noindex,nofollow' : (seo?.robots ?? 'index,follow');
const themeColor = seo?.themeColor ?? '#F3EFE6';
const manifestHref = seo?.manifest ?? '/site.webmanifest';
const localeAlternate = seo?.localeAlternate;

// Google Analytics: la lógica y carga del tag se ha movido a CookieBanner.astro
// Mantenemos solo el cálculo de appEnv para el flag de debug
const appEnv = (import.meta.env.PUBLIC_APP_ENV as string | undefined) || (import.meta.env.PROD ? 'prod' : 'dev');
---

<html lang={htmlLang}>
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="theme-color" content={themeColor}/>
    <link rel="icon" type="image/png" href="/favicon.png"/>
    <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
    <link rel="manifest" href={manifestHref}/>
    <meta name="generator" content={Astro.generator}/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
            rel="preload"
            href="https://fonts.googleapis.com/css2?family=Fredoka:wdth,wght@75..125,300..700&display=swap"
            as="style"
            onload="this.onload=null;this.rel='stylesheet'"
    >
    <noscript>
        <link href="https://fonts.googleapis.com/css2?family=Fredoka:wdth,wght@75..125,300..700&display=swap"
              rel="stylesheet">
    </noscript>
    <title>{pageTitle}</title>
    {seo?.description && (
            <meta name="description" content={seo.description}/>)}
    {seo?.keywords && (
            <meta name="keywords" content={seo.keywords}/>)}
    <meta name="robots" content={robotsContent}/>
    <link rel="canonical" href={canonicalUrl}/>
    {seo?.alternates && seo.alternates.map(a => (
            <link rel="alternate" hrefLang={a.hrefLang}
                  href={a.href.startsWith('http') ? a.href : `${baseOrigin}${a.href}`}/>
    ))}
    {localeAlternate && (
            <link rel="alternate" hrefLang={htmlLang === 'es' ? 'en' : 'es'}
                  href={localeAlternate.startsWith('http') ? localeAlternate : `${baseOrigin}${localeAlternate}`}/>
    )}

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle}/>
    {seo?.description && (
            <meta property="og:description" content={seo.description}/>)}
    <meta property="og:type" content="website"/>
    <meta property="og:url" content={canonicalUrl}/>
    <meta property="og:image" content={ogImageUrl}/>
    <meta property="og:site_name" content={PROJECT_NAME}/>
    <meta property="og:locale" content={htmlLang === 'es' ? 'es_ES' : 'en_US'}/>
    {seo?.ogAlt && (
            <meta property="og:image:alt" content={seo.ogAlt}/>)}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image"/>
    <meta name="twitter:title" content={pageTitle}/>
    {seo?.description && (
            <meta name="twitter:description" content={seo.description}/>)}
    <meta name="twitter:image" content={ogImageUrl}/>
    {seo?.ogAlt && (
            <meta name="twitter:image:alt" content={seo.ogAlt}/>)}

    <!-- Structured Data -->
    {seo?.structuredData?.organization && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "Organization",
            "name": PROJECT_NAME,
            "url": baseOrigin || "/",
            "logo": `${baseOrigin}/favicon.png`,
            "sameAs": [
                "https://x.com/BrickifyFun",
                "https://www.tiktok.com/@brickifyfun",
                "https://instagram.com/brickifyfun"
            ]
        })}/>
    )}
    {seo?.structuredData?.website && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "WebSite",
            "name": PROJECT_NAME,
            "url": baseOrigin || "/",
            "inLanguage": htmlLang
        })}/>
    )}
    {seo?.structuredData?.breadcrumb && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            "itemListElement": seo.structuredData.breadcrumb.map((b, i) => ({
                "@type": "ListItem",
                "position": i + 1,
                "name": b.name,
                "item": b.url.startsWith('http') ? b.url : `${baseOrigin}${b.url}`
            }))
        })}/>
    )}
    {seo?.structuredData?.webpage && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "WebPage",
            "name": pageTitle,
            "description": seo?.description,
            "url": currentUrl,
            "inLanguage": htmlLang,
            "isPartOf": {
                "@type": "WebSite",
                "url": baseOrigin || "/",
                "name": PROJECT_NAME,
                "inLanguage": htmlLang
            }
        })}/>
    )}

    <!-- Flag de depuración para banner/cookies (solo dev) -->
    <script define:vars={{appEnv}}>
        (function () {
            try {
                // Activa logs de debug en entornos no prod
                window['__DBG_COOKIES'] = (appEnv !== 'prod');
                if (window['__DBG_COOKIES']) {
                    console.log('[cookies] Debug ENABLED', {appEnv});
                }
            } catch (e) {
            }
        })();
    </script>

    <!-- Google Analytics se carga/controla desde CookieBanner.astro -->
</head>
<body class="min-h-screen flex flex-col">


<slot/>

<!-- Banner de cookies (muestra y gestiona consentimiento para Analytics) -->
<CookieBanner locale={htmlLang as any}/>

</body>
</html>
