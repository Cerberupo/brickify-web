---
import '../styles/global.css';
import 'sonner/dist/styles.css';
import {ClientRouter} from "astro:transitions";
import {PROJECT_NAME} from "../config";
import {normalizeLocale} from "@/lib/locale";
import CookieBanner from "@/components/cookies/CookieBanner.astro";

type Lang = 'en' | 'es';

interface SeoProps {
    title?: string;
    description?: string;
    canonical?: string; // absolute or relative
    alternates?: Array<{ href: string; hrefLang: string }>;
    ogImage?: string; // path or absolute URL
    ogAlt?: string;
    robots?: string; // e.g., "index,follow"
    noindex?: boolean;
    keywords?: string;
    themeColor?: string;
    manifest?: string;
    localeAlternate?: string;
    structuredData?: {
        organization?: boolean;
        website?: boolean;
        webpage?: boolean;
        breadcrumb?: Array<{ name: string; url: string }>;
    };
}

let {content, lang, seo} = Astro.props as {
    content?: { title?: string };
    lang?: Lang;
    seo?: SeoProps;
};

if (!content || !content.title) {
    content = {title: PROJECT_NAME};
}

// Prefer explicit lang prop; otherwise derive from URL path; finally fall back to Astro.currentLocale
const path = Astro.url?.pathname || '/';
const origin = Astro.url?.origin || '';
// Base absoluto para construir URLs en metatags (evita "localhost" en build estático)
const baseOrigin = (import.meta.env.PUBLIC_SITE_URL as string | undefined) || origin || '';
const pathLang = path.startsWith('/es') ? 'es' : (path.startsWith('/en') ? 'en' : undefined);
const htmlLang = (lang ?? pathLang ?? normalizeLocale(Astro.currentLocale as string | undefined));

// Compute URLs
const pageTitle = seo?.title ?? content?.title ?? PROJECT_NAME;
const currentUrl = `${baseOrigin}${path}`;
const canonicalUrl = seo?.canonical
    ? (seo.canonical.startsWith('http') ? seo.canonical : `${baseOrigin}${seo.canonical}`)
    : currentUrl;
const ogImageUrl = seo?.ogImage
    ? (seo.ogImage.startsWith('http') ? seo.ogImage : `${baseOrigin}${seo.ogImage}`)
    : `${baseOrigin}/logo.png`;
const robotsContent = seo?.noindex ? 'noindex,nofollow' : (seo?.robots ?? 'index,follow');
const themeColor = seo?.themeColor ?? '#F3EFE6';
const manifestHref = seo?.manifest ?? '/site.webmanifest';
const localeAlternate = seo?.localeAlternate;

// Google Analytics IDs por entorno
// Nota: `import.meta.env.PROD` será true en builds de preview y prod.
// Para distinguir despliegues "dev" y "prod" usamos PUBLIC_APP_ENV (inyectado por el workflow).
const appEnv = (import.meta.env.PUBLIC_APP_ENV as string | undefined) || (import.meta.env.PROD ? 'prod' : 'dev');
const GA_ID_PROD = 'G-NMHZPGD0CP';
const GA_ID_DEV = 'G-DPDNGB0EKZ';
const GA_ID = appEnv === 'prod' ? GA_ID_PROD : GA_ID_DEV;
---

<html lang={htmlLang}>
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="theme-color" content={themeColor}/>
    <link rel="icon" type="image/png" href="/favicon.png"/>
    <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
    <link rel="manifest" href={manifestHref}/>
    <meta name="generator" content={Astro.generator}/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
            rel="preload"
            href="https://fonts.googleapis.com/css2?family=Fredoka:wdth,wght@75..125,300..700&display=swap"
            as="style"
            onload="this.onload=null;this.rel='stylesheet'"
    >
    <noscript>
        <link href="https://fonts.googleapis.com/css2?family=Fredoka:wdth,wght@75..125,300..700&display=swap"
              rel="stylesheet">
    </noscript>
    <title>{pageTitle}</title>
    {seo?.description && (
            <meta name="description" content={seo.description}/>)}
    {seo?.keywords && (
            <meta name="keywords" content={seo.keywords}/>)}
    <meta name="robots" content={robotsContent}/>
    <link rel="canonical" href={canonicalUrl}/>
    {seo?.alternates && seo.alternates.map(a => (
            <link rel="alternate" hrefLang={a.hrefLang}
                  href={a.href.startsWith('http') ? a.href : `${baseOrigin}${a.href}`}/>
    ))}
    {localeAlternate && (
            <link rel="alternate" hrefLang={htmlLang === 'es' ? 'en' : 'es'}
                  href={localeAlternate.startsWith('http') ? localeAlternate : `${baseOrigin}${localeAlternate}`}/>
    )}

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle}/>
    {seo?.description && (
            <meta property="og:description" content={seo.description}/>)}
    <meta property="og:type" content="website"/>
    <meta property="og:url" content={canonicalUrl}/>
    <meta property="og:image" content={ogImageUrl}/>
    <meta property="og:site_name" content={PROJECT_NAME}/>
    <meta property="og:locale" content={htmlLang === 'es' ? 'es_ES' : 'en_US'}/>

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image"/>
    <meta name="twitter:title" content={pageTitle}/>
    {seo?.description && (
            <meta name="twitter:description" content={seo.description}/>)}
    <meta name="twitter:image" content={ogImageUrl}/>
    {seo?.ogAlt && (
            <meta name="twitter:image:alt" content={seo.ogAlt}/>)}

    {seo?.structuredData?.organization && (
        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "Organization",
            name: PROJECT_NAME,
            url: baseOrigin || "/",
            logo: `${baseOrigin}/logo.png`,
            sameAs: [
                "https://x.com/BrickifyFun",
                "https://www.tiktok.com/@brickify.fun"
            ]
        })} />
    )}
    {seo?.structuredData?.website && (
        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "WebSite",
            name: PROJECT_NAME,
            url: baseOrigin || "/",
            inLanguage: htmlLang,
            potentialAction: {
                "@type": "SearchAction",
                target: `${baseOrigin}/?q={search_term_string}`,
                "query-input": "required name=search_term_string"
            }
        })} />
    )}
    {seo?.structuredData?.webpage && (
        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "WebPage",
            name: pageTitle,
            url: canonicalUrl,
            inLanguage: htmlLang,
            description: seo?.description,
            isPartOf: {
                "@type": "WebSite",
                url: baseOrigin || "/",
                name: PROJECT_NAME,
                inLanguage: htmlLang
            }
        })} />
    )}
    {seo?.structuredData?.breadcrumb && seo.structuredData.breadcrumb.length > 0 && (
        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            itemListElement: seo.structuredData.breadcrumb.map((item, index) => ({
                "@type": "ListItem",
                position: index + 1,
                name: item.name,
                item: item.url.startsWith('http') ? item.url : `${origin}${item.url}`
            }))
        })} />
    )}

    <!-- Google Analytics con Consent Mode básico: cargar siempre con consentimiento denegado por defecto -->
    <script define:vars={{GA_ID}}>
        (function () {
            try {
                var KEY = 'brickify.cookies.analytics';
                // dataLayer y gtag disponibles de inmediato (antes de cargar la librería)
                window.dataLayer = window.dataLayer || [];
                window.gtag = window.gtag || function () {
                    window.dataLayer.push(arguments);
                };
                // Estado de consentimiento por defecto: todo denegado
                window.gtag('consent', 'default', {
                    ad_user_data: 'denied',
                    ad_personalization: 'denied',
                    ad_storage: 'denied',
                    analytics_storage: 'denied',
                    wait_for_update: 500
                });

                // Cargar la librería de gtag siempre (no envía cookies si analytics_storage está "denied")
                var s = document.createElement('script');
                s.async = true;
                s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
                document.head.appendChild(s);

                // Inicialización base (sin cookies hasta que haya consentimiento)
                window.gtag('js', new Date());
                window.gtag('config', GA_ID, {anonymize_ip: true});

                // Si ya existía consentimiento concedido, actualizar inmediatamente
                try {
                    var pref = localStorage.getItem(KEY);
                    if (pref === 'granted') {
                        window.gtag('consent', 'update', {
                            ad_user_data: 'granted',
                            ad_personalization: 'granted',
                            ad_storage: 'granted',
                            analytics_storage: 'granted'
                        });
                    }
                } catch (e) { /* noop */
                }

                // Pageview en navegaciones (funciona una vez concedido el consentimiento)
                window.addEventListener('astro:page-load', function () {
                    try {
                        if (typeof window.gtag === 'function') {
                            window.gtag('config', GA_ID, {page_path: location.pathname, anonymize_ip: true});
                        }
                    } catch (e) { /* noop */
                    }
                });
            } catch (e) { /* noop */
            }
        })();
    </script>

    <!-- API global temprana para abrir el banner de cookies desde cualquier página/botón -->
    <script>
        (function () {
            try {
                // Espacio de nombres global
                window.Brickify = window.Brickify || {};
                // API idempotente: marca intención y emite evento para que el banner activo lo atienda
                window.Brickify.openCookieBanner = window.Brickify.openCookieBanner || function () {
                    try {
                        window.__brickifyOpenCookieBannerRequested = true;
                        window.dispatchEvent(new CustomEvent('brickify:open-cookie-banner'));
                    } catch (e) { /* noop */
                    }
                };

                // Delegado para data-atributo: cualquier elemento con [data-open-cookie-banner]
                // abrirá el banner sin depender del orden de carga de scripts/componentes.
                if (!window.__brickifyOpenCookieBannerClickBound) {
                    window.__brickifyOpenCookieBannerClickBound = true;
                    document.addEventListener('click', function (ev) {
                        try {
                            var el = ev.target as HTMLElement | null;
                            if (!el) return;
                            // Caminar el árbol hasta encontrar un elemento con el data-atributo
                            while (el && el !== document.documentElement) {
                                if (el.hasAttribute && el.hasAttribute('data-open-cookie-banner')) {
                                    if (typeof window.Brickify.openCookieBanner === 'function') {
                                        window.Brickify.openCookieBanner();
                                    }
                                    break;
                                }
                                el = el.parentElement as HTMLElement | null;
                            }
                        } catch (e) { /* noop */
                        }
                    }, true);
                }
            } catch (e) { /* noop */
            }
        })();
    </script>
    <!-- Garantiza que el banner permanezca visible entre navegaciones si no hay preferencia (Astro Transitions) -->
    <script>
        (function () {
            try {
                var KEY = 'brickify.cookies.analytics';

                function ensureBannerIfNeeded() {
                    try {
                        var pref = null;
                        try {
                            pref = localStorage.getItem(KEY);
                        } catch (e) {
                        }
                        if (pref === 'granted' || pref === 'denied') return;
                        // Si no hay preferencia, asegúrate de que el banner esté visible
                        if (window.Brickify && typeof window.Brickify.openCookieBanner === 'function') {
                            // Usamos la API global que además despacha el evento para que el banner activo responda
                            window.Brickify.openCookieBanner();
                        } else {
                            // Fallback defensivo: mostrar el contenedor si existe
                            var el = document.getElementById('cookie-banner');
                            if (el) el.style.display = '';
                        }
                    } catch (e) { /* noop */
                    }
                }

                // En la carga inicial y en cada navegación de Astro Transitions
                if (!window.__brickifyCookieBannerPageLoadBound) {
                    window.__brickifyCookieBannerPageLoadBound = true;
                    window.addEventListener('astro:page-load', ensureBannerIfNeeded);
                }
                // Primera ejecución por si el componente fue reinyectado con display:none
                ensureBannerIfNeeded();
            } catch (e) { /* noop */
            }
        })();
    </script>
    <ClientRouter/>
</head>
<body class="min-h-screen flex flex-col">


<slot/>

<!-- Banner de cookies (muestra y gestiona consentimiento para Analytics) -->
<CookieBanner locale={htmlLang as any}/>

</body>
</html>
