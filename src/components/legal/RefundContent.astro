---
import type {SupportedLocale} from "@/lib/locale";

interface Props {
    locale: SupportedLocale;
}
const {locale} = Astro.props as Props;

const copies = {
    es: {
        heroTitle: "Política de Reembolso",
        lastUpdated: "Última Actualización: 13 de enero de 2026",
        intro: "Comprendemos que las compras no siempre salen como se planean. Si se arrepiente de una compra o la hace sin querer, es posible que pueda obtener un reembolso. A continuación, hemos establecido algunas reglas de lo que se puede devolver y lo que no, además de otra información relacionada.",
        sections: [
            {
                t: "Lo que se puede devolver y lo que no",
                d: "Reembolsaremos cualquier contenido no usado de la lista siguiente de productos \"reembolsables\" que se hayan adquirido en los últimos 14 días, salvo que la legislación aplicable exija lo contrario. Una vez que hayamos emitido un reembolso, el contenido afectado se eliminará de su cuenta.",
                list: [
                    {label: "Divisa prémium (Créditos no usados)", status: "yes"},
                    {label: "Contenido digital no utilizado", status: "yes"},
                    {label: "Contenido ya utilizado o procesado", status: "no"},
                    {label: "Packs de promoción", status: "no"},
                    {label: "Regalos enviados o recibidos", status: "no"}
                ]
            },
            {
                t: "Reglas Adicionales con Respecto a los Reembolsos de Dinero Real",
                d: "Si utiliza dinero real para adquirir Divisa del Juego (Créditos) y no la gasta, puede solicitar un reembolso a nuestro equipo de soporte durante los primeros 14 días de la compra. Los reembolsos se emitirán solo al método de pago original."
            },
            {
                t: "Anulaciones de Transacciones",
                d: "Con el fin de combatir posibles fraudes, una vez que se anule una transacción relacionada con una cuenta, dicha cuenta podrá ser suspendida. Los jugadores podrán volver a tener acceso a su cuenta tras contactar con soporte y regularizar el pago."
            }
        ],
        howTo: {
            t: "¿Cómo obtener mi reembolso?",
            d: "Para solicitar un reembolso, debe ponerse en contacto con nuestro equipo de Soporte en contact@brickify.fun indicando los detalles de la transacción. El proceso puede tardar varios días laborables en completarse."
        }
    },
    en: {
        heroTitle: "Refund Policy",
        lastUpdated: "Last Updated: January 13, 2026",
        intro: "We understand that purchases don't always go as planned. If you regret a purchase or make it accidentally, you may be able to get a refund. Below, we've set out some rules for what can and cannot be returned, along with other related information.",
        sections: [
            {
                t: "What can be returned and what cannot",
                d: "We will refund any unused content from the following list of \"refundable\" products purchased within the last 14 days, unless applicable law requires otherwise. Once we have issued a refund, the affected content will be removed from your account.",
                list: [
                    {label: "Premium currency (Unused credits)", status: "yes"},
                    {label: "Unused digital content", status: "yes"},
                    {label: "Used or processed content", status: "no"},
                    {label: "Promotional bundles", status: "no"},
                    {label: "Gifts sent or received", status: "no"}
                ]
            },
            {
                t: "Additional Rules Regarding Real Money Refunds",
                d: "If you use real money to purchase Game Currency (Credits) and do not spend it, you may request a refund from our support team within the first 14 days of purchase. Refunds will only be issued to the original payment method."
            },
            {
                t: "Transaction Reversals",
                d: "In order to combat potential fraud, once a transaction related to an account is reversed, that account may be suspended. Players may regain access to their account after contacting support and regularizing the payment."
            }
        ],
        howTo: {
            t: "How to get my refund?",
            d: "To request a refund, you must contact our Support team at contact@brickify.fun indicating the transaction details. The process may take several business days to complete."
        }
    },
} as const;
const t = copies[locale];
---
<section class="relative w-full">
    <div class="container mx-auto px-4 md:px-6 py-12 md:py-16">
        <div class="flex items-center gap-4 mb-3 md:mb-4">
            <img src="/piece-2.svg" alt="piece" class="w-10 md:w-16 -mb-4" loading="lazy"/>
            <h1 class="text-3xl md:text-4xl font-bold">{t.heroTitle}</h1>
        </div>
        <p class="text-sm text-muted-foreground mb-6">{t.lastUpdated}</p>

        <article class="rounded-2xl bg-white/90 backdrop-blur-sm border shadow-sm p-6 mb-6">
            <p class="text-neutral-700">{t.intro}</p>
        </article>

        <div class="grid grid-cols-1 gap-6">
            {t.sections.map((s) => (
                    <article class="rounded-2xl bg-white/90 backdrop-blur-sm border shadow-sm p-6">
                        <h2 class="text-xl font-semibold mb-3">{s.t}</h2>
                        <p class="text-neutral-700 leading-relaxed mb-4">{s.d}</p>
                        {s.list && (
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-2 mt-4">
                                    {s.list.map((item) => (
                                            <div class="flex items-center gap-2 p-2 rounded-lg bg-gray-50/50">
                  <span class={item.status === 'yes' ? "text-green-600 font-bold" : "text-red-600 font-bold"}>
                    {item.status === 'yes' ? "✓" : "X"}
                  </span>
                                                <span class="text-sm text-neutral-600">{item.label}</span>
                                            </div>
                                    ))}
                                </div>
                        )}
                    </article>
            ))}

            <article class="rounded-2xl bg-primary/5 border border-primary/20 backdrop-blur-sm shadow-sm p-6">
                <h2 class="text-xl font-semibold mb-3">{t.howTo.t}</h2>
                <p class="text-neutral-700 leading-relaxed">{t.howTo.d}</p>
            </article>
        </div>
    </div>
</section>
