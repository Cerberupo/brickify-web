---
import {normalizeLocale, type SupportedLocale} from "@/lib/locale";

interface Props {
    locale?: SupportedLocale;
}

const {locale: localeProp} = Astro.props as Props;
const locale = localeProp ?? normalizeLocale(Astro.currentLocale as string | undefined);

const copies = {
    es: {
        title: "Tu privacidad",
        desc:
            "Usamos Google Analytics para entender el uso del sitio. Solo cargaremos estas cookies si aceptas.",
        accept: "Aceptar",
        reject: "Rechazar",
        more: "Más info",
        privacyHref: "/es/privacy",
    },
    en: {
        title: "Your privacy",
        desc:
            "We use Google Analytics to understand site usage. We'll only load these cookies if you accept.",
        accept: "Accept",
        reject: "Reject",
        more: "Learn more",
        privacyHref: "/en/privacy",
    },
} as const;
const t = copies[locale];
---
<div id="cookie-banner" class="fixed inset-x-0 bottom-0 z-[100] px-3 pb-3 pointer-events-none" style="display:none">
    <div
            class="mx-auto max-w-3xl rounded-2xl bg-white border shadow-xl p-4 md:p-5 pointer-events-auto flex flex-col md:flex-row md:items-center gap-3"
            role="dialog"
            aria-labelledby="cookie-banner-title"
    >
        <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-1">
                <img src="/favicon.png" alt="logo" class="w-5 h-5" loading="lazy"/>
                <h2 id="cookie-banner-title" class="text-sm font-semibold">{t.title}</h2>
            </div>
            <p class="text-sm text-neutral-700">
                {t.desc}
                <a href={t.privacyHref} class="underline ml-1" target="_blank" rel="noopener">{t.more}</a>
            </p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
            <button id="cookie-reject" class="text-sm px-3 py-2 rounded-lg border hover:bg-neutral-50">
                {t.reject}
            </button>
            <button id="cookie-accept" class="text-sm px-3 py-2 rounded-lg bg-black text-white hover:opacity-95">
                {t.accept}
            </button>
        </div>
    </div>
    <script>
        (function () {
            try {
                const KEY = 'brickify.cookies.analytics';

                // Helpers que consultan el DOM actual (evita referencias obsoletas tras Transitions)
                const getBannerEl = () => document.getElementById('cookie-banner') as HTMLElement | null;
                const hide = () => {
                    const el = getBannerEl();
                    if (el) el.style.display = 'none';
                };
                const show = () => {
                    const el = getBannerEl();
                    if (el) el.style.display = '';
                };

                const save = (value: string) => {
                    try {
                        localStorage.setItem(KEY, value);
                    } catch (e) {
                    }
                };
                const load = (): string | null => {
                    try {
                        return localStorage.getItem(KEY);
                    } catch (e) {
                        return null;
                    }
                };

                // API global idempotente para abrir el banner en cualquier momento
                (window as any).Brickify = (window as any).Brickify || {};
                (window as any).Brickify.openCookieBanner = (window as any).Brickify.openCookieBanner || function () {
                    try {
                        (window as any).__brickifyOpenCookieBannerRequested = true;
                        window.dispatchEvent(new CustomEvent('brickify:open-cookie-banner'));
                        show();
                    } catch (e) {
                    }
                };

                // Un único listener global para peticiones de apertura
                if (!(window as any).__brickifyOpenCookieBannerEventBound) {
                    (window as any).__brickifyOpenCookieBannerEventBound = true;
                    window.addEventListener('brickify:open-cookie-banner', function () {
                        try {
                            show();
                            (window as any).__brickifyOpenCookieBannerRequested = false;
                        } catch (e) {
                        }
                    });
                }

                // Delegación global para clicks en los botones (soporta reemplazo de DOM)
                if (!(window as any).__brickifyCookieBannerClicksBound) {
                    (window as any).__brickifyCookieBannerClicksBound = true;
                    document.addEventListener('click', function (ev) {
                        try {
                            const t = ev.target as HTMLElement | null;
                            if (!t) return;
                            // Buscar botón acepto/rechazo en la jerarquía
                            let el: HTMLElement | null = t;
                            let accept = false, reject = false;
                            while (el && el !== document.documentElement) {
                                if (el.id === 'cookie-accept') {
                                    accept = true;
                                    break;
                                }
                                if (el.id === 'cookie-reject') {
                                    reject = true;
                                    break;
                                }
                                el = el.parentElement as HTMLElement | null;
                            }
                            if (!accept && !reject) return;

                            if (accept) {
                                save('granted');
                                hide();
                                if (typeof (window as any).gtag === 'function') {
                                    (window as any).gtag('consent', 'update', {
                                        ad_user_data: 'granted',
                                        ad_personalization: 'granted',
                                        ad_storage: 'granted',
                                        analytics_storage: 'granted'
                                    });
                                }
                            } else if (reject) {
                                save('denied');
                                hide();
                                if (typeof (window as any).gtag === 'function') {
                                    (window as any).gtag('consent', 'update', {
                                        analytics_storage: 'denied',
                                        ad_storage: 'denied'
                                    });
                                }
                            }
                        } catch (e) {
                        }
                    }, true);
                }

                // Sincronizar visibilidad en cada montaje (resiliente a Transitions)
                const syncBannerVisibility = () => {
                    const pref = load();
                    if (pref === 'granted' || pref === 'denied') hide(); else show();
                    if ((window as any).__brickifyOpenCookieBannerRequested) {
                        show();
                        (window as any).__brickifyOpenCookieBannerRequested = false;
                    }
                };
                syncBannerVisibility();
            } catch (e) {
            }
        })();
    </script>
</div>
