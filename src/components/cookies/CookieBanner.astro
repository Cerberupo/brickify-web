---
import {normalizeLocale, type SupportedLocale} from "@/lib/locale";

interface Props {
    locale?: SupportedLocale;
}

const {locale: localeProp} = Astro.props as Props;
const locale = localeProp ?? normalizeLocale(Astro.currentLocale as string | undefined);

// Selección de GA por entorno (inyectado por workflow vía PUBLIC_APP_ENV)
const appEnv = (import.meta.env.PUBLIC_APP_ENV as string | undefined) || (import.meta.env.PROD ? 'prod' : 'dev');
const GA_ID_PROD = 'G-NMHZPGD0CP';
const GA_ID_DEV = 'G-DPDNGB0EKZ';
const GA_ID = appEnv === 'prod' ? GA_ID_PROD : GA_ID_DEV;

const copies = {
    es: {
        title: "Tu privacidad",
        desc:
            "Usamos Google Analytics para entender el uso del sitio. Solo cargaremos estas cookies si aceptas.",
        accept: "Aceptar",
        reject: "Rechazar",
        more: "Política de cookies",
        privacyHref: "/es/cookies",
    },
    en: {
        title: "Your privacy",
        desc:
            "We use Google Analytics to understand site usage. We'll only load these cookies if you accept.",
        accept: "Accept",
        reject: "Reject",
        more: "Read the cookie policy",
        privacyHref: "/en/cookies",
    },
} as const;
const t = copies[locale];
---
<div id="cookie-banner"
     class="fixed inset-x-0 bottom-0 z-[100] px-3 pb-3 pointer-events-none transition-opacity duration-300"
     style="opacity:0;">
    <div
            id="cookie-banner-content"
            class="mx-auto max-w-3xl rounded-2xl bg-white border shadow-xl p-4 md:p-5 pointer-events-auto flex flex-col md:flex-row md:items-center gap-3"
            role="dialog"
            aria-labelledby="cookie-banner-title"
    >
        <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-1">
                <img src="/favicon.png" alt="logo" class="w-5 h-5" loading="lazy"/>
                <h2 id="cookie-banner-title" class="text-sm font-semibold">{t.title}</h2>
            </div>
            <p class="text-sm text-neutral-700">
                {t.desc}
                <a href={t.privacyHref} class="underline ml-1" target="_blank" rel="noopener">{t.more}</a>
            </p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
            <button id="cookie-reject" class="text-sm px-3 py-2 rounded-lg border hover:bg-neutral-50"
                    onclick="try{window.__cookieReject&&window.__cookieReject()}catch(e){}">
                {t.reject}
            </button>
            <button id="cookie-accept" class="text-sm px-3 py-2 rounded-lg bg-black text-white hover:opacity-95"
                    onclick="try{window.__cookieAccept&&window.__cookieAccept()}catch(e){}">
                {t.accept}
            </button>
        </div>
    </div>

    <script define:vars={{GA_ID, appEnv}}>
        const KEY = 'brickify.cookies.analytics';

        // ================= Google Analytics (GTag) with Consent Mode =================
        if (!window.__brickifyGAInit) {
            window.__brickifyGAInit = true;
            try {
                // dataLayer y gtag tempranos
                window.dataLayer = window.dataLayer || [];
                window.gtag = window.gtag || function () {
                    window.dataLayer.push(arguments);
                };
                // Consentimiento por defecto: denegado
                window.gtag('consent', 'default', {
                    ad_user_data: 'denied',
                    ad_personalization: 'denied',
                    ad_storage: 'denied',
                    analytics_storage: 'denied',
                    wait_for_update: 500
                });

                // Cargar gtag.js siempre (no crea cookies si analytics_storage está denied)
                if (!document.getElementById('gtag-js')) {
                    const s = document.createElement('script');
                    s.id = 'gtag-js';
                    s.async = true;
                    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
                    document.head.appendChild(s);
                }

                // Inicialización básica
                window.gtag('js', new Date());
                window.gtag('config', GA_ID, {anonymize_ip: true});

                // Aplicar preferencia previa si existe
                try {
                    const pref0 = localStorage.getItem(KEY);
                    if (pref0 === 'granted') {
                        window.gtag('consent', 'update', {
                            ad_user_data: 'granted',
                            ad_personalization: 'granted',
                            ad_storage: 'granted',
                            analytics_storage: 'granted'
                        });
                    }
                } catch (e) {
                }

                // Pageview en navegaciones
                if (!window.__brickifyGAPageLoadBound) {
                    window.__brickifyGAPageLoadBound = true;
                    document.addEventListener('astro:page-load', function () {
                        try {
                            if (typeof window.gtag === 'function') {
                                window.gtag('config', GA_ID, {
                                    page_path: location.pathname,
                                    anonymize_ip: true
                                });
                            }
                        } catch (e) {
                        }
                    });
                }
            } catch (e) {
            }
        }

        // Helpers que consultan el DOM actual (evita referencias obsoletas tras Transitions)
        const getBannerEl = function () {
            return document.getElementById('cookie-banner');
        };
        const getBannerContentEl = function () {
            return document.getElementById('cookie-banner-content');
        };
        const hide = function () {
            const el = getBannerEl();
            const content = getBannerContentEl();
            if (el) {
                el.style.opacity = '0';
            }
            if (content) {
                content.style.pointerEvents = 'none';
            }
        };
        const show = function () {
            const el = getBannerEl();
            const content = getBannerContentEl();
            if (el) {
                el.style.opacity = '1';
            }
            if (content) {
                content.style.pointerEvents = 'all';
            }
        };

        const save = function (value) {
            localStorage.setItem(KEY, value);
        };
        const load = function () {
            try {
                return localStorage.getItem(KEY);
            } catch (e) {
                return null;
            }
        };

        // API global idempotente para abrir el banner en cualquier momento (sin eventos custom)
        window.Brickify = window.Brickify || {};
        window.Brickify.openCookieBanner = window.Brickify.openCookieBanner || function () {
            show();
        };

        // Handlers de botones expuestos globalmente y llamados vía onclick
        const onAccept = function () {
            save('granted');
            hide();
            if (typeof window.gtag === 'function') {
                window.gtag('consent', 'update', {
                    ad_user_data: 'granted',
                    ad_personalization: 'granted',
                    ad_storage: 'granted',
                    analytics_storage: 'granted'
                });
            }
        };
        const onReject = function () {
            save('denied');
            hide();
            if (typeof window.gtag === 'function') {
                window.gtag('consent', 'update', {
                    ad_user_data: 'denied',
                    ad_personalization: 'denied',
                    ad_storage: 'denied',
                    analytics_storage: 'denied',
                });
            }
        };
        // Exponer funciones globales para ser llamadas directamente desde los botones
        window.__cookieAccept = onAccept;
        window.__cookieReject = onReject;

        // Sincronizar visibilidad en cada montaje (resiliente a Transitions)
        const syncBannerVisibility = function () {
            const pref = load();
            if (pref === 'granted' || pref === 'denied') {
                hide();
            } else {
                show();
            }
        };
        syncBannerVisibility();

        // Re-sincronizar en cada navegación de Astro Transitions
        if (!window.__brickifyCookieBannerPageLoadBound) {
            window.__brickifyCookieBannerPageLoadBound = true;
            document.addEventListener('astro:page-load', function () {
                syncBannerVisibility();
            });
        }
    </script>
</div>
