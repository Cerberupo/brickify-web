---
import {Button} from "@/components/ui/button";
import {t} from "astro-i18next";
import {localizePath} from "astro-i18next";
---

<header className="bg-background border-b border-border">
    <div className="container mx-auto px-4 py-3 flex justify-between items-center">
        <div className="flex items-center">
            <a href={localizePath("/")} className="text-xl font-bold">Brickify</a>
        </div>
        <nav>
            <ul className="flex space-x-4 items-center">
                <li>
                    <a href={localizePath("/")} className="hover:text-primary transition-colors">{t('header.home')}</a>
                </li>
                <li>
                    <a href={localizePath("/dashboard")}
                       className="hover:text-primary transition-colors">{t('header.dashboard')}</a>
                </li>
                <li>
                    <Button as="a" href={localizePath("/login")} variant="outline"
                            size="sm">{t('header.login')}</Button>
                </li>
                <li className="ml-4">
                    <div className="flex space-x-2">
                        <a href="/en/"
                           className={`text-sm ${Astro.currentLocale === 'en' ? 'font-bold text-primary' : 'text-muted-foreground'}`}>EN</a>
                        <span className="text-muted-foreground">|</span>
                        <a href="/es/"
                           className={`text-sm ${Astro.currentLocale === 'es' ? 'font-bold text-primary' : 'text-muted-foreground'}`}>ES</a>
                    </div>
                </li>
            </ul>
        </nav>
    </div>
</header>
