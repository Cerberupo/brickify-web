---
import {normalizeLocale, type SupportedLocale} from "@/lib/locale";

interface Props {
    locale?: SupportedLocale;
}

const {locale: localeProp} = Astro.props as Props;
const locale = localeProp ?? normalizeLocale(Astro.currentLocale as string | undefined);

const copies = {
    en: {
        overline: "AN UNFORGETTABLE KEEPSAKE",
        title: "Turn any image into a unique idea with our AI.",
        description:
            "Create memorable moments, surprise someone, or simply bring your memories to life in a fun and original way with official LEGO® pieces carefully selected for you.",
        collageAria: "Collage showing a transition from a real photo to a custom LEGO® minifigure portrait"
    },
    es: {
        overline: "UN RECUERDO INOLVIDABLE",
        title: "Convierte cualquier imagen en una idea única con nuestra IA.",
        description:
            "Crea momentos memorables, sorprende a alguien o simplemente da vida a tus recuerdos de forma divertida y original con piezas oficiales de LEGO® seleccionadas especialmente para ti.",
        collageAria: "Collage que muestra la transición de una foto real a un retrato de minifigura LEGO® personalizada"
    }
} as const;

const t = copies[locale];
---
<section class="py-6 md:py-24" aria-labelledby="memory-title">
    <div class="container mx-auto">
        <!-- Single big card wrapper containing image (left) and content (right) -->
        <div class="relative rounded-[28px] overflow-hidden bg-[#FCF6F0]">

            <div class="relative grid grid-cols-1 md:grid-cols-12 gap-0 items-stretch">
                <!-- Left: single image from public/memory-highlight.png (full bleed) -->
                <div class="relative md:col-span-6 h-full">
                    <figure class="relative h-full w-full overflow-hidden">
                        <img src="/memory-highlight.jpg" alt={t.collageAria} class="w-full h-full object-cover"
                             loading="lazy"/>
                    </figure>
                </div>

                <!-- Right: copy content -->
                <div class="md:col-span-6 p-6 md:p-12 flex items-center">
                    <div>
                        <p class="text-[16px] mb-4 font-medium uppercase">{t.overline}</p>
                        <h2 id="memory-title"
                            class="text-[32px] font-medium leading-[1.15] mb-4">{t.title}</h2>
                        <p class="text-[16px] font-light">{t.description}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
