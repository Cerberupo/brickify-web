---
import {normalizeLocale, type SupportedLocale} from "@/lib/locale";

interface Props {
    locale?: SupportedLocale;
}

const {locale: localeProp} = Astro.props as Props;
const locale = localeProp ?? normalizeLocale(Astro.currentLocale as string | undefined);

const copies = {
    en: {
        overline: "AN UNFORGETTABLE KEEPSAKE",
        title: "Your photo, now a collectible piece.",
        description:
            "Imagine opening the box and finding your moment turned into LEGO®. A physical piece that stays with you forever.",
        collageAria: "Photo collage preview in LEGO style"
    },
    es: {
        overline: "UN RECUERDO INOLVIDABLE",
        title: "Tu foto, ahora convertida en pieza de colección.",
        description:
            "Imagina que esa persona abre la caja… y dentro está vuestro momento convertido en LEGO®. Una pieza física que se guarda para siempre.",
        collageAria: "Collage de fotos en estilo LEGO"
    }
} as const;

const t = copies[locale];
---
<section class="py-14 md:py-24" aria-labelledby="memory-title">
    <div class="container mx-auto">
        <!-- Single big card wrapper containing image (left) and content (right) -->
        <div class="relative rounded-[28px] overflow-hidden bg-[#FCF6F0]">

            <div class="relative grid grid-cols-1 md:grid-cols-12 gap-0 items-stretch">
                <!-- Left: single image from public/memory-highlight.png (full bleed) -->
                <div class="relative md:col-span-6 h-full">
                    <figure class="relative h-full w-full overflow-hidden">
                        <img src="/memory-highlight.png" alt={t.collageAria} class="w-full h-full object-cover"
                             loading="lazy"/>
                    </figure>
                </div>

                <!-- Right: copy content -->
                <div class="md:col-span-6 p-6 md:p-12 flex items-center">
                    <div>
                        <p class="text-[16px] md:text-xs tracking-[0.2em] mb-4 font-medium uppercase">{t.overline}</p>
                        <h2 id="memory-title"
                            class="text-[32px] md:text-4xl font-medium leading-[1.15] mb-4">{t.title}</h2>
                        <p class="text-[16px] md:text-lg font-light">{t.description}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
