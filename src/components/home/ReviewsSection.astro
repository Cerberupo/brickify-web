---
import type {SupportedLocale} from "@/lib/locale";

interface Review {
    id: number;
    name: string;
    title: string;
    text: string;
    rating: number;
    images?: string[];
}

interface Props {
    locale: SupportedLocale;
    reviews?: Review[];
}

const {locale, reviews} = Astro.props as Props;

const defaultReviews: Record<SupportedLocale, Review[]> = {
    es: [
        {
            id: 2,
            name: 'Carlos M.',
            title: 'Cumpleaños memorable',
            text: 'Lo utilicé para hacerle un regalo a mi mujer por su cumpleaños. Es una gran fan de LEGO y fue un acierto absoluto. La IA lo clavó todo xD y a ella le encantó. Sin duda, es un detalle original y personal. Repetiré sin dudar.',
            rating: 5,
            images: ['/reviews/birthday/birthday1.png', '/reviews/birthday/birthday2.png']
        },
        {
            id: 3,
            name: 'Elena R.',
            title: 'Regalo de empresa',
            text: 'Convertimos a un compañero de trabajo en minifig para felicitarlo por su ascenso. La sorpresa encantó a todo el equipo y a él le hizo muchísima ilusión. La verdad, fue todo un acierto.',
            rating: 4,
            images: ['/reviews/job/job1.png']
        },
        {
            id: 4,
            name: 'Sergio P.',
            title: 'Detalle de aniversario',
            text: 'La figura quedó clavadísima. Repetiré para otros regalos. El proceso fue súper sencillo.',
            rating: 4,
            images: ['/reviews/aniversary/aniversary1.png']
        },
        {
            id: 1,
            name: 'Lucía G.',
            title: 'Regalo de bodas perfecto',
            text: 'Pedí 50 minifiguras para mi boda y quedaron espectaculares. A los invitados les encantaron y semanas después seguían comentándolo. Me fascinó lo bien que reprodujeron a cada persona y poder ver la figura terminada con sus referencias.',
            rating: 5,
            images: ['/reviews/wedding/wedding1.png', '/reviews/wedding/wedding2.png', '/reviews/wedding/wedding3.png']
        },
        {
            id: 5,
            name: 'María L.',
            title: 'Rápido y divertido',
            text: 'Subí una foto, elegí un par de opciones y listo. En minutos tenía las piezas recomendadas. ¡Muy top!',
            rating: 4,
            images: ['/reviews/funny/funny1.png']
        }
    ],
    en: [
        {
            id: 2,
            name: 'Charles M.',
            title: 'Memorable birthday',
            text: 'I used it to make a birthday gift for my wife. She\'s a huge LEGO fan, and it was a total hit. The AI got everything right, and she loved it. It\'s definitely an original and personal gift. I\'ll definitely use it again.',
            rating: 5,
            images: ['/reviews/birthday/birthday1.png', '/reviews/birthday/birthday2.png']
        },
        {
            id: 3,
            name: 'Helen R.',
            title: 'Corporate gift',
            text: 'Convertimos a un compañero de trabajo en minifig para felicitarlo por su ascenso. La sorpresa encantó a todo el equipo y a él le hizo muchísima ilusión. La verdad, fue todo un acierto.',
            rating: 4,
            images: ['/reviews/job/job1.png']
        },
        {
            id: 4,
            name: 'Sergio P.',
            title: 'Anniversary surprise',
            text: 'The figure looked just like the photo. I’ll use it again for other gifts. Super easy process.',
            rating: 4,
            images: ['/reviews/aniversary/aniversary1.png']
        },
        {
            id: 1,
            name: 'Lucy G.',
            title: 'Perfect wedding gift',
            text: 'I ordered 50 minifigures for my wedding and they turned out spectacular. The guests loved them and weeks later they were still talking about them. I was fascinated by how well they reproduced each person and being able to see the finished figure with their references.',
