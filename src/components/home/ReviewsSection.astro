const list: Review[] = reviews ?? defaultReviews[locale];


const copies = {
    es: {
        title: 'Reseñas'
    },
    en: {
        title: 'Reviews'
    }
} as const;
const t = copies[locale];
---
<script src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-element-bundle.min.js"></script>

<!-- Swiper Web Components registered via ESM so Vite bundles it correctly -->
<script type="module">
    import {register} from 'swiper/element/bundle';

    register();
</script>
<style is:global>
    /* Keep Swiper styles from CDN to avoid PostCSS ENOENT on local CSS imports */
    @import url('https://unpkg.com/swiper@11/swiper-bundle.min.css');
    /* Minimal fallbacks to avoid stacked slides flash before upgrade */
    swiper-container {
        display: block;
        width: 100%;
    }

    swiper-slide {
        display: block;
    }

    /* Black theme for navigation arrows and pagination ("stepper") */
    swiper-container.reviews-swiper {
        /* Pagination (bullets) */
        --swiper-pagination-color: #000; /* active bullet */
        --swiper-pagination-bullet-inactive-color: #000; /* base color for inactive */
        --swiper-pagination-bullet-inactive-opacity: 0.25; /* faded inactive */
        --swiper-pagination-bullet-size: 8px;
        --swiper-pagination-bullet-horizontal-gap: 6px;
    }


    swiper-container::part(button-prev),
    swiper-container::part(button-next) {
        padding: 10px;
        width: 20px;
        height: 20px;
        border-radius: 9999px;
        background: #000;
        color: #fff;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
        display: grid;
        place-items: center;
        z-index: 20;
    }

    swiper-container::part(container)::after {
        content: '';
        pointer-events: none;
        position: absolute;
        right: 0;
        top: 0;
        width: 100px;
        height: 100%;
        background: linear-gradient(to right, rgba(255, 255, 255, 0), rgba(255, 255, 255, 1));
        z-index: 10;
    }

    swiper-container::part(container)::before {
        content: '';
        pointer-events: none;
        position: absolute;
        left: 0;
        top: 0;
        width: 100px;
        height: 100%;
        background: linear-gradient(to left, rgba(255, 255, 255, 0), rgba(255, 255, 255, 1));
        z-index: 10;
    }

    @media (max-width: 768px) {
        swiper-container::part(container)::before,
        swiper-container::part(container)::after {
            display: none;
        }
    }

    swiper-container::part(container) {
        padding-bottom: 50px;
    }


    /* Equal height for review cards */
    .reviews-swiper {
        --review-card-h: 280px;
    }

    @media (min-width: 768px) {
        .reviews-swiper {
            --review-card-h: 280px;
        }
    }

    @media (min-width: 1024px) {
        .reviews-swiper {
            --review-card-h: 300px;
        }
    }

    @media (min-width: 1280px) {
        .reviews-swiper {
            --review-card-h: 320px;
        }
    }

    /* Make slides flex-items and allow them to stretch to the same height */
    .reviews-swiper swiper-slide {
        display: flex;
        align-items: stretch;
        height: auto;
    }

    /* Ensure the internal swiper container stretches its children (slides) */
    swiper-container.reviews-swiper::part(container) {
        align-items: stretch;
    }

    .reviews-swiper swiper-slide > .review-card {
        /* Make the card fill the available slide height */
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-sizing: border-box;
        height: auto;
    }

    .review-card header {
        flex: 0 0 auto;
    }

    .review-card h3 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin-top: 1rem;
        font-weight: 600;
    }

    .review-card p {
        flex: 1 1 auto;
        /* Show full description; container height comes from flex layout */
        display: block;
        overflow: visible;
        margin-top: 0.5rem;
        line-height: 1.5;
        color: rgb(64 64 64);
    }

</style>

<section id="reviews" class="relative w-full py-10 md:py-16 overflow-hidden">
    <div class="container mx-auto px-4 md:px-6">
        <div class="flex items-center gap-4 mb-6 md:mb-8">
            <img src="/piece-2.svg" alt="piece" class="w-10 md:w-16 -mb-4" loading="lazy"/>
            <h2 class="text-3xl md:text-4xl font-bold">{t.title}</h2>
        </div>

        <div class="md:-mx-6 relative">
            <swiper-container
                    class="reviews-swiper"
                    slides-per-view="1"
                    space-between="16"
                    speed="500"
                    navigation="true"
                    pagination="true"
                    breakpoints='{ "640": { "centeredSlides": true, "slidesPerView": 1, "spaceBetween": 16 }, "768": { "centeredSlides": true, "slidesPerView": 2, "spaceBetween": 20 }, "1024": { "centeredSlides": true, "slidesPerView": 3, "spaceBetween": 24 }, "1280": { "centeredSlides": true, "slidesPerView": 4, "spaceBetween": 28 } }'
            >
                {list.map((r) => (
                        <swiper-slide>
                            <article
                                    class="review-card rounded-2xl bg-white/80 backdrop-blur-sm border shadow-sm p-5 md:p-6 select-none">
                                <header class="flex items-center justify-between pb-4 border-b">
                                    <div class="flex items-center gap-3">
                                        <div>
                                            <div class="font-semibold">{r.name}</div>
                                        </div>
                                    </div>
                                    <div class="text-lg"
                                         aria-label={locale === 'es' ? `${r.rating} de 5` : `${r.rating} out of 5`}>
                                        <span class="text-amber-400">{"★".repeat(r.rating)}{"☆".repeat(5 - r.rating)}</span>
                                    </div>
                                </header>

                                <h3 class="mt-4 font-semibold">{r.title}</h3>
                                <p class="mt-2 text-sm leading-6 text-neutral-700">{r.text}</p>

                                {r.images && r.images.length > 0 ? (
                                        <div class="flex gap-3 mt-4">
                                            {r.images.map((img) => (
                                                    <img
                                                            src={img}
                                                            alt={`Imagen reseña ${r.title}`}
                                                            class="size-12 rounded-md bg-neutral-300 object-cover"
                                                            loading="lazy"
                                                    />
                                            ))}
                                        </div>
                                ) : null}
                            </article>
                        </swiper-slide>
                ))}
            </swiper-container>
        </div>
    </div>
</section>

<script type="module">
    // Equalize review cards height to the tallest card by setting --review-card-h on the container.
    // Observa cambios (ResizeObserver, carga de imágenes, resize de ventana) y recalcula cuando sea necesario.
    (function () {
        const debounce = (fn, wait = 100) => {
            let t;
            return (...args) => {
                clearTimeout(t);
                t = setTimeout(() => fn(...args), wait);
            };
        };

        function init() {
            const container = document.querySelector('.reviews-swiper');
            if (!container) return;

            const recalc = () => {
                const cards = Array.from(container.querySelectorAll('.review-card'));
                if (!cards.length) return;

                // Reset explicit heights to measure natural height
                cards.forEach((c) => {
                    c.style.height = 'auto';
                });

                let max = 0;
                cards.forEach((c) => {
                    const rect = c.getBoundingClientRect();
                    const h = Math.ceil(rect.height);
                    if (h > max) max = h;
                });

                // Apply the max height as CSS variable and explicit height to cards
                if (max > 0) {
                    container.style.setProperty('--review-card-h', `${max}px`);
                    cards.forEach((c) => {
                        c.style.height = `${max}px`;
                    });
                }
            };

            const debouncedRecalc = debounce(recalc, 80);

            // Observe size changes in cards
            const cards = Array.from(container.querySelectorAll('.review-card'));
            cards.forEach((c) => {
                try {
                    const ro = new ResizeObserver(debouncedRecalc);
                    ro.observe(c);
                } catch (e) {
                    // ResizeObserver may not be available in some envs; fallback to window resize
                }

                // Recalc when images inside a card load
                const imgs = Array.from(c.querySelectorAll('img'));
                imgs.forEach((img) => {
                    if (!img.complete) {
                        img.addEventListener('load', debouncedRecalc, {once: true});
                    }
                });
            });

            // Listen for window resize
            window.addEventListener('resize', debouncedRecalc);

            // Some timings (fonts, web components) may change size after load:
            // run a few recalculations with slight delays to stabilize layout.
            setTimeout(recalc, 50);
            setTimeout(recalc, 300);
            setTimeout(recalc, 800);

            // If using swiper web component events, listen for structure changes
            const swiperEl = container.closest('swiper-container');
            if (swiperEl) {
                swiperEl.addEventListener('slideschanged', debouncedRecalc);
                swiperEl.addEventListener('slidechange', debouncedRecalc);
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
    })();
</script>
