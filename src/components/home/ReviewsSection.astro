---
import type {SupportedLocale} from "@/lib/locale";

interface Review {
    id: number;
    name: string;
    monthsAgo: number;
    title: string;
    text: string;
    rating: number;
}

interface Props {
    locale: SupportedLocale;
    reviews?: Review[];
}

const {locale, reviews} = Astro.props as Props;

const defaultReviews: Record<SupportedLocale, Review[]> = {
    es: [
        {
            id: 1,
            name: 'Lucía G.',
            monthsAgo: 1,
            title: 'Regalo de bodas perfecto',
            text: 'Pedí una minifig para regalar en una boda y quedó increíble. Capturaron el peinado y la ropa tal cual. Llegó con todos los códigos de piezas.',
            rating: 5
        },
        {
            id: 2,
            name: 'Carlos M.',
            monthsAgo: 2,
            title: 'Cumpleaños memorable',
            text: 'Lo usé para el cumpleaños de mi sobrino. La IA acertó muchísimo con los colores y accesorios. Se divirtió montándola.',
            rating: 4
        },
        {
            id: 3,
            name: 'Elena R.',
            monthsAgo: 3,
            title: 'Equipo de trabajo en LEGO',
            text: 'Convertimos a todo el equipo en minifigs. Fue un éxito en la oficina y ahora están en nuestras mesas.',
            rating: 5
        },
        {
            id: 4,
            name: 'Sergio P.',
            monthsAgo: 4,
            title: 'Detalle de aniversario',
            text: 'La figura quedó clavadísima. Repetiré para otros regalos. El proceso fue súper sencillo.',
            rating: 4
        },
        {
            id: 5,
            name: 'María L.',
            monthsAgo: 5,
            title: 'Rápido y divertido',
            text: 'Subí una foto, elegí un par de opciones y listo. En minutos tenía las piezas recomendadas. ¡Muy top!',
            rating: 5
        },
        {
            id: 6,
            name: 'Javi T.',
            monthsAgo: 6,
            title: 'Para coleccionistas',
            text: 'Si te gusta LEGO, esto es obligatorio. Las referencias oficiales facilitan pedir las piezas exactas.',
            rating: 5
        },
        {
            id: 7,
            name: 'Ana S.',
            monthsAgo: 7,
            title: 'Regalo original',
            text: 'Nunca había hecho un regalo tan personalizado. Les pasé detalles y lo reflejaron perfecto.',
            rating: 4
        },
        {
            id: 8,
            name: 'Raúl C.',
            monthsAgo: 8,
            title: 'Parecido sorprendente',
            text: 'El resultado se parecía muchísimo a la foto. Incluso el peinado y la barba.',
            rating: 5
        },
        {
            id: 9,
            name: 'Patricia V.',
            monthsAgo: 9,
            title: 'Para toda la familia',
            text: 'Hicimos minifigs de los cuatro en casa. Los niños fliparon montándolos.',
            rating: 5
        },
    ],
    en: [
        {
            id: 1,
            name: 'Lucy G.',
            monthsAgo: 1,
            title: 'Perfect wedding gift',
            text: 'I ordered a minifig as a wedding present and it turned out amazing. Hairstyle and outfit were spot on. Got all the part codes.',
            rating: 5
        },
        {
            id: 2,
            name: 'Charles M.',
            monthsAgo: 2,
            title: 'Memorable birthday',
            text: 'Used it for my nephew’s birthday. The AI nailed the colors and accessories. He loved building it.',
            rating: 4
        },
        {
            id: 3,
            name: 'Helen R.',
            monthsAgo: 3,
            title: 'Team in LEGO',
            text: 'We turned our whole team into minifigs. Big hit at the office and now they sit on our desks.',
            rating: 5
        },
        {
            id: 4,
            name: 'Sergio P.',
            monthsAgo: 4,
            title: 'Anniversary surprise',
            text: 'The figure looked just like the photo. I’ll use it again for other gifts. Super easy process.',
            rating: 4
        },
        {
            id: 5,
            name: 'Maria L.',
            monthsAgo: 5,
            title: 'Fast and fun',
            text: 'Uploaded a photo, picked a couple options and done. In minutes I had the recommended parts. Loved it!',
            rating: 5
        },
        {
            id: 6,
            name: 'Javier T.',
            monthsAgo: 6,
            title: 'For collectors',
            text: 'If you like LEGO, this is a must. Official references make it easy to order the exact parts.',
            rating: 5
        },
        {
            id: 7,
            name: 'Anna S.',
            monthsAgo: 7,
            title: 'Original gift',
            text: 'Never made such a personalized present. I gave them some details and they matched them perfectly.',
            rating: 4
        },
        {
            id: 8,
            name: 'Raul C.',
            monthsAgo: 8,
            title: 'Surprisingly accurate',
            text: 'The result looked a lot like the photo, even the hairstyle and beard.',
            rating: 5
        },
        {
            id: 9,
            name: 'Patty V.',
            monthsAgo: 9,
            title: 'For the whole family',
            text: 'We made minifigs for the four of us. The kids loved building them.',
            rating: 5
        },
    ],
