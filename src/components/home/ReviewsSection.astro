const list: Review[] = reviews ?? defaultReviews[locale];


const copies = {
    es: {
        title: 'Reseñas'
    },
    en: {
        title: 'Reviews'
    }
} as const;
const t = copies[locale];
---
<script src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-element-bundle.min.js"></script>

<!-- Swiper Web Components registered via ESM so Vite bundles it correctly -->
<script type="module">
    import {register} from 'swiper/element/bundle';

    register();
</script>
<style is:global>
    /* Keep Swiper styles from CDN to avoid PostCSS ENOENT on local CSS imports */
    @import url('https://unpkg.com/swiper@11/swiper-bundle.min.css');
    /* Minimal fallbacks to avoid stacked slides flash before upgrade */
    swiper-container {
        display: block;
        width: 100%;
    }

    swiper-slide {
        display: block;
    }

    /* Black theme for navigation arrows and pagination ("stepper") */
    swiper-container.reviews-swiper {
        /* Pagination (bullets) */
        --swiper-pagination-color: #000; /* active bullet */
        --swiper-pagination-bullet-inactive-color: #000; /* base color for inactive */
        --swiper-pagination-bullet-inactive-opacity: 0.25; /* faded inactive */
        --swiper-pagination-bullet-size: 8px;
        --swiper-pagination-bullet-horizontal-gap: 6px;
    }


    swiper-container::part(button-prev),
    swiper-container::part(button-next) {
        padding: 10px;
        width: 20px;
        height: 20px;
        border-radius: 9999px;
        background: #000;
        color: #fff;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
        display: grid;
        place-items: center;
        z-index: 20;
    }

    swiper-container::part(container)::after {
        content: '';
        pointer-events: none;
        position: absolute;
        right: 0;
        top: 0;
        width: 100px;
        height: 100%;
        background: linear-gradient(to right, rgba(255, 255, 255, 0), rgba(255, 255, 255, 1));
        z-index: 10;
    }

    swiper-container::part(container)::before {
        content: '';
        pointer-events: none;
        position: absolute;
        left: 0;
        top: 0;
        width: 100px;
        height: 100%;
        background: linear-gradient(to left, rgba(255, 255, 255, 0), rgba(255, 255, 255, 1));
        z-index: 10;
    }

    @media (max-width: 768px) {
        swiper-container::part(container)::before,
        swiper-container::part(container)::after {
            display: none;
        }
    }

    swiper-container::part(container) {
        padding-bottom: 50px;
    }


    /* Equal height for review cards */
    .reviews-swiper {
        --review-card-h: 280px;
    }

    @media (min-width: 768px) {
        .reviews-swiper {
            --review-card-h: 280px;
        }
    }

    @media (min-width: 1024px) {
        .reviews-swiper {
            --review-card-h: 300px;
        }
    }

    @media (min-width: 1280px) {
        .reviews-swiper {
            --review-card-h: 320px;
        }
    }

    .reviews-swiper swiper-slide {
        height: auto;
    }

    .reviews-swiper swiper-slide > .review-card {
        height: var(--review-card-h);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-sizing: border-box;
    }

    .review-card header {
        flex: 0 0 auto;
    }

    .review-card h3 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin-top: 1rem;
        font-weight: 600;
    }

    .review-card p {
        flex: 1 1 auto;
        display: -webkit-box;
        -webkit-line-clamp: 5;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin-top: 0.5rem;
        line-height: 1.5;
        color: rgb(64 64 64);
    }

</style>

<section class="relative w-full py-10 md:py-16 overflow-hidden">
    <div class="container mx-auto px-4 md:px-6">
        <div class="flex items-center gap-4 mb-6 md:mb-8">
            <img src="/piece-2.svg" alt="piece" class="w-10 md:w-16 -mb-4" loading="lazy"/>
            <h2 class="text-3xl md:text-4xl font-bold">{t.title}</h2>
        </div>

        <div class="md:-mx-6 relative">
            <swiper-container
                    class="reviews-swiper"
                    slides-per-view="1"
                    space-between="16"
                    speed="500"
                    navigation="true"
                    pagination="true"
                    breakpoints='{ "640": { "centeredSlides": true, "slidesPerView": 1, "spaceBetween": 16 }, "768": { "centeredSlides": true, "slidesPerView": 2, "spaceBetween": 20 }, "1024": { "centeredSlides": true, "slidesPerView": 3, "spaceBetween": 24 }, "1280": { "centeredSlides": true, "slidesPerView": 4, "spaceBetween": 28 } }'
            >
                {list.map((r) => (
                        <swiper-slide>
                            <article
                                    class="review-card rounded-2xl bg-white/80 backdrop-blur-sm border shadow-sm p-5 md:p-6 select-none">
                                <header class="flex items-center justify-between pb-4 border-b">
                                    <div class="flex items-center gap-3">
                                        <div>
                                            <div class="font-semibold">{r.name}</div>
                                        </div>
                                    </div>
                                    <div class="text-lg"
                                         aria-label={locale === 'es' ? `${r.rating} de 5` : `${r.rating} out of 5`}>
                                        <span class="text-amber-400">{"★".repeat(r.rating)}{"☆".repeat(5 - r.rating)}</span>
                                    </div>
                                </header>

                                <h3 class="mt-4 font-semibold">{r.title}</h3>
                                <p class="mt-2 text-sm leading-6 text-neutral-700">{r.text}</p>

                                <div class="flex gap-3 mt-4">
                                    <div class="size-12 rounded-md bg-neutral-300"/>
                                    <div class="size-12 rounded-md bg-neutral-300"/>
                                </div>
                            </article>
                        </swiper-slide>
                ))}
            </swiper-container>
        </div>
    </div>
</section>
