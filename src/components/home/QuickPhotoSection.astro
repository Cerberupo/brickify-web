---
import type {SupportedLocale} from "@/lib/locale";
import {API_URL} from "@/config";
import QuickPhotoCropperBridge from "@/components/home/QuickPhotoCropperBridge";

interface Props {
    locale: SupportedLocale
}
const {locale} = Astro.props as Props;

const copies = {
    es: {
        badge: "COMPRA RÁPIDA 1 FOTO",
        titleStrong: "Sin registrarte",
        titleRest: ", sube 1 foto, paga y listo.",
        desc: "Para pedidos simples con una única imagen. Súbela, realiza el pago y nosotros nos encargamos del resto. Recibirás las IDs de tus piezas LEGO® oficiales.",
        noteTitle: "Esta modalidad solo admite 1 foto.",
        noteText: "Si quieres añadir más imágenes o proyectos más complejos crea tu cuenta.",
        noteLogin: "Login",
        dropText: "Haz clic o arrastra una imagen",
        changeText: "Cambiar imagen",
        foot: "El precio incluye: diseño generado por IA + IDs LEGO® originales",
        formName: "Nombre*",
        formEmail: "Email*",
        formOpt2: "Acepto la política de privacidad",
        btn: "Continuar al pago €2.99"
    },
    en: {
        badge: "FAST PURCHASE · 1 PHOTO",
        titleStrong: "No sign‑up",
        titleRest: ", upload 1 photo, pay and done.",
        desc: "For simple orders with a single image. Upload it, complete payment and we’ll do the rest. You’ll receive the official LEGO® part IDs.",
        noteTitle: "This mode only accepts 1 photo.",
        noteText: "For more images or complex projects, create your account.",
        noteLogin: "Login",
        dropText: "Click or drop an image",
        changeText: "Change image",
        foot: "Price includes: AI design + original LEGO® IDs",
        formName: "Name*",
        formEmail: "Email*",
        formOpt2: "I accept the privacy policy",
        btn: "Continue to payment €2.99"
    }
} as const;
const t = copies[locale];
---
<style is:global>
    @reference "../../styles/global.css";
    .quick-photo-card {
        background: #FFEFCD;
    }

    .dropzone {
        position: relative;
        border: 3px dashed #cbbda2;
        border-radius: 20px;
        min-height: 400px;
        display: grid;
        place-items: center;
        color: #2b2b2b;
        background: #FFEFCD;
        transition: transform 150ms ease, box-shadow 150ms ease;
    }

    .dropzone:hover {
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
        transform: translateY(-1px);
    }

    /* Striped hover overlay to signal clickability */
    .dropzone::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: 20px;
        pointer-events: none;
        background: repeating-linear-gradient(45deg,
        rgba(0, 0, 0, 0.06) 0,
        rgba(0, 0, 0, 0.06) 10px,
        rgba(0, 0, 0, 0.02) 10px,
        rgba(0, 0, 0, 0.02) 20px);
        opacity: 0;
        transition: opacity 180ms ease;
    }

    .dropzone:hover::after,
    .dropzone:focus-within::after,
    .dropzone.is-hovering::after {
        opacity: 1;
    }

    .preview-img {
        border-radius: 20px;
        object-fit: contain;
        width: 100%;
        height: 100%;
    }

    .info-box {
        background: #E6F1FF;
        border: 1px solid #B5D6FF;
        border-radius: 12px;
    }

    /* Change-image overlay (visible on hover/focus when there is a preview) */
    #qp-drop.has-image:hover .change-overlay,
    #qp-drop.has-image:focus-visible .change-overlay,
    #qp-drop.has-image:focus-within .change-overlay {
        opacity: 1;
    }

    .change-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.6); /* darker transparent black */
        color: #fff;
        font-weight: 600;
        transition: opacity 180ms ease; /* slightly smoother */
        pointer-events: none; /* allow clicks to reach the drop zone */
        opacity: 0;
        border-radius: 20px;
    }
</style>

<section id="quick-photo" class="quick-photo-card relative w-full py-8 md:py-12">
    <div class="container mx-auto px-4 md:px-6">
        <div class=" rounded-2xl p-6 md:p-8">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-8 items-stretch">
                <!-- Copy + form column -->
                <div class="md:col-span-5 flex flex-col">
                    <div class="text-sm font-medium mb-2">{t.badge}</div>
                    <h3 class="text-[28px] leading-tight font-semibold mb-2">
                        <span>{t.titleStrong}</span><span class="font-normal">{t.titleRest}</span>
                    </h3>
                    <p class="text-sm mb-5">{t.desc}</p>

                    <!-- Info note -->
                    <div class="info-box p-4 mb-6 text-sm text-neutral-800">
                        <div class="flex items-start gap-3">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                 xmlns="http://www.w3.org/2000/svg" class="mt-[2px]">
                                <circle cx="12" cy="12" r="10" stroke="#2563eb" stroke-width="2"/>
                                <path d="M12 8h.01M11 12h2v6h-2z" fill="#2563eb"/>
                            </svg>
                            <div>
                                <div class="font-medium">{t.noteTitle}</div>
                                <div class="text-neutral-700">{t.noteText} <a
                                        href={locale === 'es' ? '/es/login' : '/en/login'}
                                        class="underline">{t.noteLogin}</a></div>
                            </div>
                        </div>
                    </div>

                    <!-- Upload form (hidden until a file is selected on mobile; visible state toggled by script) -->
                    <form id="qp-form" class="space-y-4 hidden">
                        <div>
                            <label for="qp-name" class="block text-sm font-medium mb-1">{t.formName}</label>
                            <input id="qp-name" type="text" class="w-full rounded-xl border px-3 py-2 bg-white"/>
                        </div>
                        <div>
                            <label for="qp-email" class="block text-sm font-medium mb-1">{t.formEmail}</label>
                            <input id="qp-email" type="email" class="w-full rounded-xl border px-3 py-2 bg-white"/>
                        </div>
                        <div class="flex items-center gap-2">
                            <input id="qp-opt2" type="checkbox" class="size-4"/>
                            <label for="qp-opt2" class="text-sm">
                                <a href={(locale === 'es' ? '/es/privacy' : '/en/privacy')} target="_blank"
                                   class="underline">
                                    {t.formOpt2}
                                </a>
                            </label>
                        </div>
                        <button id="qp-btn" type="button"
                                class="inline-flex items-center justify-center rounded-md bg-black text-white px-5 py-3 text-sm
                                       transition duration-200 ease-out will-change-transform
                                       hover:opacity-95 hover:-translate-y-0.5 hover:shadow-md hover:shadow-black/10
                                       active:translate-y-0 active:scale-95
                                       focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-black/50">{t.btn}</button>
                    </form>
                </div>

                <!-- Dropzone / Preview column -->
                <div class="md:col-span-7">
                    <div id="qp-drop" class="dropzone relative overflow-hidden cursor-pointer" role="button"
                         tabindex="0" aria-label={t.dropText}>
                        <div id="qp-instructions" class="text-center px-4">
                            <div class="text-xl md:text-2xl font-semibold">{t.dropText}</div>
                            <div class="mt-3 text-sm text-neutral-600">{locale === 'es' ? 'PNG, JPG • máx. 1.5MB' : 'PNG, JPG • max 1.5MB'}</div>
                        </div>
                        <!-- Hidden file input always available (even after selecting an image) -->
                        <input id="qp-file" type="file" accept="image/*" class="hidden"/>
                        <!-- Preview container (hidden initially) -->
                        <img id="qp-preview" alt="preview" class="preview-img hidden"/>
                        <!-- Change image overlay -->
                        <div id="qp-change" class="change-overlay" aria-hidden="true">{t.changeText}</div>
                    </div>
                    <div class="text-[12px] text-neutral-600 mt-2">{t.foot}</div>
                </div>
            </div>
        </div>
    </div>

    {/** Puente React que abre la modal de recorte al emitir "open-quick-cropper" */}
    <QuickPhotoCropperBridge client:only="react"/>

    <script type="module" define:vars={{locale, API_URL}}>
        function initQuickPhotoSection() {
            const drop = document.getElementById('qp-drop');
            if (!drop) return;
            // Avoid double initialization across Astro client transitions
            if (drop.dataset && drop.dataset.inited === '1') return;
            drop.dataset.inited = '1';

            const fileInput = document.getElementById('qp-file');
            const preview = document.getElementById('qp-preview');
            const form = document.getElementById('qp-form');
            const instructions = document.getElementById('qp-instructions');
            const btn = document.getElementById('qp-btn');
            const nameInput = document.getElementById('qp-name');
            const emailInput = document.getElementById('qp-email');
            const privacyCheck = document.getElementById('qp-opt2');

            // Error banner (created dynamically below)
            let errorBanner = null;
            // Limit applies to the base64-encoded payload size (max 2MB encoded)
            const MAX_BASE64_ENCODED_BYTES = 2 * 1024 * 1024; // 2MB encoded
            const localeStr = (locale === 'es') ? 'es' : 'en';

            // Estado para controlar reentradas y ciclo del cropper
            let isSelectingFile = false;
            let cropperOpen = false;
            let currentToken = '';
            let lastOpenedToken = '';
            // Data URL resultante del recorte (para enviar al backend). El preview puede ser un object URL.
            let croppedDataUrl = null;

            const hasImage = () => !!preview && !preview.classList.contains('hidden');
            const setHasImageState = (on) => {
                drop.classList.toggle('has-image', !!on);
            };

            const ensureErrorBanner = () => {
                if (errorBanner) return errorBanner;
                errorBanner = document.createElement('div');
                errorBanner.id = 'qp-error';
                errorBanner.role = 'alert';
                errorBanner.setAttribute('aria-live', 'assertive');
                errorBanner.className = 'mb-4 rounded-xl border border-red-300 bg-red-50 text-red-900 p-3 text-sm hidden';
                // Insert before dropzone
                const dropWrapper = drop.parentElement;
                if (dropWrapper) dropWrapper.insertBefore(errorBanner, drop);
                return errorBanner;
            };
            const showError = (msg) => {
                const box = ensureErrorBanner();
                if (!box) return;
                box.textContent = msg;
                box.classList.remove('hidden');
                box.scrollIntoView({behavior: 'smooth', block: 'center'});
            };
            const hideError = () => {
                if (errorBanner) errorBanner.classList.add('hidden');
            };

            const enter = (e) => {
                e.preventDefault();
                drop.classList.add('outline', 'outline-2', 'outline-black/30', 'is-hovering');
            };
            const over = (e) => {
                e.preventDefault();
            };
            const leave = () => {
                drop.classList.remove('outline', 'outline-2', 'outline-black/30', 'is-hovering');
            };

            // Nota: no calculamos límite antes del recorte; el compresor del cropper lo reduce.

            const applyPreviewStyles = () => {
                drop.classList.remove('dropzone');
                drop.style.padding = '0';
                drop.style.height = '400px';
                drop.style.borderRadius = '20px';
                drop.style.border = '3px dashed #cbbda2';
                // Hide the instruction copy once an image is selected
                if (instructions) instructions.classList.add('hidden');
                // Hide the info box when image is selected
                const infoBox = document.querySelector('.info-box');
                if (infoBox) infoBox.classList.add('hidden');
                // Reveal the form on the left
                if (form) form.classList.remove('hidden');
                // Mark state for hover overlay
                setHasImageState(true);
            };

            // Helpers
            const isValidEmail = (email) => {
                if (!email || typeof email !== 'string') return false;
                if (email.length > 200) return false;
                return /[^\s@]+@[^\s@]+\.[^\s@]+/.test(email);
            };

            const isValidName = (name) => {
                return typeof name === 'string' && name.trim().length >= 1 && name.trim().length <= 100;
            };

            const setBtnLoading = (loading) => {
                if (!btn) return;
                btn.disabled = !!loading;
                btn.style.opacity = loading ? '0.7' : '1';
                if (loading) {
                    btn.dataset.prevText = btn.textContent || '';
                    btn.textContent = localeStr === 'es' ? 'Cargando…' : 'Loading…';
                } else if (btn.dataset.prevText) {
                    btn.textContent = btn.dataset.prevText;
                    delete btn.dataset.prevText;
                }
            };

            const handleFile = async (file) => {
                hideError();
                // Generar object URL y abrir cropper a través del bridge
                try {
                    const objectUrl = URL.createObjectURL(file);
                    const token = Math.random().toString(36).slice(2) + Date.now().toString(36);
                    currentToken = token;
                    lastOpenedToken = '';

                    const tryOpen = (attempt) => {
                        window.dispatchEvent(new CustomEvent('open-quick-cropper', {
                            detail: {src: objectUrl, token}
                        }));
                        // Si en ~200ms no se ha abierto para este token, reintentar hasta 3 veces
                        setTimeout(() => {
                            if (lastOpenedToken !== token && attempt < 3) {
                                tryOpen(attempt + 1);
                            }
                        }, 200);
                    };
                    tryOpen(0);
                } catch (err) {
                    showError(localeStr === 'es' ? 'No se pudo abrir el recortador. Inténtalo de nuevo.' : 'Could not open cropper. Please try again.');
                }
            };

            drop.addEventListener('dragenter', enter);
            drop.addEventListener('dragover', over);
            drop.addEventListener('dragleave', leave);
            drop.addEventListener('drop', (e) => {
                e.preventDefault();
                drop.classList.remove('outline', 'outline-2', 'outline-black/30', 'is-hovering');
                const dt = e.dataTransfer;
                const files = dt && dt.files ? dt.files : null;
                if (files && files[0]) handleFile(files[0]);
            });

            // Click/keyboard to open file dialog
            drop.addEventListener('click', () => {
                if (cropperOpen || isSelectingFile) return;
                if (!fileInput) return;
                isSelectingFile = true;
                // permitir volver a elegir el mismo archivo
                fileInput.value = '';
                setTimeout(() => fileInput.click(), 0);
            });
            drop.addEventListener('keydown', (e) => {
                const k = e && e.key ? e.key : '';
                if (k === 'Enter' || k === ' ') {
                    e.preventDefault();
                    if (cropperOpen || isSelectingFile) return;
                    if (!fileInput) return;
                    isSelectingFile = true;
                    fileInput.value = '';
                    setTimeout(() => fileInput.click(), 0);
                }
            });

            if (fileInput) {
                fileInput.addEventListener('change', () => {
                    const f = fileInput && fileInput.files && fileInput.files[0];
                    // salir del estado selección tanto si canceló como si eligió
                    isSelectingFile = false;
                    if (f) handleFile(f);
                });
            }

            // Listeners del puente React
            const onOpened = (ev) => {
                const tk = ev && ev.detail ? ev.detail.token : '';
                if (tk) lastOpenedToken = tk;
                cropperOpen = true;
            };
            const onClosed = () => {
                cropperOpen = false;
                isSelectingFile = false;
                currentToken = '';
                lastOpenedToken = '';
                if (fileInput) fileInput.value = '';
                drop.classList.remove('is-hovering', 'outline', 'outline-2', 'outline-black/30');
            };
            const onConfirmed = (ev) => {
                const detail = ev && ev.detail ? ev.detail : {};
                const tk = detail.token || '';
                if (tk && currentToken && tk !== currentToken) return; // mismatch, ignorar
                const previewUrl = String(detail.previewUrl || '');
                const dataUrl = String(detail.dataUrl || '');
                croppedDataUrl = dataUrl || null;
                if (preview && previewUrl) {
                    preview.onload = () => {
                        applyPreviewStyles();
                    };
                    preview.src = previewUrl;
                    preview.classList.remove('hidden');
                } else {
                    applyPreviewStyles();
                }
            };
            window.addEventListener('quick-cropper-opened', onOpened);
            window.addEventListener('quick-cropper-closed', onClosed);
            window.addEventListener('quick-cropper-confirmed', onConfirmed);

            // Cleanup at page swap using captured handlers
            const cleanup = () => {
                window.removeEventListener('quick-cropper-opened', onOpened);
                window.removeEventListener('quick-cropper-closed', onClosed);
                window.removeEventListener('quick-cropper-confirmed', onConfirmed);
                const dropEl = document.getElementById('qp-drop');
                if (dropEl && dropEl.dataset) {
                    delete dropEl.dataset.inited;
                }
            };
            window.addEventListener('astro:before-swap', cleanup, {once: true});

            // Submit handler: create guest order
            if (btn) {
                // Preserve original copy for later restores
                if (!btn.dataset.baseLabel) btn.dataset.baseLabel = btn.textContent || '';

                btn.addEventListener('click', async () => {
                    hideError();
                    const name = (nameInput && nameInput.value) ? nameInput.value : '';
                    const email = (emailInput && emailInput.value) ? emailInput.value : '';
                    const accepted = !!(privacyCheck && privacyCheck.checked);

                    if (!hasImage() || !croppedDataUrl) {
                        showError(localeStr === 'es' ? 'Primero sube una imagen válida.' : 'Please upload an image first.');
                        return;
                    }
                    if (!isValidName(name)) {
                        showError(localeStr === 'es' ? 'Introduce un nombre válido (1–100 caracteres).' : 'Enter a valid name (1–100 characters).');
                        return;
                    }
                    if (!isValidEmail(email)) {
                        showError(localeStr === 'es' ? 'Introduce un email válido (máx. 200 caracteres).' : 'Enter a valid email (max 200 chars).');
                        return;
                    }
                    if (!accepted) {
                        showError(localeStr === 'es' ? 'Debes aceptar la política de privacidad.' : 'You must accept the privacy policy.');
                        return;
                    }

                    // Build body strictly with allowed props
                    const body = {
                        name: name.trim(),
                        email: email.trim(),
                        imageBase64: croppedDataUrl, // data URL del recorte
                        lang: localeStr
                        // amount, currency: opcionales, omitimos para defaults del servidor
                    };

                    try {
                        setBtnLoading(true);
                        const resp = await fetch(`${API_URL}/public/guest-order`, {
                            method: 'POST',
                            headers: {'Content-Type': 'application/json'},
                            body: JSON.stringify(body)
                        });
                        if (!resp.ok) {
                            // Intentar traducir errores conocidos relacionados con email
                            let msg = localeStr === 'es'
                                ? 'No se pudo crear el pedido. Revisa los datos e inténtalo de nuevo.'
                                : 'Could not create order. Please check your data and try again.';
                            try {
                                const err = await resp.json();
                                const errorCode = String(err?.error || err?.code || '');
                                const reason = String(err?.reason || '');
                                if (errorCode === 'invalid_email') {
                                    if (reason === 'suppressed') {
                                        msg = localeStr === 'es'
                                            ? 'No pudimos enviar el email porque esta dirección está suprimida debido a un rebote o queja previa.'
                                            : "We couldn't send the email because this address is suppressed due to a previous bounce or complaint.";
                                    } else if (reason === 'disposable-domain' || reason === 'disposable_domain') {
                                        msg = localeStr === 'es'
                                            ? 'No se permiten direcciones de correo desechables. Por favor, use otro email.'
                                            : 'Disposable email addresses are not allowed. Please use a different email.';
                                    } else if (err && (err.message || err.error)) {
                                        msg = String(err.message || err.error);
                                    }
                                } else if (err && (err.message || err.error)) {
                                    msg = String(err.message || err.error);
                                }
                            } catch (_) {
                                // Ignorar errores de parseo y mantener mensaje por defecto
                            }
                            throw new Error(msg);
                        }
                        const json = await resp.json();
                        const data = json && (json.data || json);
                        const clientSecret = data?.clientSecret;
                        const sessionId = data?.sessionId;
                        const groupId = data?.groupId;
                        if (!clientSecret || !groupId) {
                            throw new Error(localeStr === 'es' ? 'Respuesta inválida del servidor.' : 'Invalid server response.');
                        }
                        // Persist for checkout page consumption
                        try {
                            sessionStorage.setItem('guestCheckout', JSON.stringify({
                                clientSecret,
                                sessionId,
                                groupId,
                                ts: Date.now()
                            }));
                        } catch (_) {
                        }
                        // Redirect to localized checkout
                        const target = `/${localeStr}/checkout?groupId=${encodeURIComponent(groupId)}`;
                        window.location.href = target;

                    } catch (err) {
                        const msg = (err && err.message) ? err.message : (localeStr === 'es' ? 'Ha ocurrido un error inesperado.' : 'An unexpected error occurred.');
                        showError(msg);
                    } finally {
                        setBtnLoading(false);
                    }
                });
            }
        }

        // Initialize on first load and on Astro client transitions
        if (document.readyState === 'complete' || document.readyState === 'interactive') {
            initQuickPhotoSection();
        } else {
            document.addEventListener('DOMContentLoaded', () => initQuickPhotoSection(), {once: true});
        }
        window.addEventListener('astro:page-load', initQuickPhotoSection);
        window.addEventListener('astro:after-swap', initQuickPhotoSection);
        // When Astro is about to swap the page, a per-init cleanup is registered above to detach listeners
        // Ensure re-initialization when returning with browser back/forward
        window.addEventListener('pageshow', () => initQuickPhotoSection());
    </script>
</section>
