---
import Layout from "@/layouts/main.astro";
import HeroSection from "@/components/home/HeroSection.astro";
import VisualShowcase from "@/components/home/VisualShowcase.astro";
import MemoryHighlight from "@/components/home/MemoryHighlight.astro";
import ReviewsSection from "@/components/home/ReviewsSection.astro";
import HowItWorks from "@/components/home/HowItWorks.astro";
import FAQSection from "@/components/home/FAQSection.astro";
import FooterSection from "@/components/home/FooterSection.astro";
import QuickPhotoSection from "@/components/home/QuickPhotoSection.astro";
import {Header} from "@/layouts/components/Header";
import type {SupportedLocale} from "@/lib/locale";
import {API_URL} from "@/config";

interface Props {
    locale: SupportedLocale;
    /** When true, injects a client-only redirect from "/" to "/es" if the browser language is Spanish */
    enableRedirect?: boolean;
}

const {locale, enableRedirect = false} = Astro.props as Props;

const copies = {
    en: {
        title: 'Brickify — Turn your photo into LEGO®',
        howTitle: 'How Brickify works',
        howDesc: 'Upload an image, our AI recommends official LEGO® parts that best match you, and we deliver a list with the codes for each piece.'
    },
    es: {
        title: 'Brickify — Convierte tu foto en LEGO®',
        howTitle: 'Cómo funciona Brickify',
        howDesc: 'Sube una imagen, nuestra IA te recomienda piezas oficiales de LEGO que más se parecen a ti y te entregamos el listado con códigos de cada pieza.'
    }
} as const;

const t = copies[locale];
const content = {title: t.title};

// SEO
const descriptions = {
    en: "Turn your photo into a LEGO®-style minifig with AI-selected official parts. Upload a picture and get the exact pieces and codes.",
    es: "Convierte tu foto en una minifig al estilo LEGO® con piezas oficiales seleccionadas por IA. Sube una imagen y recibe piezas y códigos exactos."
} as const;
const keywords = {
    en: "lego gift, ai lego, lego minifigure, personalized lego, brickify, lego photo, lego parts list",
    es: "regalo lego, lego personalizado, minifig lego, ia lego, brickify, foto lego, lista piezas lego"
} as const;

const path = Astro.url?.pathname || '/';
const isEs = locale === 'es' || path.startsWith('/es');
const canonical = isEs ? '/es' : (path.startsWith('/en') ? '/en' : '/');
const alternates = [
    {href: '/', hrefLang: 'x-default'},
    {href: '/es', hrefLang: 'es'},
    {href: '/en', hrefLang: 'en'},
];
const seo = {
    title: t.title,
    description: isEs ? descriptions.es : descriptions.en,
    keywords: isEs ? keywords.es : keywords.en,
    canonical,
    alternates,
    ogImage: '/logo.png',
    ogAlt: isEs ? 'Logo de Brickify' : 'Brickify logo',
    structuredData: {
        organization: true,
        website: true,
        webpage: true,
        breadcrumb: [
            {name: isEs ? 'Inicio' : 'Home', url: canonical},
        ]
    },
} as const;
---
<Layout content={content} lang={locale} seo={seo}>
    <Header client:only="react"/>
    <main id="inicio" class="relative overflow-x-hidden">
        <script define:vars={{enableRedirect}}>
            if (enableRedirect && typeof window !== 'undefined') {
                const isRoot = location.pathname === '/' || location.pathname === '';
                const navLang = navigator.language || (navigator.languages && navigator.languages[0]) || '';
                if (isRoot && /^es/i.test(navLang)) {
                    location.replace('/es');
                }
            }
        </script>

        <div class="container mx-auto px-4 md:px-6">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-10 items-center">
                <div class="order-2 md:order-1 md:col-span-7">
                    <HeroSection locale={locale}/>
                </div>
                <div class="order-1 md:order-2 md:col-span-5 pl-8 pr-8 mt-5 md:mt-0">
                    <VisualShowcase locale={locale}/>
                </div>
            </div>
        </div>

        <div class="container mx-auto px-4 md:px-6">
            <MemoryHighlight locale={locale}/>
        </div>

        <HowItWorks locale={locale}/>

        <ReviewsSection locale={locale}/>

        <QuickPhotoSection locale={locale}/>

        <FAQSection locale={locale}/>

        <FooterSection locale={locale}/>

    </main>

</Layout>
