---
import {normalizeLocale, type SupportedLocale} from "@/lib/locale";

interface Props {
    locale?: SupportedLocale
}

const {locale: localeProp} = Astro.props as Props;
const locale = localeProp ?? normalizeLocale(Astro.currentLocale as string | undefined);

const copies = {
    es: {
        badge: "RECARGA TOKENS",
        title: "Consigue tokens para tus creaciones",
        description: "Compra packs de tokens y úsalos para identificar piezas. Cuanto más grande el pack, más tokens recibes por tu dinero.",
        unitLabel: "Pack seleccionado",
        unit: "tokens",
        perPerson: "Precio por foto",
        total: "Precio total",
        savings: "Valor extra",
        costPerPerson: "100 tokens por foto",
        costBreakdown: "25 pelo · 25 cara · 25 cuerpo · 25 pantalón",
        minutes: "tokens gratis",
        hours: "tokens gratis",
        error_loading: "Error al cargar los precios",
        products: {
            prod_recharge_300: "Explorador",
            prod_recharge_1100: "Entusiasta",
            prod_recharge_2000: "Coleccionista",
            prod_recharge_4600: "Maestro",
            prod_recharge_10000: "Leyenda",
            prod_recharge_21600: "Arquitecto"
        }
    },
    en: {
        badge: "TOP UP TOKENS",
        title: "Get tokens for your creations",
        description: "Buy token packs and use them to identify parts. The larger the pack, the more tokens you get for your money.",
        unitLabel: "Selected pack",
        unit: "tokens",
        perPerson: "Price per photo",
        total: "Total price",
        savings: "Extra value",
        costPerPerson: "100 tokens per photo",
        costBreakdown: "25 hair · 25 face · 25 body · 25 legs",
        minutes: "free tokens",
        hours: "free tokens",
        error_loading: "Error loading prices",
        products: {
            prod_recharge_300: "Explorer",
            prod_recharge_1100: "Enthusiast",
            prod_recharge_2000: "Collector",
            prod_recharge_4600: "Master",
            prod_recharge_10000: "Legend",
            prod_recharge_21600: "Architect"
        }
    }
} as const;

const t = copies[locale];
---
<section id="precio" class="py-16 md:py-24 bg-[#F8F5FF]">
    <div class="container mx-auto px-4 md:px-6">
        <div class="text-center max-w-2xl mx-auto mb-10 md:mb-14">
            <span class="inline-flex items-center rounded-full bg-white border border-[#E8C79E] text-xs font-semibold px-3 py-1 uppercase tracking-wide text-primary">
                {t.badge}
            </span>
            <h2 class="text-3xl md:text-[32px] font-medium tracking-tight mt-4 mb-3">{t.title}</h2>
            <p class="text-sm md:text-[16px] font-light text-muted-foreground">{t.description}</p>
        </div>

        <div class="flex justify-center min-h-[400px]" id="price-calculator-container">
            <div class="animate-pulse flex space-x-4 items-center justify-center">
                <div class="h-12 w-12 bg-gray-200 rounded-full"></div>
            </div>
        </div>
    </div>

    <script define:vars={{locale, tMinutes: t.minutes, tLabels: t}}>
        async function getRechargeProducts() {
            try {
                // Get API_URL from window if available, or fallback
                // Since this is a script tag, we use fetch directly to avoid complex imports if possible
                const apiUrl = (window.PROJECT_CONFIG && window.PROJECT_CONFIG.API_URL) || 'http://localhost:3000/api';
                const response = await fetch(`${apiUrl}/payments/recharge-products?lang=${locale}`);
                const payload = await response.json();
                return payload.data || [];
            } catch (error) {
                console.error('Error fetching recharge products:', error);
                return [];
            }
        }

        async function initPriceCalculatorSection() {
            const container = document.getElementById('price-calculator-container');
            if (!container) return;

            // Prevent double initialization
            if (container.dataset.inited === '1') return;
            container.dataset.inited = '1';

            try {
                // Fetch products from backend
                const tokenPacks = await getRechargeProducts();

                if (!tokenPacks || tokenPacks.length === 0) {
                    container.innerHTML = `<p class="text-muted-foreground">${tLabels.error_loading}</p>`;
                    return;
                }

                // Render the calculator UI
                container.innerHTML = `
                    <div class="w-full max-w-3xl rounded-2xl bg-white shadow-sm border border-[#E8C79E] p-6 md:p-8">
                        <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-8" id="packs-grid">
                            ${tokenPacks.map((pack, index) => `
                                <button
                                        type="button"
                                        class="token-pack-btn group relative flex flex-col items-center justify-center p-4 rounded-xl border-2 transition-all hover:border-primary/50 aria-selected:border-primary aria-selected:bg-primary/5"
                                        data-index="${index}"
                                        aria-selected="${index === 1 ? "true" : "false"}"
                                >
                                    <span class="text-xs font-medium text-muted-foreground mb-1">
                                        ${pack.name}
                                    </span>
                                    <span class="text-lg font-bold text-primary">${pack.credits}</span>
                                    <span class="mt-2 font-semibold">${pack.amount / 100} ${pack.currency.toUpperCase() === 'USD' ? '$' : pack.currency.toUpperCase()}</span>
                                    ${pack.bonus > 0 ? `
                                        <span class="absolute -top-2 -right-1 bg-green-500 text-[10px] text-white px-1.5 py-0.5 rounded-full font-bold">
                                            +${pack.bonus}
                                        </span>
                                    ` : ''}
                                </button>
                            `).join('')}
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
                            <div class="rounded-xl bg-[#F1EEFF] p-4 border border-[#E8C79E]/60">
                                <p class="text-sm text-muted-foreground">${tLabels.perPerson}</p>
                                <p class="text-2xl font-semibold" id="pc-unit-price"></p>
                            </div>
                            <div class="rounded-xl bg-[#FFF6E6] p-4 border border-[#E8C79E]/60 text-center flex flex-col items-center justify-center">
                                <p class="text-sm font-bold text-primary uppercase tracking-wider mb-1">${tLabels.costPerPerson}</p>
                                <p class="text-xs text-muted-foreground">${tLabels.costBreakdown}</p>
                            </div>
                            <div class="rounded-xl bg-[#E6F1FF] p-4 border border-[#B5D6FF] text-right">
                                <p class="text-sm text-muted-foreground">${tLabels.total}</p>
                                <p class="text-2xl font-semibold" id="pc-total"></p>
                            </div>
                        </div>

                        <div class="bg-gray-50 rounded-xl p-4 flex items-center justify-between border border-dashed border-gray-200">
                             <p class="text-sm text-muted-foreground">${tLabels.savings}</p>
                             <p class="text-xl font-bold text-green-600" id="pc-savings"></p>
                        </div>
                    </div>
                `;

                const buttons = container.querySelectorAll('.token-pack-btn');
                const unitEl = document.getElementById('pc-unit-price');
                const totalEl = document.getElementById('pc-total');
                const savingsEl = document.getElementById('pc-savings');

                const fmt = new Intl.NumberFormat(locale === 'es' ? 'es-ES' : 'en-US', {
                    style: 'currency',
                    currency: tokenPacks[0].currency.toUpperCase() || 'USD',
                    minimumFractionDigits: 2,
                });

                const update = (index) => {
                    const pack = tokenPacks[index];
                    if (!pack) return;

                    const pricePerPerson = (pack.amount / 100) / (pack.credits / 100);
                    const total = pack.amount / 100;
                    const bonus = pack.bonus;

                    if (unitEl) unitEl.textContent = fmt.format(pricePerPerson);
                    if (totalEl) totalEl.textContent = fmt.format(total);
                    if (savingsEl) {
                        if (bonus > 0) {
                            savingsEl.parentElement.style.display = 'flex';
                            savingsEl.textContent = `${bonus} ${tMinutes}`;
                        } else {
                            savingsEl.parentElement.style.display = 'none';
                        }
                    }

                    buttons.forEach((btn, i) => {
                        btn.setAttribute('aria-selected', String(i === index));
                    });
                };

                buttons.forEach((btn) => {
                    btn.addEventListener('click', () => {
                        const index = parseInt(btn.getAttribute('data-index') || '0');
                        update(index);
                    });
                });

                // Initialize with default pack (index 1)
                update(1);

            } catch (error) {
                console.error('Error initializing price calculator:', error);
                container.innerHTML = `<p class="text-muted-foreground text-center">${tLabels.error_loading}</p>`;
            }
        }

        document.addEventListener('DOMContentLoaded', () => initPriceCalculatorSection());
        window.addEventListener('astro:page-load', initPriceCalculatorSection);

        // Cleanup for Astro view transitions
        window.addEventListener('astro:before-swap', () => {
            const container = document.getElementById('price-calculator-container');
            if (container && container.dataset) delete container.dataset.inited;
        }, {once: true});
    </script>
</section>