---
import {buttonVariants} from "@/components/ui/button";
import {normalizeLocale, type SupportedLocale} from "@/lib/locale";
// Localized copies (EN prioritized)
const {title: titleProp, locale: localeProp} = Astro.props as { title?: string; locale?: SupportedLocale };
const locale = localeProp ?? normalizeLocale(Astro.currentLocale as string | undefined);
const copies = {
    en: {
        title: "Use our AI to craft the perfect LEGO® gift",
        description: "Whether it’s for a wedding, a unique gift for friends, or a corporate present, our AI analyzes an image and <strong class='font-medium'>selects the official LEGO® pieces that best match the person in the photo</strong>. You’ll also receive the reference code for each piece, so you can <strong class='font-medium'>easily find them in the official LEGO® store</strong>. From only 100 tokens.",
        ctaPrimary: "Upload your photo",
        ctaPrimaryAria: "Upload your image and get started",
        ctaSecondary: "How it works",
        ctaSecondaryAria: "How Brickify works"
    },
    es: {
        title: "Ayúdate de nuestra IA para crear el regalo perfecto en LEGO®",
        description: "Ya sea para una boda, un detalle único para amigos o un regalo de empresa, nuestra IA analiza una imagen y <strong class='font-medium'>selecciona las piezas oficiales de LEGO® que mejor encajan con la persona de la foto</strong>. Además, recibirás el código de cada pieza para <strong class='font-medium'>localizarlas fácilmente en la tienda oficial de LEGO®</strong>. ¡Desde solo 100 tokens!",
        ctaPrimary: "Sube tu imagen",
        ctaPrimaryAria: "Sube tu imagen y comienza",
        ctaSecondary: "Cómo funciona",
        ctaSecondaryAria: "Cómo funciona Brickify"
    }
} as const;
const t = copies[locale];
const title = titleProp ?? t.title;
---
<section aria-labelledby="hero-title" class="py-6 md:py-24">
    <div class="container mx-auto grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-10">
            <h1 id="hero-title" class="text-4xl md:text-[64px] font-medium tracking-tight mb-6">
                {title}
            </h1>
            <p class="text-base md:text-[20px] font-light leading-relaxed max-w-prose mb-6"
               set:html={t.description}></p>
            <div class="flex items-center gap-4">
                <a href="#quick-photo" aria-label={t.ctaPrimaryAria} class={buttonVariants({size: "lg"})}>
                    {t.ctaPrimary}
                </a>
                <a href="#como-funciona" class="text-sm underline underline-offset-4 hover:no-underline"
                   aria-label={t.ctaSecondaryAria}>
                    {t.ctaSecondary}
                </a>
            </div>
        </div>
        <div class="md:col-span-5 hidden md:block" aria-hidden="true"></div>
    </div>
</section>
