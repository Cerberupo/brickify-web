---
import type {SupportedLocale} from "@/lib/locale";

interface Props {
    locale: SupportedLocale;
}
const {locale} = Astro.props as Props;

const copies = {
    es: {
        follow: "Síguenos en:",
        customer: "Servicio al cliente",
        about: "Sobre nosotros",
        more: "Más información",
        links: {
            shipping: "Envíos",
            securePay: "Pago seguro",
            aboutUs: "Quiénes somos",
            contact: "Contacto",
            legalNotice: "Aviso legal",
            privacy: "Política de privacidad",
        },
        legalRow: ["Política de privacidad", "Política de privacidad", "Política de privacidad", "Política de privacidad"],
        disclaimer:
            "Brickify no es un producto oficial de LEGO®, ni está afiliado, patrocinado ni respaldado por The LEGO Group. LEGO® y la minifigura son marcas registradas del Grupo LEGO.",
        copyright:
            "©2025 Brickify. Todos los derechos reservados.",
    },
    en: {
        follow: "Follow us:",
        customer: "Customer service",
        about: "About us",
        more: "More information",
        links: {
            shipping: "Shipping",
            securePay: "Secure payment",
            aboutUs: "About us",
            contact: "Contact",
            legalNotice: "Legal notice",
            privacy: "Privacy policy",
        },
        legalRow: ["Privacy policy", "Privacy policy", "Privacy policy", "Privacy policy"],
        disclaimer:
            "Brickify is not an official LEGO® product and is not affiliated with, sponsored by, or endorsed by The LEGO Group. LEGO® and the minifigure are trademarks of the LEGO Group.",
        copyright:
            "©2025 Brickify. All rights reserved.",
    },
} as const;
const t = copies[locale];
const aboutHref = locale === 'es' ? '/es/about' : '/en/about';
const contactHref = locale === 'es' ? '/es/contact' : '/en/contact';
const legalHref = locale === 'es' ? '/es/legal' : '/en/legal';
const privacyHref = locale === 'es' ? '/es/privacy' : '/en/privacy';
---
<style is:global>
    @reference "../../styles/global.css";
    .footer-logo {
        letter-spacing: 0.5px;
    }

    .social-dot {
        width: 56px;
        height: 56px;
        border-radius: 9999px;
        background: #e6e7ea; /* light gray circles as in mock */
    }
</style>

<footer class="w-full mt-10">
    <!-- Top light area -->
    <div class="bg-[#F7F3EE]">
        <div class="container mx-auto px-4 md:px-6 py-10">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
                <!-- Brand -->
                <div class="md:col-span-3">
                    <div class="footer-logo select-none">
                        <img src="/logo.svg" alt="Brickify" class="h-8 w-auto"/>
                    </div>
                </div>

                <!-- Columns -->
                <div class="md:col-span-2">
                    <h4 class="text-[18px] font-semibold mb-3">{t.about}</h4>
                    <ul class="space-y-3 text-sm text-neutral-700">
                        <li><a href={aboutHref} class="hover:underline">{t.links.aboutUs}</a></li>
                        <li><a href={contactHref} class="hover:underline">{t.links.contact}</a></li>
                    </ul>
                </div>
                <div class="md:col-span-2">
                    <h4 class="text-[18px] font-semibold mb-3">{t.more}</h4>
                    <ul class="space-y-3 text-sm text-neutral-700">
                        <li><a href={legalHref} class="hover:underline">{t.links.legalNotice}</a></li>
                        <li><a href={privacyHref} class="hover:underline">{t.links.privacy}</a></li>
                    </ul>
                </div>

                <!-- Social -->
                <div class="md:col-span-3">
                    <h4 class="text-[18px] font-semibold mb-4">{t.follow}</h4>
                    <div class="flex items-center gap-6">
                        <a href="https://x.com/BrickifyFun"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label={locale === 'es' ? 'Perfil de X (Twitter)' : 'X (Twitter) profile'}
                           class="social-dot flex items-center justify-center transition duration-200 ease-out will-change-transform hover:scale-105 hover:-translate-y-0.5 hover:shadow-md hover:shadow-black/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-black/20">
                            <svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5">
                                <title>X</title>
                                <path d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z"/>
                            </svg>
                        </a>
                        <a href="https://www.tiktok.com/@brickify.fun"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label={locale === 'es' ? 'Perfil de TikTok' : 'TikTok profile'}
                           class="social-dot flex items-center justify-center transition duration-200 ease-out will-change-transform hover:scale-105 hover:-translate-y-0.5 hover:shadow-md hover:shadow-black/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-black/20">
                            <svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5">
                                <title>TikTok</title>
                                <path d="M12.525 0h3.168c.152 1.36.73 2.505 1.702 3.48.97.972 2.115 1.55 3.48 1.704v3.17a8.42 8.42 0 01-3.525-.9v5.99c0 5.05-3.587 8.556-8.39 8.556A8.896 8.896 0 010 13.69c0-4.803 3.73-8.39 8.78-8.39.313 0 .62.02.923.055v3.28a5.63 5.63 0 00-.923-.08c-2.93 0-5.035 2.21-5.035 5.135 0 2.927 2.105 5.137 5.035 5.137 2.667 0 4.61-1.52 4.91-4.137.03-.27.045-.548.045-.835V0z"/>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom dark bar -->
    <div class="bg-[#181818] text-white text-[12px]">
        <div class="container mx-auto px-4 md:px-6 py-4 space-y-2">
            <p class="opacity-90">
                {t.disclaimer}
            </p>
            <p class="opacity-80">{t.copyright}</p>
        </div>
    </div>
</footer>
