---
import type {SupportedLocale} from "@/lib/locale";

interface Props {
    locale: SupportedLocale;
    addMargin?: boolean;
}
const {locale, addMargin = true} = Astro.props as Props;

const copies = {
    es: {
        follow: "Síguenos en:",
        customer: "Servicio al cliente",
        about: "Sobre nosotros",
        more: "Más información",
        seo: "Descubre más",
        links: {
            shipping: "Envíos",
            securePay: "Pago seguro",
            aboutUs: "Quiénes somos",
            contact: "Contacto",
            legalNotice: "Aviso legal",
            privacy: "Política de privacidad",
            terms: "Términos de servicio",
            blog: "Blog",
            customFig: "Figura LEGO desde foto",
            wedding: "Bodas",
            corporate: "Empresa",
            gift: "Regalo",
            graduation: "Graduación",
            mothersDay: "Día de la Madre",
        },
        legalRow: ["Política de privacidad", "Política de privacidad", "Política de privacidad", "Política de privacidad"],
        disclaimer:
            "Brickify no es un producto oficial de LEGO®, ni está afiliado, patrocinado ni respaldado por The LEGO Group. LEGO® y la minifigura son marcas registradas del Grupo LEGO.",
        copyright:
            "©2025 Brickify. Todos los derechos reservados.",
    },
    en: {
        follow: "Follow us:",
        customer: "Customer service",
        about: "About us",
        more: "More information",
        seo: "Discover more",
        links: {
            shipping: "Shipping",
            securePay: "Secure payment",
            aboutUs: "About us",
            contact: "Contact",
            legalNotice: "Legal notice",
            privacy: "Privacy policy",
            terms: "Terms of Service",
            blog: "Blog",
            customFig: "LEGO figure from photo",
            wedding: "Wedding favors",
            corporate: "Corporate gifts",
            gift: "Personalized gift",
            graduation: "Graduation gift",
            mothersDay: "Mother's Day gift",
        },
        legalRow: ["Privacy policy", "Privacy policy", "Privacy policy", "Privacy policy"],
        disclaimer:
            "Brickify is not an official LEGO® product and is not affiliated with, sponsored by, or endorsed by The LEGO Group. LEGO® and the minifigure are trademarks of the LEGO Group.",
        copyright:
            "©2025 Brickify. All rights reserved.",
    },
} as const;
const t = copies[locale];
const aboutHref = locale === 'es' ? '/es/about' : '/en/about';
const contactHref = locale === 'es' ? '/es/contact' : '/en/contact';
const legalHref = locale === 'es' ? '/es/legal' : '/en/legal';
const privacyHref = locale === 'es' ? '/es/privacy' : '/en/privacy';
const termsHref = locale === 'es' ? '/es/terms' : '/en/terms';
const blogHref = locale === 'es' ? '/es/blog' : '/blog';
const customHref = locale === 'es' ? '/es/minifig-lego-personalizada-foto' : '/custom-lego-minifigure-photo';
const weddingHref = locale === 'es' ? '/es/recuerdos-boda-lego-personalizados' : '/lego-wedding-favors';
const corporateHref = locale === 'es' ? '/es/regalos-empresa-lego-personalizados' : '/corporate-lego-gifts';
const giftHref = locale === 'es' ? '/es/regalo-lego-personalizado' : '/personalized-lego-gift';
const graduationHref = locale === 'es' ? '/es/regalo-graduacion-lego-personalizado' : '/lego-graduation-gift';
const mothersDayHref = locale === 'es' ? '/es/regalo-lego-dia-de-la-madre' : '/mothers-day-lego-gift';
---
<style is:global>
    @reference "../../styles/global.css";
    .footer-logo {
        letter-spacing: 0.5px;
    }

    .social-dot {
        width: 56px;
        height: 56px;
        border-radius: 9999px;
        background: #e6e7ea; /* light gray circles as in mock */
    }
</style>

<footer class:list={["w-full", addMargin && "mt-10"]}>
    <!-- Top light area -->
    <div class="bg-[#F7F3EE]">
        <div class="container mx-auto px-4 md:px-6 py-10">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
                <!-- Brand -->
                <div class="md:col-span-3">
                    <div class="footer-logo select-none">
                        <img src="/logo.svg" alt="Brickify" class="h-8 w-auto"/>
                    </div>
                </div>

                <!-- Columns -->
                <div class="md:col-span-2">
                    <h3 class="text-[18px] font-semibold mb-3">{t.about}</h3>
                    <ul class="space-y-3 text-sm text-neutral-700">
                        <li><a href={aboutHref} class="hover:underline">{t.links.aboutUs}</a></li>
                        <li><a href={contactHref} class="hover:underline">{t.links.contact}</a></li>
                    </ul>
                </div>
                <div class="md:col-span-2">
                    <h3 class="text-[18px] font-semibold mb-3">{t.more}</h3>
                    <ul class="space-y-3 text-sm text-neutral-700">
                        <li><a href={legalHref} class="hover:underline">{t.links.legalNotice}</a></li>
                        <li><a href={privacyHref} class="hover:underline">{t.links.privacy}</a></li>
                        <li><a href={termsHref} class="hover:underline">{t.links.terms}</a></li>
                    </ul>
                </div>

                <!-- SEO / Landings column -->
                <div class="md:col-span-3">
                    <h3 class="text-[18px] font-semibold mb-3">{t.seo}</h3>
                    <ul class="space-y-3 text-sm text-neutral-700">
                        <li><a href={blogHref} class="hover:underline">{t.links.blog}</a></li>
                        <li><a href={customHref} class="hover:underline">{t.links.customFig}</a></li>
                        <li><a href={weddingHref} class="hover:underline">{t.links.wedding}</a></li>
                        <li><a href={corporateHref} class="hover:underline">{t.links.corporate}</a></li>
                        <li><a href={giftHref} class="hover:underline">{t.links.gift}</a></li>
                        <li><a href={graduationHref} class="hover:underline">{t.links.graduation}</a></li>
                        <li><a href={mothersDayHref} class="hover:underline">{t.links.mothersDay}</a></li>
                    </ul>
                </div>

                <!-- Social -->
                <div class="md:col-span-2">
                    <h3 class="text-[18px] font-semibold mb-4">{t.follow}</h3>
                    <div class="flex items-center gap-6">
                        <a href="https://x.com/BrickifyFun"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label={locale === 'es' ? 'Perfil de X (Twitter)' : 'X (Twitter) profile'}
                           class="social-dot flex items-center justify-center transition duration-200 ease-out will-change-transform hover:scale-105 hover:-translate-y-0.5 hover:shadow-md hover:shadow-black/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-black/20">
                            <svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5">
                                <title>X</title>
                                <path d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z"/>
                            </svg>
                        </a>
                        <a href="https://www.tiktok.com/@brickifyfun"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label={locale === 'es' ? 'Perfil de TikTok' : 'TikTok profile'}
                           class="social-dot flex items-center justify-center transition duration-200 ease-out will-change-transform hover:scale-105 hover:-translate-y-0.5 hover:shadow-md hover:shadow-black/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-black/20">
                            <svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5">
                                <title>TikTok</title>
                                <path d="M12.525 0h3.168c.152 1.36.73 2.505 1.702 3.48.97.972 2.115 1.55 3.48 1.704v3.17a8.42 8.42 0 01-3.525-.9v5.99c0 5.05-3.587 8.556-8.39 8.556A8.896 8.896 0 010 13.69c0-4.803 3.73-8.39 8.78-8.39.313 0 .62.02.923.055v3.28a5.63 5.63 0 00-.923-.08c-2.93 0-5.035 2.21-5.035 5.135 0 2.927 2.105 5.137 5.035 5.137 2.667 0 4.61-1.52 4.91-4.137.03-.27.045-.548.045-.835V0z"/>
                            </svg>
                        </a>
                        <a href="https://instagram.com/brickifyfun"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label={locale === 'es' ? 'Perfil de Instagram' : 'Instagram profile'}
                           class="social-dot flex items-center justify-center transition duration-200 ease-out will-change-transform hover:scale-105 hover:-translate-y-0.5 hover:shadow-md hover:shadow-black/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-black/20">
                            <svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5">
                                <title>Instagram</title>
                                <path d="M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.012 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.012 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.019 1.35 20.35.935 19.56.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.055 1.17-.248 1.805-.413 2.227-.218.562-.478.96-.897 1.382-.42.419-.819.679-1.381.896-.422.164-1.056.36-2.226.413-1.266.057-1.646.07-4.85.07s-3.585-.015-4.85-.074c-1.17-.055-1.805-.248-2.227-.413-.562-.218-.96-.478-1.382-.897-.419-.42-.679-.819-.896-1.381-.164-.422-.36-1.056-.413-2.226C2.177 15.585 2.16 15.203 2.16 12s.015-3.585.072-4.85c.055-1.17.248-1.805.413-2.227.218-.562.478-.96.897-1.382.42-.419.819-.679 1.381-.896.422-.164 1.056-.36 2.226-.413 1.265-.057 1.646-.07 4.85-.07zm0 3.678c-3.405 0-6.162 2.76-6.162 6.162 0 3.405 2.76 6.162 6.162 6.162 3.405 0 6.162-2.76 6.162-6.162 0-3.405-2.76-6.162-6.162-6.162zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405c0 .795-.646 1.44-1.44 1.44-.795 0-1.44-.645-1.44-1.44 0-.794.645-1.44 1.44-1.44.794 0 1.44.646 1.44 1.44z"/>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom dark bar -->
    <div class="bg-[#181818] text-white text-[12px]">
        <div class="container mx-auto px-4 md:px-6 py-4 space-y-2">
            <p class="opacity-90">
                {t.disclaimer}
            </p>
            <p class="opacity-80">{t.copyright}</p>
        </div>
    </div>
</footer>
